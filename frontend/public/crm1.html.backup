              <label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Repayment Frequency</label>
              <select style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;">
