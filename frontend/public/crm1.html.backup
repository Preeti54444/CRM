<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Funding Sathi CRM</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/crm.css?v=2">
<link rel="stylesheet" href="css/crm-pipeline.css">
<link rel="stylesheet" href="css/crm-sod-reports.css">
<link rel="stylesheet" href="css/crm-followup-reminders.css">
<link rel="stylesheet" href="css/crm-targets.css">
<link rel="stylesheet" href="css/crm-forecast.css">
<link rel="stylesheet" href="css/_local_overrides.css?v=1">
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
<script src="config.js"></script>
<script>
  // Check authentication before loading CRM
  (function checkAuth() {
    try {
      const session = JSON.parse(localStorage.getItem('crm_session') || '{}');
      const token = session?.access_token || session?.token || null;
      if (!token) {
        console.warn('[CRM] No authentication token found, redirecting to login');
        window.location.href = 'login.html';
        return;
      }
      console.log('[CRM] Authentication check passed');
    } catch (e) {
      console.error('[CRM] Auth check failed, redirecting to login:', e);
      window.location.href = 'login.html';
    }
  })();

  // API base URL is now configured by config.js
  // Ensure config.js is loaded before this script
  console.log('[CRM] Using centralized API base from config.js:', window.API_BASE);
  // Auto-inject Home button if missing (to handle server caching)
  document.addEventListener('DOMContentLoaded', function() {
    setTimeout(function() {
      const navMenu = document.querySelector('nav.sb-nav');
            if (navMenu && !navMenu.querySelector('button[data-sec="dashboard"]') && !navMenu.querySelector('button[data-sec="home"]')) {
        const searchEl = navMenu.querySelector('.nav-search');
        if (searchEl) {
          const homeBtnHTML = '<div class="nav-grp"><button class="nav-btn" data-sec="dashboard" onclick="nav(this)"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 10l9-7 9 7v11a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2v-5H9v5a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V10z"/></svg><span>Home</span></button></div>';
          searchEl.insertAdjacentHTML('afterend', homeBtnHTML);
        }
      }
    }, 100);
  });
</script>
</head>
<body>
<!-- Mobile Menu Backdrop -->
<div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleMobileMenu()"></div>

<!-- Mobile Menu Toggle Button -->
<button class="menu-toggle" id="menuToggle" type="button" onclick="toggleMobileMenu()" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="sidebar">
  <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="3" x2="21" y1="6" y2="6"/><line x1="3" x2="21" y1="12" y2="12"/><line x1="3" x2="21" y1="18" y2="18"/></svg>
</button>

<aside class="sidebar" id="sidebar" role="complementary" aria-label="Application sidebar">
  <div class="sb-brand">
    <div class="sb-brand-row">
    <div class="sb-icon"><img src="logo.69793bbbefb277f660f7.png" alt="Funding Sathi logo" style="width:36px;height:42px;border-radius:11px;object-fit:contain;" /></div>
    <div>
      <div class="sb-name">Funding Sathi</div>
      <div class="sb-sub">AI Sales CRM</div>
    </div>
    <!-- Real-time Connection Indicator -->
    <div id="realtimeIndicator" class="realtime-indicator" style="display:none;align-items:center;gap:6px;padding:4px 8px;border-radius:12px;font-size:11px;font-weight:500;margin-left:auto;">
      <span id="realtimeStatusDot" class="status-dot"></span>
      <span id="realtimeStatusText">Connecting...</span>
    </div>
    <!-- Imported Data Section - Hidden as datasets are managed by backend API -->
    <section class="section" id="sec-imported-data" style="display:none;">
      <div class="section-header">
        <div>
          <div class="section-title">Imported Sheets</div>
          <div class="section-subtitle">All rows & columns imported from your Excel files</div>
        </div>
          <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <select id="importDatasetSelect" style="padding:8px;border-radius:8px;border:1px solid var(--gray-100);background:white;min-width:180px;">
              <option value="crm_leads">SOD Reports / Leads</option>
              <option value="crm_eod">EOD Reports</option>
              <option value="crm_wod">WOD Reports</option>
              <option value="crm_report_history">Report History</option>
              <option value="crm_users">Users</option>
              <option value="crm_leads_journey">Lead Journey</option>
            </select>
            <input id="importSearch" placeholder="Search..." style="padding:8px;border-radius:8px;border:1px solid var(--gray-100);min-width:180px;" />
            <button class="btn" id="importExportBtn">Export CSV</button>
            <button class="btn btn-secondary" id="importFileBtn">Import File</button>
            <input id="importSheetUrl" type="url" placeholder="Paste Google Sheet URL" style="padding:8px;border-radius:8px;border:1px solid var(--gray-100);min-width:260px;" />
            <button class="btn btn-secondary" id="importSheetBtn">Import Sheet</button>
            <button class="btn btn-danger" id="importDeleteBtn">Delete Data</button>
            <button class="btn btn-danger" id="importDeleteAllBtn">Delete All</button>
            <input id="importFileInput" type="file" accept=".csv,.json,.xls,.xlsx" style="display:none" />
          </div>
          <div id="importTableContainer" style="padding:16px;background:#fff;border-top:1px solid var(--gray-100);min-height:240px;">Select a dataset and import a file to preview rows here.</div>
        </section>
  </div>
  <nav class="sb-nav" role="navigation" aria-label="Primary navigation">
    <div class="nav-grp">
      <button class="nav-btn" type="button" data-sec="dashboard" onclick="nav(this)">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 10l9-7 9 7v11a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2v-5H9v5a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V10z"/></svg>
        <span>Home</span>
      </button>
    </div>

    <!-- Workqueue -->
    <div class="nav-grp">
      <button class="nav-btn active nav-expandable" type="button" data-sec="workqueue" onclick="toggleExpand(this); nav(this)" aria-expanded="true" aria-controls="workqueue-submenu">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        <span>Workqueue</span>
        <svg class="expand-icon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
      </button>
      <div class="nav-submenu expanded" id="workqueue-submenu" data-parent="workqueue">
        <div class="submenu-header">My Open Activity</div>
        <button class="nav-btn sub" data-sec="workqueue" data-filter="tasks" onclick="navWorkqueue(this, 'tasks')">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="8" height="4" x="8" y="2" rx="1"/><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2"/><path d="M8 18h8"/><path d="M8 14h8"/></svg>
          <span>Tasks</span>
          <span class="nav-count">6</span>
        </button>
        <button class="nav-btn sub" data-sec="workqueue" data-filter="meetings" onclick="navWorkqueue(this, 'meetings')">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
          <span>Meetings</span>
          <span class="nav-count">0</span>
        </button>
        <button class="nav-btn sub active" data-sec="workqueue" data-filter="calls" onclick="navWorkqueue(this, 'calls')">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>Calls</span>
          <span class="nav-count">1</span>
        </button>
      </div>
    </div>

    <!-- AI Assistant -->
    <div class="nav-grp">
      <button class="nav-btn" data-sec="ai-assistant" onclick="nav(this)">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"/><path d="M12 6v6l4 2"/><circle cx="12" cy="12" r="2"/></svg>
        <span>AI Assistant (Zia)</span>
        <span style="background: var(--maroon); color: white; padding: 2px 8px; border-radius: 10px; font-size: 10px; margin-left: auto;">NEW</span>
      </button>
    </div>

    <!-- Sales -->
    <div class="nav-grp">
      <button class="nav-btn nav-expandable" onclick="toggleExpand(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
        <span>Sales</span>
        <svg class="expand-icon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
      </button>
      <div class="nav-submenu" data-parent="sales">
        <button class="nav-btn sub" data-sec="leads" onclick="nav(this)">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>
          <span>Leads</span>
        </button>
        <button class="nav-btn sub" data-sec="lead-form" onclick="nav(this)" id="navCreateLeadBtn">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14"/><path d="M5 12h14"/><path d="M4 4h16v16H4z"/></svg>
          <span>Create Lead</span>
        </button>
        <button class="nav-btn sub" data-sec="case-management" onclick="nav(this)">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 21h16a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2Z"/><path d="M16 3v4"/><path d="M8 3v4"/><path d="M3 11h18"/></svg>
          <span>Lender Cases</span>
        </button>
        <button class="nav-btn sub" data-sec="lender-products" onclick="nav(this)">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          <span>Lenders</span>
        </button>
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const session = JSON.parse(localStorage.getItem('crm_session') || '{}')
        const role = String(session.role || '').trim().toLowerCase()
        const createLeadBtn = document.getElementById('navCreateLeadBtn')
        if (createLeadBtn) {
          if (role === 'admin') {
            createLeadBtn.style.display = 'none'
          } else {
            createLeadBtn.style.display = 'inline-flex'
          }
        }
        
        // Hide topbar Add button for admin users
        const topbarAddBtn = document.querySelector('.topbar-add')
        if (topbarAddBtn && role === 'admin') {
          topbarAddBtn.style.display = 'none'
        }

        // Hide Add Call and Call Forms buttons for admin users
        if (role === 'admin') {
          const addCallBtn = document.querySelector('[data-sec="lead-form"]')
          const callFormsBtn = document.querySelector('[data-sec="call-form"]')
          if (addCallBtn) addCallBtn.style.display = 'none'
          if (callFormsBtn) callFormsBtn.style.display = 'none'
        }
      })
    </script>
        <button class="nav-btn sub" data-sec="contacts" onclick="nav(this)">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          <span>Contacts</span>
        </button>
        <button class="nav-btn sub" data-sec="accounts" onclick="nav(this)">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V10Z"/><path d="M8 8V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          <span>Accounts</span>
        </button>
        <button class="nav-btn sub" data-sec="deals" onclick="nav(this)">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <span>Deals</span>
        </button>
        <button class="nav-btn sub" data-sec="pipeline" onclick="nav(this)">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M3 12h18"/><path d="M3 18h18"/></svg>
          <span>Pipeline</span>
        </button>
        <button class="nav-btn sub" data-sec="forecasting" onclick="nav(this)">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M2 20h20"/><path d="M2 20V4"/><path d="M2 20l5-5 4 4 5-5 6 6"/></svg>
          <span>Forecasts</span>
        </button>
        <button class="nav-btn sub" data-sec="forecast" onclick="nav(this)">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 3h7v7H3V3M14 3h7v7h-7V3M14 14h7v7h-7v-7M3 14h7v7H3v-7"/></svg>
          <span>Revenue Forecast</span>
        </button>
        <button class="nav-btn sub" data-sec="documents" onclick="nav(this)">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2Z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
          <span>Documents</span>
        </button>
        <button class="nav-btn sub" data-sec="campaigns" onclick="nav(this)">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l9 4.9V17L12 22l-9-4.9V7z"/></svg>
          <span>Campaigns</span>
        </button>
        <button class="nav-btn sub" data-sec="call-tracker" onclick="nav(this)">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>Call Management</span>
        </button>
      </div>
    </div>
    <div class="nav-grp">
      <div class="nav-grp-label">Productivity</div>
      <button class="nav-btn" id="nav-task-assign" data-sec="task-assign" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>Task Assign
      </button>
      <button class="nav-btn admin-only" data-sec="targets" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 7h10"/><path d="M7 12h10"/><path d="M7 17h6"/></svg>Targets
      </button>
      <button class="nav-btn" data-sec="calendar" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>Calendar
      </button>
      <button class="nav-btn" data-sec="today-done" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2v4"/><path d="m16.2 7.8 2.9-2.9"/><path d="M18 12h4"/><path d="m16.2 16.2 2.9 2.9"/><path d="M12 18v4"/><path d="m4.9 19.1 2.9-2.9"/><path d="M2 12h4"/><path d="m4.9 4.9 2.9 2.9"/></svg>
        <span class="nav-img">My To-Do</span>
      </button>
      <button class="nav-btn" data-sec="visits" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>Visits
      </button>
      <button class="nav-btn" data-sec="projects" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l9 4.9V17L12 22l-9-4.9V7z"/><path d="M12 22V11"/></svg>Projects
      </button>
    </div>
    <div class="nav-grp">
      <div class="nav-grp-label">Integrations</div>
      <button class="nav-btn" data-sec="integrations" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l9 4.9V17L12 22l-9-4.9V7z"/></svg>Integration Overview
      </button>
      <button class="nav-btn" data-sec="google-sheets" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>Google Sheets
      </button>
      <button class="nav-btn" data-sec="email" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5z"/><path d="m3 7 9 6 9-6"/></svg>Email
      </button>
      <button class="nav-btn" id="nav-meet-tools" data-sec="meet-tools" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 10l4.553-4.553A1 1 0 0 1 21 6v12a1 1 0 0 1-1.447.894L15 14z"/><path d="M3 8a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>Meet Tools
      </button>
      <button class="nav-btn" data-sec="whatsapp" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>WhatsApp
      </button>
    </div>
    <div class="nav-grp">
      <div class="nav-grp-label">Daily Reports</div>
      <button class="nav-btn sod-highlight" data-sec="sod-form" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>Submit SOD
      </button>
      <button class="nav-btn" data-sec="sod-history" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2v10l4 4"/><circle cx="12" cy="12" r="10"/></svg>SOD History
      </button>
      <button class="nav-btn" data-sec="eod-form" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>Submit EOD
      </button>
      <button class="nav-btn" data-sec="eod-history" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>EOD History
      </button>
      <button class="nav-btn" data-sec="wod-form" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 3h18v18H3z"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>Submit WOD
      </button>
      <button class="nav-btn" data-sec="wod-history" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>WOD History
      </button>
    </div>
    <div class="nav-grp">
      <div class="nav-grp-label">Lead Management</div>
      <button class="nav-btn" data-sec="lead-form" onclick="openCallTypeModal()">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="16"/><line x1="8" x2="16" y1="12" y2="12"/></svg>Add Call
      </button>
      <button class="nav-btn" data-sec="call-form" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>Call Forms
      </button>
      <button class="nav-btn" data-sec="meetings" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>Meetings
      </button>
      <button class="nav-btn" data-sec="call-tracker" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>Call Tracker
