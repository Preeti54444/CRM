# ═══════════════════════════════════════════════════════════════
# Environment variables for docker-compose.prod.yml
# Copy to .env.prod and fill in real values before using that file.
# (docker-compose.yml / the main deployment path uses .env instead -
#  see .env.example for that one.)
# ═══════════════════════════════════════════════════════════════

# ─── ENVIRONMENT ───
ENVIRONMENT=production
LOG_LEVEL=INFO

# ─── SECURITY ───
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-a-real-random-value

# ─── DATABASE ───
# Use the docker-compose "postgres" service hostname, not localhost/an IP.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-use-a-strong-password
POSTGRES_DB=fundingsathicrm
DATABASE_URL=postgresql://postgres:change-me-use-a-strong-password@postgres:5432/fundingsathicrm

# ─── JWT SETTINGS ───
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── CORS & ALLOWED HOSTS ───
# For Vercel deployment: comma-separated list of allowed origins
# CRITICAL: Include BOTH the Vercel domain AND your custom domain (if using custom domain)
# Example: https://app.vercel.app,https://app.your-domain.com
ALLOWED_HOSTS=https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# ─── EMAIL ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@fundingsathi.com

# ─── API BASE OVERRIDES ───
# Backend API URL for the frontend to call
# For Vercel frontend: point to your api.your-domain.com HTTPS endpoint
API_BASE=https://api.your-domain.com

# ─── CELERY / REDIS (this stack only) ───
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
