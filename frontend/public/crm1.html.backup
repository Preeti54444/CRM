            <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Max Existing Debt-to-Income Ratio (%)</label><input type="number" placeholder="e.g., 50" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
          </div>
          <div class="row single" style="display:grid;grid-template-columns:1fr;gap:14px;margin-bottom:14px;">
            <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Restricted Industry Sectors <span class="hint" style="font-weight:400;color:#64748b;">(comma separated)</span></label><input type="text" placeholder="e.g., Real Estate, Crypto, Gambling" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
          </div>
        </div>
