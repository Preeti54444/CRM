              <div class="checkbox-row" style="display:flex;align-items:center;gap:8px;margin-bottom:10px;"><input type="checkbox" id="personalGuarantee" style="width:16px;height:16px;accent-color:#2563eb;cursor:pointer;"><label for="personalGuarantee" style="font-size:13px;font-weight:600;color:#1e293b;cursor:pointer;margin:0;">Requires Personal Guarantee</label></div>
