<!-- MEETINGS MANAGEMENT MODALS -->
<!-- ════════════════════════════════════════ -->

<!-- Meeting Form Modal -->
<div class="modal-ov" id="meetingFormModal" style="display:none;background:rgba(0,0,0,0.6);backdrop-filter:blur(4px);">
  <div class="modal" style="width:88%;max-width:760px;min-height:520px;max-height:90vh;overflow-y:auto;border-radius:16px;box-shadow:0 18px 48px rgba(0,0,0,0.14);animation:modalSlideIn 0.3s ease;">
    <style>
      @keyframes modalSlideIn {
        from { opacity: 0; transform: translateY(-20px) scale(0.95); }
        to { opacity: 1; transform: translateY(0) scale(1); }
      }
      
      .form-input-modern {
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
        padding: 11px 14px;
        border: 1.5px solid var(--gray-200);
        border-radius: 8px;
        font-size: 13px;
        font-family: inherit;
        transition: all 0.2s ease;
      }

      .form-input-modern:focus {
        outline: none;
        border-color: var(--maroon);
        background: white;
        box-shadow: 0 0 0 3px rgba(168,29,72,0.12);
      }

      .form-input-modern::placeholder {
        color: var(--gray-400);
      }

      .form-label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
        font-size: 12px;
        color: var(--gray-700);
        text-transform: uppercase;
        letter-spacing: 0.3px;
      }

      .form-group {
        margin-bottom: 16px;
        min-width: 0;
      }
    </style>

    <div style="padding:28px;border-bottom:2px solid var(--gray-100);display:flex;justify-content:space-between;align-items:center;background:linear-gradient(135deg,white 0%,var(--gray-50) 100%);">
      <div>
        <h2 id="meetingFormTitle" style="margin:0 0 4px 0;font-size:20px;font-weight:700;color:var(--gray-900);">Schedule New Meeting</h2>
        <p style="margin:0;font-size:12px;color:var(--gray-500);">Create a new meeting and assign participants</p>
      </div>
      <button onclick="closeMeetingForm()" style="background:none;border:none;cursor:pointer;font-size:28px;color:var(--gray-400);transition:all 0.2s;" onmouseover="this.style.transform='scale(1.1)'; this.style.color='var(--gray-600)'" onmouseout="this.style.transform='scale(1)'; this.style.color='var(--gray-400)'">&times;</button>
    </div>

    <div style="padding:28px 28px 24px;">
      <div class="form-group">
      <label class="form-label">Meeting Title *</label>
      <input id="meetingTitle" class="form-input-modern" type="text" placeholder="E.g., HDFC Loan Discussion">
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;min-width:0;">
      <div class="form-group">
        <label class="form-label">Meeting Type *</label>
        <select id="meetingType" class="form-input-modern" style="cursor:pointer;background-image:url('data:image/svg+xml;utf8,%3Csvg%20fill%3D%22%23666%22%20viewBox%3D%220%200%2020%2020%22%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%3E%3Cpath%20d%3D%22M5.293%207.293a1%201%200%20011.414%200L10%2010.586l3.293-3.293a1%201%200%200111.414%201.414l-4%204a1%201%200%2001-1.414%200l-4-4a1%201%200%20010-1.414z%22/%3E%3C/svg%3E');background-repeat:no-repeat;background-position:right 10px center;background-size:20px;padding-right:36px;appearance:none;">
          <option>Client Meeting</option>
          <option>Lender Meeting</option>
          <option>Internal Meeting</option>
          <option>Negotiation</option>
          <option>Follow-up</option>
          <option>Closing</option>
          <option>Product Demo</option>
          <option>Introduction</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Department</label>
        <select id="meetingDepartment" class="form-input-modern" style="cursor:pointer;background-image:url('data:image/svg+xml;utf8,%3Csvg%20fill%3D%22%23666%22%20viewBox%3D%220%200%2020%2020%22%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%3E%3Cpath%20d%3D%22M5.293%207.293a1%201%200%20011.414%200L10%2010.586l3.293-3.293a1%201%200%200111.414%201.414l-4%204a1%201%200%2001-1.414%200l-4-4a1%201%200%20010-1.414z%22/%3E%3C/svg%3E');background-repeat:no-repeat;background-position:right 10px center;background-size:20px;padding-right:36px;appearance:none;">
          <option>Sales</option>
          <option>Loan Processing</option>
          <option>Admin</option>
          <option>Support</option>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">Description</label>
      <textarea id="meetingDescription" class="form-input-modern" placeholder="Add meeting details and context..." style="min-height:100px;resize:vertical;"></textarea>
    </div>

      <div style="background:var(--gray-50);padding:20px;border-radius:12px;margin-bottom:20px;border:1px solid var(--gray-100);">
        <div style="font-weight:600;color:var(--gray-900);margin-bottom:16px;font-size:13px;text-transform:uppercase;letter-spacing:0.3px;">📅 Date & Time</div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;min-width:0;">
          <div class="form-group" style="margin:0;">
            <label class="form-label">Date *</label>
            <input id="meetingDate" class="form-input-modern" type="date">
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label">Start Time *</label>
            <input id="meetingStartTime" class="form-input-modern" type="time">
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label">End Time *</label>
            <input id="meetingEndTime" class="form-input-modern" type="time">
          </div>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Organizer</label>
        <input id="meetingOrganizer" class="form-input-modern" type="email" placeholder="Your email">
      </div>

      <div class="form-group">
        <label class="form-label">👥 Participants (comma-separated emails)</label>
        <input id="meetingParticipants" class="form-input-modern" type="text" placeholder="client@example.com, email@lender.com">
        <div style="font-size:12px;color:var(--gray-500);margin-top:6px;">Use valid email addresses to auto-share the meeting link by email.</div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;min-width:0;">
        <div class="form-group">
          <label class="form-label">Related Case</label>
          <input id="meetingRelatedCase" class="form-input-modern" type="text" placeholder="E.g., CASE-2026-00125">
        </div>
        <div class="form-group">
          <label class="form-label">Related Client</label>
          <input id="meetingRelatedClient" class="form-input-modern" type="text" placeholder="E.g., ABC Industries">
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;min-width:0;">
        <div class="form-group">
          <label class="form-label">Related Lender</label>
          <input id="meetingRelatedLender" class="form-input-modern" type="text" placeholder="E.g., HDFC Bank">
        </div>
        <div class="form-group">
          <label class="form-label">Priority</label>
          <select id="meetingPriority" class="form-input-modern" style="cursor:pointer;background-image:url('data:image/svg+xml;utf8,%3Csvg%20fill%3D%22%23666%22%20viewBox%3D%220%200%2020%2020%22%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%3E%3Cpath%20d%3D%22M5.293%207.293a1%201%200%20011.414%200L10%2010.586l3.293-3.293a1%201%200%200111.414%201.414l-4%204a1%201%200%2001-1.414%200l-4-4a1%201%200%20010-1.414z%22/%3E%3C/svg%3E');background-repeat:no-repeat;background-position:right 10px center;background-size:20px;padding-right:36px;appearance:none;">
            <option value="low">Low</option>
            <option value="medium">Medium</option>
            <option value="high">High</option>
            <option value="urgent">Urgent</option>
          </select>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;min-width:0;">
        <div class="form-group">
          <label class="form-label">Meeting Mode</label>
          <select id="meetingMode" class="form-input-modern" style="cursor:pointer;background-image:url('data:image/svg+xml;utf8,%3Csvg%20fill%3D%22%23666%22%20viewBox%3D%220%200%2020%2020%22%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%3E%3Cpath%20d%3D%22M5.293%207.293a1%201%200%20011.414%200L10%2010.586l3.293-3.293a1%201%200%200111.414%201.414l-4%204a1%201%200%2001-1.414%200l-4-4a1%201%200%20010-1.414z%22/%3E%3C/svg%3E');background-repeat:no-repeat;background-position:right 10px center;background-size:20px;padding-right:36px;appearance:none;">
            <option>Physical</option>
            <option>Google Meet</option>
            <option>Zoom</option>
            <option>Microsoft Teams</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Meeting Link (if virtual)</label>
          <input id="meetingLink" class="form-input-modern" type="url" placeholder="https://...">
          <div style="font-size:12px;color:var(--gray-500);margin-top:6px;">Leave blank for auto-generated shareable meeting links for virtual meetings.</div>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">📝 Agenda</label>
        <textarea id="meetingAgenda" class="form-input-modern" placeholder="Meeting agenda and discussion points..." style="min-height:100px;resize:vertical;"></textarea>
      </div>

      <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:28px;padding-top:24px;border-top:1px solid var(--gray-200);">
        <button class="btn btn-outline" onclick="closeMeetingForm()" style="padding:11px 24px;border-radius:8px;font-weight:600;transition:all 0.2s;">Cancel</button>
        <button class="btn btn-primary" onclick="saveMeeting()" style="padding:11px 32px;border-radius:8px;font-weight:600;background:linear-gradient(135deg,var(--maroon) 0%,#a81d48 100%);box-shadow:0 4px 12px rgba(122,5,42,0.2);transition:all 0.2s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 20px rgba(122,5,42,0.3)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 12px rgba(122,5,42,0.2)'">Save Meeting</button>
      </div>
    </div>
  </div>
</div>

<!-- Meeting Details Modal -->
<div class="modal-ov" id="meetingDetailsModal" style="display:none;background:rgba(0,0,0,0.5);">
  <div class="modal" style="width:90%;max-width:800px;max-height:90vh;overflow-y:auto;">
    <div style="padding:20px;border-bottom:1px solid var(--gray-200);display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;background:white;">
      <h2 id="detailMeetingTitle" style="margin:0;font-size:18px;font-weight:700;color:var(--gray-900);">Meeting Details</h2>
      <button onclick="closeMeetingDetails()" style="background:none;border:none;cursor:pointer;font-size:24px;color:var(--gray-400);">&times;</button>
    </div>
    <div style="padding:20px;">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:24px;padding:16px;background:var(--gray-50);border-radius:8px;">
        <div>
          <div style="font-size:12px;color:var(--gray-500);font-weight:600;margin-bottom:4px;">DATE & TIME</div>
          <div style="font-size:14px;font-weight:600;" id="detailMeetingDate"></div>
          <div style="font-size:13px;color:var(--gray-600);" id="detailMeetingTime"></div>
        </div>
        <div>
          <div style="font-size:12px;color:var(--gray-500);font-weight:600;margin-bottom:4px;">STATUS</div>
          <div style="display:flex;align-items:center;gap:8px;">
            <span id="detailMeetingStatus" style="background:var(--maroon);color:white;padding:4px 12px;border-radius:4px;font-size:11px;font-weight:600;"></span>
            <button class="btn-icon" onclick="editMeeting(selectedMeetingForDetails)" title="Edit">✏️</button>
          </div>
        </div>
      </div>

      <div style="margin-bottom:20px;">
        <h3 style="font-weight:600;margin-bottom:12px;color:var(--gray-900);">Organizer</h3>
        <div id="detailMeetingOrganizer" style="color:var(--gray-700);"></div>
      </div>

      <div style="margin-bottom:20px;">
        <h3 style="font-weight:600;margin-bottom:12px;color:var(--gray-900);">Related Information</h3>
        <div id="detailMeetingRelated" style="color:var(--gray-700);"></div>
      </div>

      <div style="margin-bottom:20px;">
        <h3 style="font-weight:600;margin-bottom:12px;color:var(--gray-900);">Participants</h3>
        <div id="detailMeetingParticipants" style="display:flex;flex-wrap:wrap;gap:8px;"></div>
      </div>

      <div style="margin-bottom:20px;">
        <h3 style="font-weight:600;margin-bottom:12px;color:var(--gray-900);">Activity Timeline</h3>
        <div id="detailMeetingActivity" style="max-height:300px;overflow-y:auto;"></div>
      </div>

      <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:24px;">
        <button class="btn btn-outline" onclick="openMOMForm(selectedMeetingForDetails)">📝 Generate MOM</button>
        <button class="btn btn-outline" onclick="openActionItemsForm(selectedMeetingForDetails)">✓ Add Action Items</button>
        <button class="btn btn-primary" onclick="closeMeetingDetails()">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- Minutes of Meeting (MOM) Modal -->
<div class="modal-ov" id="momModal" style="display:none;background:rgba(0,0,0,0.5);">
  <div class="modal" style="width:90%;max-width:750px;max-height:90vh;overflow-y:auto;">
    <div style="padding:20px;border-bottom:1px solid var(--gray-200);display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;background:white;">
      <h2 style="margin:0;font-size:18px;font-weight:700;color:var(--gray-900);">Minutes of Meeting (MOM)</h2>
      <button onclick="closeMOMForm()" style="background:none;border:none;cursor:pointer;font-size:24px;color:var(--gray-400);">&times;</button>
    </div>
    <div style="padding:20px;">
      <div style="padding:12px;background:rgba(168,29,72,0.15);border-left:4px solid var(--maroon);margin-bottom:16px;">
        <div style="font-size:12px;color:var(--gray-600);margin-bottom:4px;">Meeting</div>
        <div id="momMeetingTitle" style="font-weight:600;color:var(--gray-900);"></div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
        <div>
          <label style="display:block;font-weight:600;margin-bottom:6px;font-size:12px;">Meeting Date</label>
          <input id="momDate" type="date" disabled style="width:100%;padding:10px;border:1px solid var(--gray-200);border-radius:6px;font-size:13px;background:var(--gray-50);">
        </div>
        <div>
          <label style="display:block;font-weight:600;margin-bottom:6px;font-size:12px;">Attendees</label>
          <input id="momAttendees" type="text" disabled style="width:100%;padding:10px;border:1px solid var(--gray-200);border-radius:6px;font-size:13px;background:var(--gray-50);">
        </div>
      </div>

      <div style="margin-bottom:16px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
          <label style="font-weight:600;font-size:12px;">Meeting Summary *</label>
          <button class="btn btn-outline" onclick="generateMOMWithAI(selectedMeetingForDetails)" style="padding:4px 12px;font-size:11px;">🤖 AI Generate</button>
        </div>
        <textarea id="momSummary" placeholder="Key discussion points and outcomes..." style="width:100%;padding:10px;border:1px solid var(--gray-200);border-radius:6px;font-size:13px;min-height:120px;"></textarea>
      </div>

      <div style="margin-bottom:16px;">
        <label style="display:block;font-weight:600;margin-bottom:6px;font-size:12px;">Decisions Taken</label>
        <textarea id="momDecisions" placeholder="List all decisions made during the meeting..." style="width:100%;padding:10px;border:1px solid var(--gray-200);border-radius:6px;font-size:13px;min-height:100px;"></textarea>
      </div>

      <div style="margin-bottom:20px;">
        <label style="display:block;font-weight:600;margin-bottom:6px;font-size:12px;">Risks Identified</label>
        <textarea id="momRisks" placeholder="Any risks or concerns identified..." style="width:100%;padding:10px;border:1px solid var(--gray-200);border-radius:6px;font-size:13px;min-height:100px;"></textarea>
      </div>

      <div style="margin-bottom:20px;">
        <label style="display:block;font-weight:600;margin-bottom:6px;font-size:12px;">Follow-up Date</label>
        <input id="momFollowUpDate" type="date" style="width:100%;padding:10px;border:1px solid var(--gray-200);border-radius:6px;font-size:13px;">
      </div>

      <div style="display:flex;gap:12px;justify-content:flex-end;">
        <button class="btn btn-outline" onclick="closeMOMForm()">Cancel</button>
        <button class="btn btn-outline" onclick="exportMOMToPDF(selectedMeetingForDetails)" style="white-space:nowrap;">📄 Export PDF</button>
        <button class="btn btn-primary" onclick="saveMOM()">Save MOM</button>
      </div>
    </div>
  </div>
</div>

<!-- Action Items to Tasks Modal -->
<div class="modal-ov" id="actionItemsModal" style="display:none;background:rgba(0,0,0,0.5);">
  <div class="modal" style="width:90%;max-width:600px;">
    <div style="padding:20px;border-bottom:1px solid var(--gray-200);display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;background:white;">
      <h2 style="margin:0;font-size:18px;font-weight:700;color:var(--gray-900);">Create Task from Action Item</h2>
      <button onclick="closeActionItemsForm()" style="background:none;border:none;cursor:pointer;font-size:24px;color:var(--gray-400);">&times;</button>
    </div>
    <div style="padding:20px;">
      <div style="margin-bottom:16px;">
        <label style="display:block;font-weight:600;margin-bottom:6px;font-size:12px;">Task Title *</label>
        <input id="actionItemTitle" type="text" placeholder="E.g., Follow-up with HDFC regarding documents" style="width:100%;padding:10px;border:1px solid var(--gray-200);border-radius:6px;font-size:13px;">
      </div>

      <div style="margin-bottom:16px;">
        <label style="display:block;font-weight:600;margin-bottom:6px;font-size:12px;">Description</label>
        <textarea id="actionItemDescription" placeholder="Additional details..." style="width:100%;padding:10px;border:1px solid var(--gray-200);border-radius:6px;font-size:13px;min-height:80px;"></textarea>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
        <div>
          <label style="display:block;font-weight:600;margin-bottom:6px;font-size:12px;">Assign To *</label>
          <select id="actionItemAssignee" style="width:100%;padding:10px;border:1px solid var(--gray-200);border-radius:6px;font-size:13px;">
            <option value="">Select Employee</option>
            <option value="raj.patel@funding-sathi.com">Raj Patel</option>
            <option value="saleem@funding-sathi.com">Saleem Khan</option>
          </select>
        </div>
        <div>
          <label style="display:block;font-weight:600;margin-bottom:6px;font-size:12px;">Due Date *</label>
          <input id="actionItemDueDate" type="date" style="width:100%;padding:10px;border:1px solid var(--gray-200);border-radius:6px;font-size:13px;">
        </div>
      </div>

      <div style="margin-bottom:20px;">
        <label style="display:block;font-weight:600;margin-bottom:6px;font-size:12px;">Priority</label>
        <select id="actionItemPriority" style="width:100%;padding:10px;border:1px solid var(--gray-200);border-radius:6px;font-size:13px;">
          <option value="low">Low</option>
          <option value="medium" selected>Medium</option>
          <option value="high">High</option>
          <option value="urgent">Urgent</option>
        </select>
      </div>

      <div style="display:flex;gap:12px;justify-content:flex-end;">
        <button class="btn btn-outline" onclick="closeActionItemsForm()">Cancel</button>
        <button class="btn btn-primary" onclick="createTaskFromActionItem()">Create Task</button>
      </div>
    </div>
  </div>
</div>

<div class="modal-ov" id="leadSuccessModal" style="display:none;">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="leadSuccessTitle">
    <div class="modal-header">
      <div class="modal-hd-left">
        <div class="modal-icon" style="background: linear-gradient(135deg, #28a745, #1e7e34); font-size: 18px;">✓</div>
        <div>
          <h3 class="modal-title" id="leadSuccessTitle">Lead Created Successfully</h3>
          <p class="modal-sub">The new lead has been recorded and is available in Lead Journey.</p>
        </div>
      </div>
      <button type="button" class="modal-close" aria-label="Close" onclick="closeLeadSuccessModal()">×</button>
    </div>
    <div class="modal-body" id="leadSuccessBody" style="gap:16px; display:grid;">
      <!-- Lead summary will be populated here -->
    </div>
    <div class="modal-footer">
      <button class="btn-outline" type="button" onclick="closeLeadSuccessModal()">Close</button>
      <button class="btn-outline" type="button" onclick="addAnotherLeadFromSuccess()">Add Another Lead</button>
      <button class="btn-primary" type="button" onclick="openLeadJourneyFromSuccess()">View Lead Journey</button>
    </div>
  </div>
</div>

<div class="modal-ov" id="importCSVModal" style="display:none;">
  <div class="modal" role="dialog" aria-modal="true">
    <div class="modal-header">
      <h3 class="modal-title">Import Leads from CSV</h3>
      <button type="button" class="modal-close" aria-label="Close" onclick="closeImportCSVModal()">×</button>
    </div>
    <div class="modal-body">
      <div style="margin-bottom:16px;">
        <label style="display:block;margin-bottom:8px;font-weight:500;">Select CSV File</label>
        <input type="file" id="csvFileInput" accept=".csv" style="width:100%;padding:8px;border:1px solid var(--gray-200);border-radius:6px;">
      </div>
      <div style="margin-bottom:16px;font-size:12px;color:var(--gray-500);">
        <p><strong>Supported CSV format:</strong></p>
        <ul style="margin:8px 0;padding-left:20px;">
          <li>Comma (,) or semicolon (;) delimited</li>
          <li>Headers: lead_name, company_name, mobile, email, city, state, product_type, lead_source, lead_status, remarks</li>
          <li>Or JSON data column with contactPerson, companyName, contactNumber, emailId, etc.</li>
        </ul>
      </div>
      <div id="importProgress" style="display:none;margin-bottom:16px;">
        <div style="font-size:13px;color:var(--gray-600);">Importing leads...</div>
      </div>
      <div id="importResult" style="display:none;margin-bottom:16px;padding:12px;border-radius:6px;"></div>
    </div>
    <div class="modal-footer">
      <button class="btn-outline" type="button" onclick="closeImportCSVModal()">Cancel</button>
      <button class="btn-primary" type="button" onclick="importLeadsCSV()">Import</button>
    </div>
  </div>
</div>

<!-- Lender Modal -->
<div class="modal-ov" id="lenderModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center;padding:24px;">
  <div class="modal" role="dialog" aria-modal="true" style="display:flex;flex-direction:column;background:white;max-width:800px;border-radius:10px;box-shadow:0 10px 30px rgba(0,0,0,0.08);border:1px solid #e2e8f0;width:100%;">
    <div class="modal-header" style="padding:18px 24px 0 24px;">
      <h2 id="lenderModalTitle" style="margin:0 0 14px 0;font-size:18px;font-weight:600;">Add New Lender</h2>
      <button type="button" class="modal-close" aria-label="Close" onclick="closeLenderModal()" style="position:absolute;top:18px;right:24px;background:none;border:none;font-size:24px;cursor:pointer;color:#64748b;">×</button>
      
      <div class="tabs" style="display:flex;gap:4px;border-bottom:1px solid #e2e8f0;">
        <button type="button" class="tab-btn active" data-tab="intl" onclick="switchTab('intl')" style="flex:1;padding:12px 10px;text-align:center;background:#f1f5f9;border:1px solid #e2e8f0;border-bottom:none;border-radius:8px 8px 0 0;font-size:13px;font-weight:700;color:#64748b;cursor:pointer;position:relative;top:1px;">
          <span class="tab-icon" style="display:block;font-size:16px;margin-bottom:2px;">🌐</span>A. International Trade Finance
        </button>
        <button type="button" class="tab-btn" data-tab="scf" onclick="switchTab('scf')" style="flex:1;padding:12px 10px;text-align:center;background:#f1f5f9;border:1px solid #e2e8f0;border-bottom:none;border-radius:8px 8px 0 0;font-size:13px;font-weight:700;color:#64748b;cursor:pointer;position:relative;top:1px;">
          <span class="tab-icon" style="display:block;font-size:16px;margin-bottom:2px;">🔗</span>B. Supply Chain Finance
        </button>
        <button type="button" class="tab-btn" data-tab="pc" onclick="switchTab('pc')" style="flex:1;padding:12px 10px;text-align:center;background:#f1f5f9;border:1px solid #e2e8f0;border-bottom:none;border-radius:8px 8px 0 0;font-size:13px;font-weight:700;color:#64748b;cursor:pointer;position:relative;top:1px;">
          <span class="tab-icon" style="display:block;font-size:16px;margin-bottom:2px;">💳</span>C. Private Credit
        </button>
      </div>
    </div>

    <form id="lenderForm">
    <div class="modal-body" style="padding:20px 24px;max-height:70vh;overflow-y:auto;">

      <!-- ============ COMMON: Basic Information (shown on every tab) ============ -->
      <div class="section" style="margin-bottom:26px;">
        <p class="section-title" style="font-size:14px;font-weight:700;color:#1e293b;margin:0 0 14px 0;padding-bottom:8px;border-bottom:1px solid #e2e8f0;">1. Basic Information</p>
        <div class="row" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
          <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Lender Name</label><input type="text" placeholder="e.g., HDFC Bank" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
          <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Priority Score <span class="hint" style="font-weight:400;color:#64748b;">(0-10)</span></label><input type="number" min="0" max="10" placeholder="0-10" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
        </div>
        <div class="row" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
          <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">SLA (Days)</label><input type="text" placeholder="e.g., 2-3 business days" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
          <div class="field field-flex-end" style="display:flex;align-items:flex-end;">
            <div class="checkbox-row" style="display:flex;align-items:center;gap:8px;margin-bottom:10px;"><input type="checkbox" id="activeStatus" checked style="width:16px;height:16px;accent-color:#2563eb;cursor:pointer;"><label for="activeStatus" style="font-size:13px;font-weight:600;color:#1e293b;cursor:pointer;margin:0;">Active Status</label></div>
          </div>
        </div>
        <div class="row" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
          <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Logo URL</label><input type="url" placeholder="https://example.com/logo.png" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
          <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Slug</label><input type="text" placeholder="e.g., hdfc-bank" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
        </div>
        <div class="row single" style="display:grid;grid-template-columns:1fr;gap:14px;margin-bottom:14px;">
          <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Eligible Entity Types <span class="hint" style="font-weight:400;color:#64748b;">(comma separated)</span></label><input type="text" placeholder="e.g., Proprietorship, Partnership, Pvt Ltd" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
        </div>
      </div>

      <!-- ============================================================= -->
      <!-- PANEL 1: INTERNATIONAL FINANCE -->
      <!-- ============================================================= -->
      <div class="product-panel active" id="panel-intl">

        <div class="section" style="margin-bottom:26px;">
          <p class="section-title" style="font-size:14px;font-weight:700;color:#1e293b;margin:0 0 14px 0;padding-bottom:8px;border-bottom:1px solid #e2e8f0;">2. International Trade Finance — Sub-Products</p>
          <div class="sub-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:6px 14px;margin-bottom:14px;">
            <div class="sub-checkbox" style="display:flex;align-items:center;gap:7px;"><input type="checkbox" id="if-1" style="width:14px;height:14px;accent-color:#2563eb;cursor:pointer;"><label for="if-1" style="font-size:12.5px;color:#1e293b;font-weight:500;cursor:pointer;">Acquisition Finance</label></div>
            <div class="sub-checkbox" style="display:flex;align-items:center;gap:7px;"><input type="checkbox" id="if-2" style="width:14px;height:14px;accent-color:#2563eb;cursor:pointer;"><label for="if-2" style="font-size:12.5px;color:#1e293b;font-weight:500;cursor:pointer;">Import Finance</label></div>
            <div class="sub-checkbox" style="display:flex;align-items:center;gap:7px;"><input type="checkbox" id="if-3" style="width:14px;height:14px;accent-color:#2563eb;cursor:pointer;"><label for="if-3" style="font-size:12.5px;color:#1e293b;font-weight:500;cursor:pointer;">Export Finance</label></div>
            <div class="sub-checkbox" style="display:flex;align-items:center;gap:7px;"><input type="checkbox" id="if-4" style="width:14px;height:14px;accent-color:#2563eb;cursor:pointer;"><label for="if-4" style="font-size:12.5px;color:#1e293b;font-weight:500;cursor:pointer;">Buyer Credit</label></div>
          </div>
        </div>

        <div class="section" style="margin-bottom:26px;">
          <p class="section-title" style="font-size:14px;font-weight:700;color:#1e293b;margin:0 0 14px 0;padding-bottom:8px;border-bottom:1px solid #e2e8f0;">3. Order Value &amp; Eligibility</p>
          <div class="row" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
            <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Min Export Order Value (₹)</label><input type="number" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
            <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Max Export Order Value (₹)</label><input type="number" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
          </div>
          <div class="row" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
            <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Min Import Order Value (₹)</label><input type="number" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
            <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Max Import Order Value (₹)</label><input type="number" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
          </div>
          <div class="row" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
            <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Min Years in Import/Export Business</label><input type="number" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
            <div class="field field-flex-end" style="display:flex;align-items:flex-end;">
              <div class="checkbox-row" style="display:flex;align-items:center;gap:8px;margin-bottom:10px;"><input type="checkbox" id="requiresIEC" style="width:16px;height:16px;accent-color:#2563eb;cursor:pointer;"><label for="requiresIEC" style="font-size:13px;font-weight:600;color:#1e293b;cursor:pointer;margin:0;">Requires IEC</label></div>
            </div>
          </div>
        </div>

        <div class="section" style="margin-bottom:26px;">
          <p class="section-title" style="font-size:14px;font-weight:700;color:#1e293b;margin:0 0 14px 0;padding-bottom:8px;border-bottom:1px solid #e2e8f0;">4. Trade &amp; Pricing Terms <span class="badge" style="display:inline-block;font-size:11px;font-weight:700;color:#2563eb;background:#eff6ff;border:1px solid #bfdbfe;padding:2px 8px;border-radius:20px;margin-left:8px;vertical-align:middle;">New</span></p>
          <div class="row" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
            <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">ROI / Interest Rate (%)</label><input type="text" placeholder="e.g., 8-11% p.a." style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
            <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Advance Rate (%)</label><input type="number" placeholder="e.g., 80" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
          </div>
          <div class="row" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
            <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Processing Fee (%)</label><input type="number" step="0.1" placeholder="e.g., 0.5" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
            <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Tenure (Days)</label><input type="number" placeholder="e.g., 90" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
          </div>
          <div class="row single" style="display:grid;grid-template-columns:1fr;gap:14px;margin-bottom:14px;">
