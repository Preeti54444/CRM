<script>
  // Attach click handlers to report generate buttons as a fallback.
  (function(){
    document.addEventListener('DOMContentLoaded', function(){
      const buttons = document.querySelectorAll('.report-generate-btn')
      buttons.forEach(btn => {
        if (btn.__reportBound) return
        btn.addEventListener('click', async function(e){
          const type = btn.dataset.reportType
          const originalHtml = btn.innerHTML
          try {
            btn.disabled = true
            btn.innerHTML = '<div class="spinner"></div> Generating…'

            if (typeof generateReport === 'function') {
              await generateReport(btn, type)
              return
            }

            console.error('generateReport not available')
            if (typeof window.showToast === 'function') {
              window.showToast('Report generation unavailable', 'error')
            } else {
              alert('Report generation unavailable')
            }
          } catch (err) {
            console.error('Report generation failed:', err)
            if (typeof window.showToast === 'function') {
              window.showToast('Report generation failed. Check console for details.', 'error')
            } else {
              alert('Report generation failed')
            }
          } finally {
            btn.disabled = false
            btn.innerHTML = originalHtml
          }
        })
        btn.__reportBound = true
      })
    })
  })();
</script>
<style>
  /* Accessibility helpers */
  .sr-only { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  button.accessible-btn:focus { outline: 3px solid #2563eb; outline-offset: 2px; }
  button.accessible-btn { transition: box-shadow 120ms ease; }
  /* Ensure emoji icons are ignored by assistive tech when a proper label exists */
  .btn-icon { font-size: 16px; line-height: 1; display:inline-block; width:1em; text-align:center }
</style>
<script src="js/accessibility-init.js"></script>

