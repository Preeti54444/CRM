            <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Prepayment Penalty (%)</label><input type="number" step="0.1" placeholder="e.g., 3" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
          </div>
          <div class="row" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
            <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Tenure (Months)</label><input type="number" placeholder="e.g., 36" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
