      <!-- ============ COMMON: Remaining sections (shown on every tab) ============ -->
      <div class="section" style="margin-bottom:26px;">
        <p class="section-title" style="font-size:14px;font-weight:700;color:#1e293b;margin:0 0 14px 0;padding-bottom:8px;border-bottom:1px solid #e2e8f0;">6. Security &amp; Property Requirements</p>
        <div class="row" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
          <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Security Requirement</label><textarea placeholder="e.g., Collateral-free for loans up to ₹50 Lacs" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;resize:vertical;min-height:60px;color:#1e293b;background:#fff;"></textarea></div>
          <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Property Requirement</label><textarea placeholder="e.g., Property ownership in same city required" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;resize:vertical;min-height:60px;color:#1e293b;background:#fff;"></textarea></div>
        </div>
      </div>

      <div class="section" style="margin-bottom:26px;">
        <p class="section-title" style="font-size:14px;font-weight:700;color:#1e293b;margin:0 0 14px 0;padding-bottom:8px;border-bottom:1px solid #e2e8f0;">7. Legal Documents</p>
        <div class="row triple" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:14px;">
          <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">GST Number</label><input type="text" placeholder="e.g., 27ABCDE1234F1Z5" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
          <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">PAN Number</label><input type="text" placeholder="e.g., ABCDE1234F" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
          <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">CIN Number</label><input type="text" placeholder="e.g., U12345MH2023PTC123456" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
        </div>
      </div>

      <div class="section" style="margin-bottom:26px;">
        <p class="section-title" style="font-size:14px;font-weight:700;color:#1e293b;margin:0 0 14px 0;padding-bottom:8px;border-bottom:1px solid #e2e8f0;">8. Additional Requirements</p>
        <div class="checkbox-row" style="display:flex;align-items:center;gap:8px;margin-bottom:10px;"><input type="checkbox" id="atnw" style="width:16px;height:16px;accent-color:#2563eb;cursor:pointer;"><label for="atnw" style="font-size:13px;font-weight:600;color:#1e293b;cursor:pointer;margin:0;">Requires ATNW Positive (After Tax Net Worth)</label></div>
        <div class="checkbox-row" style="display:flex;align-items:center;gap:8px;margin-bottom:10px;"><input type="checkbox" id="ownedProperty" style="width:16px;height:16px;accent-color:#2563eb;cursor:pointer;"><label for="ownedProperty" style="font-size:13px;font-weight:600;color:#1e293b;cursor:pointer;margin:0;">Requires Owned Property</label></div>
      </div>

      <div class="section" style="margin-bottom:26px;">
        <p class="section-title" style="font-size:14px;font-weight:700;color:#1e293b;margin:0 0 14px 0;padding-bottom:8px;border-bottom:1px solid #e2e8f0;">9. Performance Metrics</p>
        <div class="row" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
          <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Historical Approval Rate (%)</label><input type="number" step="0.1" placeholder="e.g., 75.5" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
          <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Historical Rejection Rate (%)</label><input type="number" step="0.1" placeholder="e.g., 15.0" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
        </div>
        <div class="row" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
          <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Average Approval Days</label><input type="number" placeholder="e.g., 5" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
          <div class="field"><label style="display:block;font-size:13px;font-weight:600;color:#1e293b;margin-bottom:5px;">Average Disbursement Days</label><input type="number" placeholder="e.g., 7" style="width:100%;padding:9px 11px;font-size:13px;border:1px solid #e2e8f0;border-radius:6px;color:#1e293b;background:#fff;"></div>
        </div>
      </div>

    </div>

    <div class="modal-footer" style="padding:16px 24px;border-top:1px solid #e2e8f0;display:flex;justify-content:flex-end;gap:10px;">
      <button type="button" class="btn btn-cancel" onclick="document.getElementById('lenderForm').reset()" style="padding:9px 18px;font-size:13px;font-weight:600;border-radius:6px;cursor:pointer;border:1px solid #e2e8f0;background:#fff;color:#1e293b;">Cancel</button>
      <button type="submit" class="btn btn-save" style="padding:9px 18px;font-size:13px;font-weight:600;border-radius:6px;cursor:pointer;background:#2563eb;color:#fff;border-color:#2563eb;">Save Lender</button>
    </div>
    </form>
  </div>
</div>

