        </div>
        <div class="kpi-card">
          <div class="kpi-header">
            <div class="kpi-icon" style="background:#f3e8ff;color:#7c3aed;"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg></div>
            <div class="kpi-trend up"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M7 17l5-5 5 5"/><path d="M12 12V3"/></svg>+20.6%</div>
          </div>
          <div class="kpi-value" id="kpi-revenue">₹0</div>
          <div class="kpi-label">Total Revenue</div>
          <svg class="kpi-sparkline" viewBox="0 0 100 30"><polyline points="0,15 10,18 20,16 30,20 40,17 50,22 60,18 70,21 80,19 90,23 100,20" fill="none" stroke="#7c3aed" stroke-width="2"/></svg>
        </div>
        <div class="kpi-card">
          <div class="kpi-header">
            <div class="kpi-icon" style="background:#ecfccb;color:#65a30d;"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 20c4.97 0 9-4.03 9-9s-4.03-9-9-9-9 4.03-9 9 4.03 9 9 9Z"/><path d="M9 12l2 2 4-4"/></svg></div>
            <div class="kpi-trend up"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M7 17l5-5 5 5"/><path d="M12 12V3"/></svg>Live</div>
          </div>
          <div class="kpi-value" id="kpi-logins">0</div>
          <div class="kpi-label">No. of Logins</div>
          <svg class="kpi-sparkline" viewBox="0 0 100 30"><polyline points="0,17 15,14 30,10 45,12 60,8 75,13 90,8 100,10" fill="none" stroke="#65a30d" stroke-width="2"/></svg>
        </div>
        <div class="kpi-card">
          <div class="kpi-header">
            <div class="kpi-icon" style="background:#fefce8;color:#b45309;"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 3v18"/><path d="M5 12h14"/></svg></div>
            <div class="kpi-trend up"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M7 17l5-5 5 5"/><path d="M12 12V3"/></svg>+6.1%</div>
          </div>
          <div class="kpi-value" id="kpi-sanctions">0</div>
          <div class="kpi-label">No. of Sanctions</div>
          <svg class="kpi-sparkline" viewBox="0 0 100 30"><polyline points="0,20 10,17 20,14 30,16 40,12 50,14 60,10 70,13 80,9 90,11 100,8" fill="none" stroke="#b45309" stroke-width="2"/></svg>
        </div>
        <div class="kpi-card">
          <div class="kpi-header">
            <div class="kpi-icon" style="background:#ede9fe;color:#5b21b6;"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16v16H4z"/><path d="M8 12h8"/><path d="M12 8v8"/></svg></div>
            <div class="kpi-trend up"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M7 17l5-5 5 5"/><path d="M12 12V3"/></svg>+9.4%</div>
          </div>
          <div class="kpi-value" id="kpi-disbursement">₹0</div>
          <div class="kpi-label">Loan Amount Disbursed</div>
          <svg class="kpi-sparkline" viewBox="0 0 100 30"><polyline points="0,25 10,22 20,20 30,18 40,19 50,15 60,16 70,12 80,14 90,10 100,12" fill="none" stroke="#5b21b6" stroke-width="2"/></svg>
        </div>
        <div class="kpi-card">
          <div class="kpi-header">
            <div class="kpi-icon" style="background:#fef2f2;color:#dc2626;"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 8a3 3 0 0 1 6 0v2h3a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1h3V8Z"/><path d="M12 11v6"/></svg></div>
            <div class="kpi-trend up"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M7 17l5-5 5 5"/><path d="M12 12V3"/></svg>+14.2%</div>
          </div>
          <div class="kpi-value" id="kpi-conversion-rate">0%</div>
          <div class="kpi-label">Conversion Rate</div>
          <svg class="kpi-sparkline" viewBox="0 0 100 30"><polyline points="0,18 10,21 20,19 30,23 40,20 50,24 60,19 70,22 80,18 90,16 100,14" fill="none" stroke="#dc2626" stroke-width="2"/></svg>
        </div>
        <div class="kpi-card">
          <div class="kpi-header">
            <div class="kpi-icon" style="background:#ffedd5;color:#ea580c;"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7H14.5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
            <div class="kpi-trend up"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M7 17l5-5 5 5"/><path d="M12 12V3"/></svg>+9.8%</div>
          </div>
          <div class="kpi-value" id="kpi-funding-share">₹0</div>
          <div class="kpi-label">Funding Sathi Revenue Share</div>
          <svg class="kpi-sparkline" viewBox="0 0 100 30"><polyline points="0,14 12,16 24,10 36,12 48,8 60,9 72,6 84,7 96,4 100,3" fill="none" stroke="#ea580c" stroke-width="2"/></svg>
        </div>
        <div class="kpi-card">
          <div class="kpi-header">
            <div class="kpi-icon" style="background:#e0f2fe;color:#0284c7;"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 12h18"/><path d="M12 3v18"/><path d="M5 5l14 14"/><path d="M19 5L5 19"/></svg></div>
            <div class="kpi-trend up"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M7 17l5-5 5 5"/><path d="M12 12V3"/></svg>+11.5%</div>
          </div>
          <div class="kpi-value" id="kpi-weighted-pipeline">₹0</div>
          <div class="kpi-label">Weighted Pipeline</div>
          <svg class="kpi-sparkline" viewBox="0 0 100 30"><polyline points="0,24 10,18 20,20 30,15 40,16 50,12 60,14 70,9 80,11 90,7 100,5" fill="none" stroke="#0284c7" stroke-width="2"/></svg>
        </div>
      </div>
      <!-- Performance Dashboard Container -->
      <div id="performanceDashboard" style="margin-top:18px;padding:14px;background:#fff;border:1px solid var(--gray-100);border-radius:8px;"></div>

      <!-- Follow-up Reminders Widget -->
      <div id="followupRemindersWidget" style="margin-top:18px;"></div>

      <div class="dashboard-summary-grid admin-only-section">
        <div class="dash-card">
          <div class="card-header">
            <div>
              <div class="card-title">Sales Overview</div>
              <div class="card-subtitle">Revenue and deal conversion trends</div>
            </div>
            <button class="btn btn-outline" onclick="nav(document.querySelector('[data-sec=analytics]'))">View Chart</button>
          </div>
          <div class="revenue-chart" id="salesOverviewContainer">
            <div style="min-height:240px;display:flex;align-items:center;justify-content:center;color:var(--gray-400);">Sales overview chart placeholder</div>
          </div>
        </div>
        <div class="dash-card">
          <div class="card-header">
            <div>
              <div class="card-title">Leads by Source</div>
              <div class="card-subtitle">Where your leads are coming from</div>
            </div>
          </div>
          <div id="leadsBySourceContainer" style="min-height:240px;display:flex;align-items:center;justify-content:center;color:var(--gray-400);">Pie chart placeholder</div>
        </div>
      </div>

      <div class="filter-row" style="display:flex;justify-content:flex-end;align-items:center;margin:12px 0 0;">
        <select id="dashboardEmployeeFilter" class="sel-f" onchange="updateDashboardEmployeeFilter()">
          <option value="">All Executives</option>
        </select>
      </div>

      <!-- Deal Pipeline -->
      <div class="pipeline-section">
        <div class="section-header">
          <div>
            <div class="section-title">Deal Pipeline</div>
            <div class="section-subtitle" id="pipeline-total-value">₹0Cr total pipeline value</div>
          </div>
          <button class="btn btn-outline" onclick="nav(document.querySelector('[data-sec=pipeline]'))">View Full Pipeline</button>
        </div>
        <div class="pipeline-stages">
          <div class="pipeline-stage">
            <div class="stage-header">
              <div class="stage-dot" style="background:#14b8a6;"></div>
              <div class="stage-name">Login Docs Submitted</div>
              <div class="stage-count" id="pipeline-login-docs-submitted-count">0</div>
            </div>
            <div class="stage-value" id="pipeline-login-docs-submitted-value">₹0Cr</div>
            <div class="stage-bar"><div class="stage-fill" id="pipeline-login-docs-submitted-bar" style="width:100%;background:#14b8a6;"></div></div>
          </div>
          <div class="pipeline-stage">
            <div class="stage-header">
              <div class="stage-dot" style="background:#059669;"></div>
              <div class="stage-name">Approved Limit</div>
              <div class="stage-count" id="pipeline-approved-limit-count">0</div>
            </div>
            <div class="stage-value" id="pipeline-approved-limit-value">₹0Cr</div>
            <div class="stage-bar"><div class="stage-fill" id="pipeline-approved-limit-bar" style="width:75%;background:#059669;"></div></div>
          </div>
          <div class="pipeline-stage">
            <div class="stage-header">
              <div class="stage-dot" style="background:#0f766e;"></div>
              <div class="stage-name">Sanction Docs</div>
              <div class="stage-count" id="pipeline-sanction-docs-count">0</div>
            </div>
            <div class="stage-value" id="pipeline-sanction-docs-value">₹0Cr</div>
            <div class="stage-bar"><div class="stage-fill" id="pipeline-sanction-docs-bar" style="width:60%;background:#0f766e;"></div></div>
          </div>
          <div class="pipeline-stage">
            <div class="stage-header">
              <div class="stage-dot" style="background:#c2410c;"></div>
              <div class="stage-name">Pre-Disbursement</div>
              <div class="stage-count" id="pipeline-pre-disbursement-count">0</div>
            </div>
            <div class="stage-value" id="pipeline-pre-disbursement-value">₹0Cr</div>
            <div class="stage-bar"><div class="stage-fill" id="pipeline-pre-disbursement-bar" style="width:45%;background:#c2410c;"></div></div>
          </div>
          <div class="pipeline-stage">
            <div class="stage-header">
              <div class="stage-dot" style="background:#f97316;"></div>
              <div class="stage-name">Disbursement</div>
              <div class="stage-count" id="pipeline-disbursement-count">0</div>
            </div>
            <div class="stage-value" id="pipeline-disbursement-value">₹0Cr</div>
            <div class="stage-bar"><div class="stage-fill" id="pipeline-disbursement-bar" style="width:30%;background:#f97316;"></div></div>
          </div>
          <div class="pipeline-stage">
            <div class="stage-header">
              <div class="stage-dot" style="background:#047857;"></div>
              <div class="stage-name">Payout Received</div>
              <div class="stage-count" id="pipeline-payout-received-count">0</div>
            </div>
            <div class="stage-value" id="pipeline-payout-received-value">₹0Cr</div>
            <div class="stage-bar"><div class="stage-fill" id="pipeline-payout-received-bar" style="width:20%;background:#047857;"></div></div>
          </div>
          <div class="pipeline-stage">
            <div class="stage-header">
              <div class="stage-dot" style="background:#10b981;"></div>
              <div class="stage-name">Closed Won</div>
              <div class="stage-count" id="pipeline-closed-won-count">0</div>
            </div>
            <div class="stage-value" id="pipeline-closed-won-value">₹0Cr</div>
            <div class="stage-bar"><div class="stage-fill" id="pipeline-closed-won-bar" style="width:34%;background:#10b981;"></div></div>
          </div>
          <div class="pipeline-stage">
            <div class="stage-header">
              <div class="stage-dot" style="background:#ef4444;"></div>
              <div class="stage-name">Closed Lost</div>
              <div class="stage-count" id="pipeline-closed-lost-count">0</div>
            </div>
            <div class="stage-value" id="pipeline-closed-lost-value">₹0Cr</div>
            <div class="stage-bar"><div class="stage-fill" id="pipeline-closed-lost-bar" style="width:17%;background:#ef4444;"></div></div>
          </div>
        </div>
      </div>

      <div class="dashboard-grid admin-only-section">
        <div class="dash-card">
          <div class="card-header">
            <div>
              <div class="card-title">Recent Activities</div>
              <div class="card-subtitle">Team actions and follow-ups</div>
            </div>
          </div>
          <div class="activity-list" id="activityList">
            <div style="padding:20px;text-align:center;color:var(--gray-400);">No recent activity</div>
          </div>
        </div>
        <div class="dash-card">
          <div class="card-header">
            <div>
              <div class="card-title">Tasks Overview</div>
              <div class="card-subtitle">Open, in progress, and overdue tasks</div>
            </div>
          </div>
          <div style="padding:24px;">
            <canvas id="tasksChart" style="max-height:240px;"></canvas>
          </div>
        </div>
        <div class="dash-card">
          <div class="card-header">
            <div>
              <div class="card-title">Top Deals</div>
              <div class="card-subtitle">Highest value opportunities</div>
            </div>
          </div>
          <div class="leads-table-container">
            <table class="leads-table">
              <thead>
                <tr>
                  <th>Deal Name</th>
                  <th>Client</th>
                  <th>Value</th>
                  <th>Stage</th>
                  <th>Close Date</th>
                </tr>
              </thead>
              <tbody id="topDealsBody">
                <tr><td colspan="5" style="text-align:center;color:var(--gray-400);">No deals available</td></tr>
              </tbody>
            </table>
          </div>
        </div>
        <div class="dash-card">
          <div class="card-header">
            <div>
              <div class="card-title">Team Performance</div>
              <div class="card-subtitle">Employee win rates and revenue</div>
            </div>
          </div>
          <div style="padding:20px;">
            <table class="leads-table">
              <thead>
                <tr>
                  <th>User</th>
                  <th>Deals Won</th>
                  <th>Revenue</th>
                  <th>Win Rate</th>
                </tr>
              </thead>
              <tbody id="teamPerformanceBody">
                <tr><td colspan="4" style="text-align:center;color:var(--gray-400);">No data available</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Dashboard Grid -->
      <div class="dashboard-grid">
        <!-- Recent Leads -->
        <div class="dash-card leads-card">
          <div class="card-header">
            <div>
              <div class="card-title">Report Summary</div>
              <div class="card-subtitle">SOD, EOD and WOD report counts</div>
            </div>
            <button class="btn btn-outline" onclick="nav(document.querySelector('[data-sec=report]'))">View Reports</button>
          </div>
          <div class="report-summary-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:12px;margin-top:18px;padding:0 4px;">
            <div style="background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:18px;text-align:center;">
              <div style="font-size:28px;font-weight:700;color:#2563eb;" id="report-sod-count">0</div>
              <div style="margin-top:8px;font-size:12px;color:#6b7280;">SOD Reports</div>
            </div>
            <div style="background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:18px;text-align:center;">
              <div style="font-size:28px;font-weight:700;color:#059669;" id="report-eod-count">0</div>
              <div style="margin-top:8px;font-size:12px;color:#6b7280;">EOD Reports</div>
            </div>
            <div style="background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:18px;text-align:center;">
              <div style="font-size:28px;font-weight:700;color:#7c3aed;" id="report-wod-count">0</div>
              <div style="margin-top:8px;font-size:12px;color:#6b7280;">WOD Reports</div>
            </div>
          </div>
        </div>

        <!-- Lead Funnel -->
        <div class="dash-card funnel-card">
          <div class="card-header">
            <div>
              <div class="card-title">Lead Funnel</div>
              <div class="card-subtitle">Conversion from lead to win</div>
            </div>
          </div>
          <div class="funnel-visual">
            <div class="funnel-stage" style="width:100%;">
              <div class="funnel-bar" style="background:#94a3b8;">
                <span class="funnel-label">Leads</span>
                <span class="funnel-count" id="funnel-leads-count">0</span>
              </div>
            </div>
            <div class="funnel-connector"></div>
            <div class="funnel-stage" style="width:85%;">
              <div class="funnel-bar" style="background:#60a5fa;">
                <span class="funnel-label">Contacted</span>
                <span class="funnel-count" id="funnel-contacted-count">0</span>
                <span class="funnel-drop" id="funnel-contacted-drop">-0%</span>
              </div>
            </div>
            <div class="funnel-connector"></div>
            <div class="funnel-stage" style="width:70%;">
              <div class="funnel-bar" style="background:#3b82f6;">
                <span class="funnel-label">Qualified</span>
                <span class="funnel-count" id="funnel-qualified-count">0</span>
                <span class="funnel-drop" id="funnel-qualified-drop">-0%</span>
              </div>
            </div>
            <div class="funnel-connector"></div>
            <div class="funnel-stage" style="width:50%;">
              <div class="funnel-bar" style="background:#8b5cf6;">
                <span class="funnel-label">Proposal</span>
                <span class="funnel-count" id="funnel-proposal-count">0</span>
                <span class="funnel-drop" id="funnel-proposal-drop">-0%</span>
              </div>
            </div>
            <div class="funnel-connector"></div>
            <div class="funnel-stage" style="width:34%;">
              <div class="funnel-bar" style="background:#a855f7;">
                <span class="funnel-label">Negotiation</span>
                <span class="funnel-count" id="funnel-negotiation-count">0</span>
                <span class="funnel-drop" id="funnel-negotiation-drop">-0%</span>
              </div>
            </div>
            <div class="funnel-connector"></div>
            <div class="funnel-stage" style="width:28%;">
              <div class="funnel-bar" style="background:#10b981;">
                <span class="funnel-label">Won</span>
                <span class="funnel-count" id="funnel-won-count">0</span>
                <span class="funnel-rate" id="funnel-won-rate">0% conv.</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Tasks Panel -->
        <div class="dash-card tasks-card">
          <div class="card-header">
            <div>
              <div class="card-title">Tasks</div>
              <div class="card-subtitle" id="tasksSubtitle">5 pending</div>
            </div>
            <button class="btn btn-outline" onclick="addTask()">+ New Task</button>
          </div>
          <div class="tasks-list" id="tasksList">
            <div style="padding:20px;text-align:center;color:var(--gray-400);">No tasks yet</div>
          </div>
        </div>

        <!-- Revenue by Source -->
        <div class="dash-card revenue-card">
          <div class="card-header">
            <div>
              <div class="card-title">Revenue by Source</div>
              <div class="card-subtitle">Deal distribution by channel</div>
            </div>
          </div>
          <div class="revenue-chart" id="revenueChart">
            <div style="padding:20px;text-align:center;color:var(--gray-400);">No revenue data available</div>
          </div>
          <div class="revenue-stats">
            <div class="revenue-stat">
              <div class="stat-value" id="revenue-avg-deal">₹0L</div>
              <div class="stat-label">Avg Deal Size</div>
            </div>
            <div class="revenue-stat">
              <div class="stat-value" id="revenue-sales-cycle">0 days</div>
              <div class="stat-label">Sales Cycle</div>
            </div>
            <div class="revenue-stat">
              <div class="stat-value" id="revenue-win-rate">0%</div>
              <div class="stat-label">Win Rate</div>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- ── MEET TOOLS (Google Meet / Zoom / Teams) ── -->
    <section class="section" id="sec-meet-tools">
      <!-- Content injected by JavaScript (renderMeetTools) -->
    </section>

    <!-- ── SOD FORM ── -->
    <section class="section" id="sec-sod-form">
      <div class="form-wrap">
        <div class="form-card">
          <div class="form-hero sod-hero">
            <h2>Start of Day Report</h2>
            <p>Plan your day ahead with clear objectives and focus areas</p>
            <div class="form-meta">
              <div class="form-meta-chip" id="sodHeroDate">—</div>
              <div class="form-meta-chip" id="sodHeroUser">—</div>
            </div>
          </div>
          <div class="form-body">
            <div class="f-section">
              <div class="f-section-title">Basic Information</div>
              <div class="f-grid">
                <div class="field"><label>Sales Executive <span class="req">*</span></label>
                  <select id="sExec"><option value="">Select Executive</option><option>Vaibhav Borge</option><option>Saleem Khan</option><option>Roshan Chawan</option></select></div>
                <div class="field"><label>Date <span class="req">*</span></label><input type="text" id="sDate" readonly style="background: var(--gray-100); cursor: not-allowed;"></div>
                <div class="field"><label>Email</label><input type="text" id="sEmail" readonly></div>
                <div class="field"><label>Territory / Region</label><input type="text" id="sTerritory" placeholder="e.g. Thane, Mumbai"></div>
              </div>
            </div>
            <div class="f-section">
              <div class="f-section-title">Daily Objectives</div>
              <div class="f-grid f1">
                <div class="field"><label>Target for Today (₹/Units) <span class="req">*</span></label><input type="text" id="sTarget" placeholder="e.g. 3 leads, ₹50Cr pipeline"></div>
              </div>
              <div class="f-grid" style="margin-top:14px">
                <div class="field"><label>Key Meetings Planned</label><textarea id="sMeetings" placeholder="Client name + time..."></textarea></div>
                <div class="field"><label>Focus Industry/Segment <span class="req">*</span></label><textarea id="sIndustry" placeholder="e.g. Steel, Agro, FMCG..."></textarea></div>
              </div>
            </div>
            <div class="f-section">
              <div class="f-section-title">Support Requirements & Notes</div>
              <div style="margin-bottom:10px">
                <label style="font-size:12.5px;font-weight:600;color:var(--gray-700);display:block;margin-bottom:6px">Support Needed?</label>
                <div class="toggle-grp" style="display:inline-flex">
                  <button class="toggle-opt selected" id="suppNo" onclick="setSupportToggle('No')">No</button>
                  <button class="toggle-opt" id="suppYes" onclick="setSupportToggle('Yes')">Yes</button>
                </div>
                <div class="hint" id="suppHint">No support needed</div>
              </div>
              <div class="field" id="supportField" style="display:none"><textarea id="sSupport" placeholder="Describe the support needed..."></textarea></div>
              <div class="field" style="margin-top:14px"><label>Remarks</label><textarea id="sRemarks" placeholder="Any additional remarks..."></textarea></div>
            </div>
          </div>
          <div class="form-footer">
            <span class="form-footer-note">All required fields are marked with *</span>
            <button class="btn btn-primary" id="sodSubmitBtn" onclick="submitSOD()">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Submit Report
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- ── SOD HISTORY ── -->
    <section class="section" id="sec-sod-history">
      <div class="card">
        <div class="card-hd">
          <div><div class="card-title" id="sodHistTitle">SOD History</div><div class="card-sub" id="sodHistSub"></div></div>
          <div class="toolbar">
            <div class="srch"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/></svg><input type="text" placeholder="Search…" id="histSearch" oninput="renderSODHistory()"></div>
            <select class="sel-f" id="histExecF" onchange="renderSODHistory()" style="display:none"><option value="">All Executives</option><option>Vaibhav Borge</option><option>Saleem Khan</option><option>Roshan Chawan</option></select>
            <select class="sel-f" id="histMonthF" onchange="renderSODHistory()"><option value="">All Months</option></select>
            <input type="date" id="histDateF" class="sel-f" onchange="renderSODHistory()" title="Filter by date">
            <span id="sodHistCount" style="font-size:12px;color:var(--gray-400);"></span>
            <button class="btn btn-outline" onclick="exportData('sod')"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg> Export</button>
            <button class="btn btn-danger" onclick="deleteReportHistory('sod')">Delete</button>
            <button class="btn btn-secondary" onclick="triggerImportFor('crm_leads')">Import</button>
          </div>
        </div>
        <div style="overflow-x:auto"><div id="sodHistTableContainer" style="min-width:1200px;"></div></div>
      </div>
    </section>

    <!-- ── EOD FORM ── -->
    <section class="section" id="sec-eod-form">
      <div class="form-wrap">
        <div class="form-card">
          <div class="form-hero eod-hero">
            <h2>End of Day Report</h2>
            <p>Review your daily activities, progress, and key learnings</p>
            <div class="form-meta">
              <div class="form-meta-chip" id="eodHeroDate">—</div>
              <div class="form-meta-chip" id="eodHeroUser">—</div>
            </div>
          </div>
          <div class="form-body">
            <div class="f-section">
              <div class="f-section-title">Basic Information</div>
              <div class="f-grid">
                <div class="field"><label>Sales Executive <span class="req">*</span></label>
                  <input type="text" id="eExec" readonly style="background: var(--gray-100); cursor: not-allowed;"></div>
                <div class="field"><label>Date <span class="req">*</span></label><input type="text" id="eDate" readonly style="background: var(--gray-100); cursor: not-allowed;"></div>
              </div>
            </div>
            <div class="f-section">
              <div class="f-section-title">Daily Activities</div>
              <div class="f-grid f3">
                <div class="field"><label>Number of Calls Made</label><input type="number" id="eCallsMade" placeholder="0" min="0"></div>
                <div class="field"><label>Number of Meetings Held</label><input type="number" id="eMeetingsHeld" placeholder="e.g. 2" min="0"></div>
                <div class="field"><label>Number of Leads</label><input type="number" id="eLeads" placeholder="0" min="0"></div>
              </div>
              <div class="f-grid f1" style="margin-top:14px">
                <div class="field"><label>Key Clients Spoken To</label><textarea id="eKeyClients" placeholder="List the key clients you spoke with today..."></textarea></div>
              </div>
            </div>
            <div class="f-section">
              <div class="f-section-title">Deal Progress</div>
              <div class="f-grid f1">
                <div class="field"><label>Deals Moved to Next Stage</label><textarea id="eDeals" placeholder="Yes/No + Deal name and value ₹..."></textarea></div>
              </div>
            </div>
            <div class="f-section">
              <div class="f-section-title">Challenges & Learnings</div>
              <div class="f-grid">
                <div class="field"><label>Challenges Faced</label><textarea id="eChallenges" placeholder="What obstacles did you encounter?"></textarea></div>
                <div class="field"><label>Learnings Today</label><textarea id="eLearnings" placeholder="What did you learn today?"></textarea></div>
              </div>
              <div class="field" style="margin-top:14px"><label>Remarks</label><textarea id="eRemarks" placeholder="Any additional remarks..."></textarea></div>
            </div>
          </div>
          <div class="form-footer">
            <span class="form-footer-note">Submit before end of business day</span>
            <button class="btn btn-primary" id="eodSubmitBtn" onclick="submitEOD()">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Submit Report
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- ── EOD HISTORY ── -->
    <section class="section" id="sec-eod-history">
      <div class="card">
        <div class="card-hd">
          <div><div class="card-title">EOD History</div><div class="card-sub" id="eodHistSub"></div></div>
          <div class="toolbar">
            <div class="srch"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/></svg><input type="text" placeholder="Search…" id="eodSearch" oninput="renderEODHistory()"></div>
            <select class="sel-f" id="eodExecF" onchange="renderEODHistory()" style="display:none"><option value="">All Executives</option><option>Vaibhav Borge</option><option>Saleem Khan</option><option>Roshan Chawan</option></select>
            <input type="date" id="eodDateF" class="sel-f" onchange="renderEODHistory()" title="Filter by date">
            <span id="eodHistCount" style="font-size:12px;color:var(--gray-400);"></span>
            <button class="btn btn-outline" onclick="exportData('eod')"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg> Export</button>
            <button class="btn btn-danger" onclick="deleteReportHistory('eod')">Delete</button>
            <button class="btn btn-secondary" onclick="triggerImportFor('crm_eod')">Import</button>
          </div>
        </div>
        <div style="overflow-x:auto"><table style="min-width:1200px;"><thead><tr><th>Date</th><th>Sales Executive</th><th>Number of Calls Made</th><th>Number of Meetings Held</th><th>Number of Leads</th><th>Key Clients Spoken To</th><th>Deals Moved to Next Stage</th><th>Challenges Faced</th><th>Learnings Today</th><th>Remarks</th></tr></thead><tbody id="eodHistBody"></tbody></table></div>
      </div>
    </section>

    <!-- ── WOD FORM ── -->
    <section class="section" id="sec-wod-form">
      <div class="form-wrap">
        <div class="form-card">
          <div class="form-hero wod-hero">
            <h2>Weekly Overview Report</h2>
            <p>Track weekly performance, achievements, and plan for success</p>
            <div class="form-meta">
              <div class="form-meta-chip" id="wodHeroUser">—</div>
            </div>
          </div>
          <div class="form-body">
            <div class="f-section">
              <div class="f-section-title">Basic Information</div>
              <div class="f-grid f3">
                <div class="field"><label>Sales Executive <span class="req">*</span></label>
                  <select id="wExec"><option value="">Select Executive</option><option>Vaibhav Borge</option><option>Saleem Khan</option><option>Roshan Chawan</option></select></div>
                <div class="field"><label>Week Starting <span class="req">*</span></label><input type="text" id="wStart" readonly style="background: var(--gray-100); cursor: not-allowed;"></div>
                <div class="field"><label>Week Ending <span class="req">*</span></label><input type="text" id="wEnd" readonly style="background: var(--gray-100); cursor: not-allowed;"></div>
              </div>
            </div>
            <div class="f-section">
              <div class="f-section-title">Weekly Targets & Achievements</div>
              <div class="f-grid f3">
                <div class="field"><label>Weekly Target (₹/Leads)</label><input type="text" id="wTarget" placeholder="e.g. 10 leads, ₹200Cr"></div>
                <div class="field"><label>Achieved (₹/Leads)</label><input type="text" id="wAchieved" placeholder="e.g. 7 leads"></div>
                <div class="field"><label>Deals Closed (₹/Count)</label><input type="text" id="wDeals" placeholder="e.g. 2 deals, ₹50Cr"></div>
              </div>
              <div class="f-grid" style="margin-top:14px">
                <div class="field"><label>Hot Leads in Pipeline</label><input type="text" id="wHotLeads" placeholder="Number or list of hot leads"></div>
                <div class="field"><label>Key Wins This Week</label><textarea id="wWins" placeholder="Notable achievements..."></textarea></div>
              </div>
            </div>
            <div class="f-section">
              <div class="f-section-title">Opportunity Analysis & Action Plan</div>
              <div class="f-grid">
                <div class="field"><label>Lost Opportunities & Reasons</label><textarea id="wLost" placeholder="What didn't work and why?"></textarea></div>
                <div class="field"><label>Action Plan for Next Week</label><textarea id="wPlan" placeholder="Your strategy for next week..."></textarea></div>
              </div>
            </div>
          </div>
          <div class="form-footer">
            <span class="form-footer-note">Submit weekly report by Friday EOD</span>
            <button class="btn btn-primary" id="wodSubmitBtn" onclick="submitWOD()">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Submit Report
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- ── WOD HISTORY ── -->
    <section class="section" id="sec-wod-history">
      <div class="card">
        <div class="card-hd">
          <div><div class="card-title">WOD History</div><div class="card-sub" id="wodHistSub"></div></div>
          <div class="toolbar">
            <div class="srch"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/></svg><input type="text" placeholder="Search…" id="wodSearch" oninput="renderWODHistory()"></div>
            <select class="sel-f" id="wodExecF" onchange="renderWODHistory()" style="display:none"><option value="">All Executives</option><option>Vaibhav Borge</option><option>Saleem Khan</option><option>Roshan Chawan</option></select>
            <input type="date" id="wodDateF" class="sel-f" onchange="renderWODHistory()" title="Filter by week start date">
            <span id="wodHistCount" style="font-size:12px;color:var(--gray-400);"></span>
            <button class="btn btn-outline" onclick="exportData('wod')"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg> Export</button>
            <button class="btn btn-danger" onclick="deleteReportHistory('wod')">Delete</button>
            <button class="btn btn-secondary" onclick="triggerImportFor('crm_wod')">Import</button>
          </div>
        </div>
        <div style="overflow-x:auto"><table style="min-width:1300px;"><thead><tr><th>Week Starting</th><th>Week Ending</th><th>Sales Executive</th><th>Weekly Target (₹/Leads)</th><th>Achieved (₹/Leads)</th><th>Deals Closed (₹/Count)</th><th>Hot Leads in Pipeline</th><th>Key Wins This Week</th><th>Lost Opportunities & Reasons</th><th>Action Plan for Next Week</th></tr></thead><tbody id="wodHistBody"></tbody></table></div>
      </div>
    </section>

    <!-- ── CALL MANAGEMENT ── -->
    <section class="section" id="sec-call-form">
      <div class="form-wrap" style="max-width:1200px">
        <div class="call-forms-grid">

          <div id="incomingCallPanel" class="form-card call-panel" style="display:none">
            <div class="form-hero call-hero">
              <h2>Incoming Call Form</h2>
              <p>Customer calls FundingSathi</p>
            </div>
            <div class="form-body">
              <div class="f-section">
                <div class="f-section-title">Call Information</div>
                <div class="f-grid f3">
                  <div class="field"><label>Call Type</label><input type="text" id="incCallType" value="Incoming" readonly></div>
                  <div class="field"><label>Sales Executive <span class="req">*</span></label><input type="text" id="incExec" readonly placeholder="Assigned executive"></div>
                  <div class="field"><label>Date & Time <span class="req">*</span></label><input type="datetime-local" id="incDate" readonly style="background: var(--gray-100); cursor: not-allowed;"></div>
                </div>
                <div class="f-grid f1" style="margin-top:14px">
                  <div class="field"><label>Call Source <span class="req">*</span></label>
                    <select id="incSource" onchange="document.getElementById('incSourceCustomWrapper').style.display = this.value==='other' ? 'block' : 'none'">
                      <option value="">Select Source</option>
                      <option>Professional</option>
                      <option>DSA WhatsApp Group</option>
                      <option>DSA cold calling</option>
                      <option>Customer referral</option>
                      <option>Lender referral</option>
                      <option>Social media</option>
                      <option>Walk in DSA</option>
                      <option>Cold Calling</option>
                      <option>Referral</option>
                      <option>LinkedIn</option>
                      <option>WhatsApp</option>
                      <option>Email Campaign</option>
                      <option>Walk-in</option>
                      <option value="other">Write your own</option>
                    </select>
                    <div id="incSourceCustomWrapper" style="display:none;margin-top:8px">
                      <input type="text" id="incSourceCustom" placeholder="Write your own source">
                    </div>
                  </div>
                </div>
              </div>

              <div class="f-section">
                <div class="f-section-title">Customer Details</div>
                <div class="f-grid f3">
                  <div class="field"><label>Company Name <span class="req">*</span></label><input type="text" id="incCompany" placeholder="e.g. Tata Steel Ltd" oninput="searchCompanyByName(this.value, 'incCompanyResults')"></div>
                  <div id="incCompanyResults" class="company-results-container"></div>
                  <div class="field"><label>Contact Person</label><input type="text" id="incContact" placeholder="e.g. Rajesh Kumar"></div>
                  <div class="field"><label>Mobile Number <span class="req">*</span></label><input type="tel" id="incPhone" placeholder="e.g. 9876543210"></div>
                  <div class="field"><label>Email ID</label><input type="email" id="incEmail" placeholder="e.g. email@company.com"></div>
                  <div class="field"><label>Designation</label><input type="text" id="incDesignation" placeholder="e.g. CFO, Director"></div>
                  <div class="field"><label>City, State</label><input type="text" id="incLocation" placeholder="e.g. Mumbai, Maharashtra"></div>
                </div>
                <div class="f-grid f3" style="margin-top:14px">
                  <div class="field"><label>Industry</label>
                    <select id="incIndustry">
                      <option value="">Select Industry</option>
                      <option>Finance</option>
                      <option>Manufacturing</option>
                      <option>Technology</option>
                      <option>Healthcare</option>
                      <option>Retail</option>
                      <option>Services</option>
                      <option>Other</option>
                    </select>
                  </div>
                  <div class="field"><label>Annual Turnover</label><input type="text" id="incTurnover" placeholder="e.g. ₹ 100 Cr"></div>
                  <div class="field"></div>
                </div>
              </div>

              <div class="f-section">
                <div class="f-section-title">Call Details</div>
                <div class="f-grid f3">
                  <div class="field"><label>Purpose of Call</label>
                    <select id="incPurpose">
                      <option value="">Select Purpose</option>
                      <option>Introduction Call</option>
                      <option>Pitching Product/Service</option>
                      <option>Follow-up</option>
                      <option>Document Collection</option>
                      <option>Negotiation</option>
                      <option>Closing</option>
                    </select>
                  </div>
                  <div class="field"><label>Product Interested</label>
                    <select id="incProduct" onchange="document.getElementById('incProductCustomWrapper').style.display = this.value==='other' ? 'block' : 'none'">
                      <option value="">Select Product</option>
                      <option>Vendor Finance</option>
                      <option>Supply Chain Finance</option>
                      <option>Export Factoring</option>
                      <option>Import Finance</option>
                      <option>Working Capital</option>
                      <option>Buyer Credit</option>
                      <option value="other">Write your own</option>
                    </select>
                    <div id="incProductCustomWrapper" style="display:none;margin-top:8px">
                      <input type="text" id="incProductCustom" placeholder="Write your own product/service">
                    </div>
                  </div>
                  <div class="field"><label>Loan Requirement</label>
                    <select id="incLoanRequirement">
                      <option value="">Select Range</option>
                      <option>Up to ₹1 Cr</option>
                      <option>₹1 Cr - ₹5 Cr</option>
                      <option>₹5 Cr - ₹10 Cr</option>
                      <option>₹10 Cr+</option>
                    </select>
                  </div>
                </div>
                <div class="f-grid f3" style="margin-top:14px">
                  <div class="field"><label>Current Banker</label><input type="text" id="incCurrentBanker" placeholder="e.g. HDFC Bank"></div>
                  <div class="field"><label>Existing EMI</label><input type="text" id="incExistingEMI" placeholder="e.g. 25,000"></div>
                  <div class="field"></div>
                </div>
              </div>

              <div class="f-section">
                <div class="f-section-title">Call Outcome</div>
                <div class="f-grid">
                  <div class="field"><label>Call Outcome</label>
                    <select id="incOutcome" onchange="document.getElementById('incOutcomeCustomWrapper').style.display = this.value==='other' ? 'block' : 'none'">
                      <option value="">Select Outcome</option>
                      <option>New Enquiry</option>
                      <option>Existing Customer</option>
                      <option>Follow-up Call</option>
                      <option>Information Shared</option>
                      <option>Interested</option>
                      <option>Not Interested</option>
                      <option>Complaint/Support</option>
                      <option>Meeting Scheduled</option>
                      <option>Converted</option>
                      <option value="other">Write your own</option>
                    </select>
                    <div id="incOutcomeCustomWrapper" style="display:none;margin-top:8px">
                      <input type="text" id="incOutcomeCustom" placeholder="Write your own outcome">
                    </div>
                  </div>
                </div>
              </div>

              <div class="f-section">
                <div class="f-section-title">Next Follow-up</div>
                <div class="f-grid">
                  <div class="field"><label>Follow-up Date</label><input type="date" id="incFollowupDate"></div>
                  <div class="field"><label>Follow-up Time</label><input type="time" id="incFollowupTime"></div>
                  <div class="field"><label>Summary</label><textarea id="incSummary" placeholder="Enter call summary..."></textarea></div>
                </div>
              </div>
            </div>
            <div class="form-footer">
              <span class="form-footer-note">Required fields are marked with *</span>
              <button type="button" class="btn btn-primary" id="incSubmitBtn" onclick="submitLead('call','inc')">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <polyline points="20 6 9 17 4 12"/>
                </svg> Save Incoming Call
              </button>
            </div>
          </div>

          <div id="outgoingCallPanel" class="form-card call-panel" style="display:none">
            <div class="form-hero call-hero">
              <h2>Outgoing Call Form</h2>
              <p>Sales executive calls the lead/customer</p>
            </div>
            <div class="form-body">
              <div class="f-section">
                <div class="f-section-title">Call Information</div>
                <div class="f-grid f3">
                  <div class="field"><label>Call Type</label><input type="text" id="outCallType" value="Outgoing" readonly></div>
                  <div class="field"><label>Sales Executive <span class="req">*</span></label><input type="text" id="outExec" readonly placeholder="Assigned executive"></div>
                  <div class="field"><label>Date of Entry <span class="req">*</span></label><input type="date" id="outDate" readonly style="background: var(--gray-100); cursor: not-allowed;"></div>
                </div>
                <div class="f-grid f1" style="margin-top:14px">
                  <div class="field"><label>Lead Source <span class="req">*</span></label>
                    <select id="outSource" onchange="document.getElementById('outSourceCustomWrapper').style.display = this.value==='other' ? 'block' : 'none'">
                      <option value="">Select Lead Source</option>
                      <option>Professional</option>
                      <option>DSA WhatsApp Group</option>
                      <option>DSA cold calling</option>
                      <option>Customer referral</option>
                      <option>Lender referral</option>
                      <option>Social media</option>
                      <option>Walk in DSA</option>
                      <option>Cold Calling</option>
                      <option>Referral</option>
                      <option>LinkedIn</option>
                      <option>WhatsApp</option>
                      <option>Email Campaign</option>
                      <option>Walk-in</option>
                      <option value="other">Write your own</option>
                    </select>
                    <div id="outSourceCustomWrapper" style="display:none;margin-top:8px">
                      <input type="text" id="outSourceCustom" placeholder="Write your own source">
                    </div>
                  </div>
                </div>
              </div>

              <div class="f-section">
                <div class="f-section-title">Customer Details</div>
                <div class="f-grid f3">
                  <div class="field"><label>Company Name <span class="req">*</span></label><input type="text" id="outCompany" placeholder="e.g. Tata Steel Ltd" oninput="searchCompanyByName(this.value, 'outCompanyResults')"></div>
                  <div id="outCompanyResults" class="company-results-container"></div>
                  <div class="field"><label>Contact Person <span class="req">*</span></label><input type="text" id="outContact" placeholder="e.g. Rajesh Kumar"></div>
                  <div class="field"><label>Designation</label><input type="text" id="outDesignation" placeholder="e.g. CFO, Director"></div>
                  <div class="field"><label>Mobile Number <span class="req">*</span></label><input type="tel" id="outPhone" placeholder="e.g. 9876543210"></div>
                  <div class="field"><label>Email ID</label><input type="email" id="outEmail" placeholder="e.g. email@company.com"></div>
                  <div class="field"><label>Location (City, State)</label><input type="text" id="outLocation" placeholder="e.g. Mumbai, Maharashtra"></div>
                </div>
              </div>

              <div class="f-section">
                <div class="f-section-title">Call Details</div>
                <div class="f-grid f3">
                  <div class="field"><label>Date of First Call</label><input type="date" id="outFirstCall"></div>
                  <div class="field"><label>Purpose of Call</label>
                    <select id="outPurpose">
                      <option value="">Select Purpose</option>
                      <option>Introduction Call</option>
                      <option>Pitching Product/Service</option>
                      <option>Follow-up</option>
                      <option>Document Collection</option>
                      <option>Negotiation</option>
                      <option>Closing</option>
                    </select>
                  </div>
                  <div class="field"><label>Product/Service Discussed</label>
                    <select id="outProduct" onchange="document.getElementById('outProductCustomWrapper').style.display = this.value==='other' ? 'block' : 'none'">
                      <option value="">Select Product</option>
                      <option>Vendor Finance</option>
                      <option>Supply Chain Finance</option>
                      <option>Export Factoring</option>
                      <option>Import Finance</option>
                      <option>Working Capital</option>
                      <option>Buyer Credit</option>
                      <option value="other">Write your own</option>
                    </select>
                    <div id="outProductCustomWrapper" style="display:none;margin-top:8px">
                      <input type="text" id="outProductCustom" placeholder="Write your own product/service">
                    </div>
                  </div>
                </div>
              </div>

              <div class="f-section">
                <div class="f-section-title">Call Outcome & Status</div>
                <div class="f-grid f3">
                  <div class="field"><label>Call Outcome</label>
                    <select id="outOutcome" onchange="document.getElementById('outOutcomeCustomWrapper').style.display = this.value==='other' ? 'block' : 'none'">
                      <option value="">Select Outcome</option>
                      <option>Connected</option>
                      <option>Not Answered</option>
                      <option>Busy</option>
                      <option>Switched Off</option>
                      <option>Invalid Number</option>
                      <option>Call Back Requested</option>
                      <option>Follow-up Required</option>
                      <option>Interested</option>
                      <option>Not Interested</option>
                      <option>Meeting Scheduled</option>
                      <option value="other">Write your own</option>
                    </select>
                    <div id="outOutcomeCustomWrapper" style="display:none;margin-top:8px">
                      <input type="text" id="outOutcomeCustom" placeholder="Write your own outcome">
                    </div>
                  </div>
                  <div class="field"><label>Current Call Status</label>
                    <select id="outStatus" onchange="document.getElementById('outStatusCustomWrapper').style.display = this.value==='other' ? 'block' : 'none'">
                      <option value="">Select Status</option>
                      <option>New Lead</option>
                      <option>Proposal Shared</option>
                      <option>Negotiation</option>
                      <option>Term Sheet Issued</option>
                      <option>Documentation</option>
                      <option>Login Stage</option>
                      <option>Disbursement</option>
                      <option>Closed Won</option>
                      <option>Closed Lost</option>
                      <option>On Hold</option>
                      <option value="other">Write your own</option>
                    </select>
                    <div id="outStatusCustomWrapper" style="display:none;margin-top:8px">
                      <input type="text" id="outStatusCustom" placeholder="Write your own answer">
                    </div>
                  </div>
                </div>
              </div>

              <div class="f-section">
                <div class="f-section-title">Follow-up</div>
                <div class="f-grid">
                  <div class="field"><label>Next Follow-up Date</label><input type="date" id="outFollowupDate"></div>
                  <div class="field"><label>Next Follow-up Time</label><input type="time" id="outFollowupTime"></div>
                  <div class="field"><label>Summary</label><textarea id="outSummary" placeholder="Enter call summary..."></textarea></div>
                </div>
              </div>
            </div>
            <div class="form-footer">
              <span class="form-footer-note">Required fields are marked with *</span>
              <button type="button" class="btn btn-primary" id="outSubmitBtn">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <polyline points="20 6 9 17 4 12"/>
                </svg> Save Outgoing Call
              </button>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ── LEAD FORM (Dynamic) ── -->
    <section class="section" id="sec-lead-form">
      <style>
        :root{
          --bg:#F6F7F9; --surface:#FFFFFF; --surface-2:#F1F3F6;
          --border:#E5E8EC; --border-strong:#D6DAE1;
          --text-primary:#151922; --text-secondary:#5B6472; --text-muted:#8A93A3;
          --accent:#2F5DE8; --accent-light:#EAF0FE; --accent-dark:#1E3FA8;
          --success:#127A57; --success-bg:#E3F5EC;
          --warning:#9A6300; --warning-bg:#FDF1DC;
          --danger:#B3261E; --danger-bg:#FBEAE9;
          --radius:8px; --radius-lg:12px;
        }
        .wrap{max-width:900px; margin:0 auto; padding:28px 20px 80px;}
        .header{background:linear-gradient(135deg,#7A1F1F,#5C1414); border-radius:var(--radius-lg); padding:26px 28px; color:#fff; margin-bottom:20px; display:grid; gap:12px;}
        .header h1{font-size:22px; font-weight:700; margin-bottom:6px;}
        .header p{font-size:14px; opacity:0.88; line-height:1.5;}
        .header .pill{display:inline-flex; align-items:center; gap:8px; background:rgba(255,255,255,0.18); border-radius:999px; padding:10px 16px; font-size:13px; margin-top:8px;}
        .header .pill.active-mode{background:rgba(255,255,255,0.18); color:#fff;}
        .header .pill.user-pill{background:rgba(255,255,255,0.15); color:#fff;}
        .card{background:var(--surface); border:1px solid rgba(96,110,141,0.12); border-radius:var(--radius-lg); padding:22px 24px; margin-bottom:20px; box-shadow:0 10px 30px rgba(15,18,25,0.04);}
        .section-label{font-size:11.5px; font-weight:600; text-transform:uppercase; letter-spacing:0.04em; color:var(--accent-dark); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid rgba(47,93,232,0.12);}
        .form-grid{display:grid; grid-template-columns:1fr 1fr; gap:18px 22px;}
        .form-grid.cols-3{grid-template-columns:1fr 1fr 1fr;}
        .field{display:flex; flex-direction:column; gap:8px;}
        .field.full{grid-column:1/-1;}
        label{font-size:13px; font-weight:600; color:var(--text-primary);}
        label .req{color:var(--danger);}
        label .hint{font-weight:400; color:var(--text-muted); font-size:11.5px;}
        input, select, textarea{
          border:1px solid rgba(96,110,141,0.12); border-radius:14px; padding:13px 14px;
          font-size:14px; font-family:inherit; color:var(--text-primary); background:#FBFCFE; width:100%; min-height:46px;
        }
        input:focus, select:focus, textarea:focus{outline:none; border-color:var(--accent); box-shadow:0 0 0 4px rgba(47,93,232,0.12);}
        textarea{resize:vertical; min-height:82px;}
        ::placeholder{color:var(--text-muted);}
        .vertical-select-card{background:#F6F8FF; border:1px dashed rgba(47,93,232,0.35);}
        .vertical-select-card .form-grid{grid-template-columns:1fr 1fr;}
        .lookup-header-bar{display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid rgba(96,110,141,0.12);}
        .mode-badge{font-size:12px; padding:6px 12px; border-radius:999px; font-weight:700; background:var(--accent-light); color:var(--accent-dark);}
        .btn-row{display:flex; justify-content:flex-end; gap:12px; margin-top:24px;}
        .btn{border:1px solid rgba(96,110,141,0.16); background:#fff; border-radius:999px; padding:11px 22px; font-size:14px; font-weight:600; cursor:pointer; transition:all .18s ease;}
        .btn:hover{background:rgba(47,93,232,0.06);}
        .btn-primary{background:var(--accent); border-color:var(--accent); color:#fff; box-shadow:0 12px 24px rgba(47,93,232,0.18);}
        .btn-primary:hover{background:var(--accent-dark);}
        .icon{width:16px; height:16px; stroke:currentColor; stroke-width:2; fill:none; stroke-linecap:round; stroke-linejoin:round;}
        .empty-state{text-align:center; padding:50px 20px; color:var(--text-muted);}
        .overlay{
          display:none; position:fixed; inset:0; background:rgba(15,18,25,0.55);
          align-items:flex-start; justify-content:center; z-index:100; padding:40px 16px; overflow-y:auto;
        }
        .overlay.show{display:flex;}
        .modal{background:var(--surface); border-radius:var(--radius-lg); max-width:640px; width:100%; padding:0; overflow:hidden;}
        .modal-head{background:linear-gradient(135deg,#7A1F1F,#5C1414); color:#fff; padding:18px 24px; display:flex; justify-content:space-between; align-items:center;}
        .modal-head h3{font-size:16px; font-weight:600;}
        .modal-head p{font-size:12px; opacity:0.85; margin-top:2px;}
        .modal-close{background:rgba(255,255,255,0.15); border:none; color:#fff; width:28px; height:28px; border-radius:50%; cursor:pointer; font-size:15px; line-height:1;}
        .modal-body{padding:18px 24px 24px; max-height:65vh; overflow-y:auto;}
        .match-summary{display:flex; gap:10px; margin-bottom:16px;}
        .match-chip{flex:1; text-align:center; padding:8px; border-radius:var(--radius); font-size:12px; font-weight:600;}
        .lender-result{border:1px solid var(--border); border-radius:var(--radius); padding:12px 14px; margin-bottom:10px;}
        .lender-result.eligible{border-left:3px solid var(--success);}
        .lender-result.review{border-left:3px solid var(--warning);}
        .lender-result.reject{border-left:3px solid var(--danger); opacity:0.85;}
        .lender-result-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;}
        .lender-name{font-weight:600; font-size:13.5px;}
        .lender-product{font-size:11.5px; color:var(--text-muted);}
        .reason-list{font-size:12px; color:var(--text-secondary); margin:0; padding-left:16px;}
        .reason-list li{margin-bottom:2px;}
        .reason-list li.bad{color:var(--danger);}
        .reason-list li.good{color:var(--success);}
        .no-match-note{text-align:center; padding:24px; color:var(--text-muted); font-size:13px;}
        .company-results-container{margin-top:8px; max-height:300px; overflow-y:auto; border:1px solid var(--border); border-radius:var(--radius); background:var(--surface); display:none;}
        .company-results-container.show{display:block;}
        .company-result-item{padding:12px 14px; border-bottom:1px solid var(--border); transition:background .15s ease;}
        .company-result-item:hover{background:var(--surface-2);}
        .company-result-item:last-child{border-bottom:none;}
        .company-result-header{cursor:pointer; margin-bottom:8px;}
        .company-result-name{font-weight:600; font-size:13px; color:var(--text-primary); margin-bottom:4px;}
        .company-result-details{font-size:12px; color:var(--text-secondary); display:flex; gap:12px; flex-wrap:wrap;}
        .company-result-detail-item{display:flex; align-items:center; gap:4px;}
        .company-result-actions{display:flex; justify-content:flex-end; gap:8px; padding-top:8px; border-top:1px solid rgba(96,110,141,0.08); margin-top:8px;}
        .interested-btn{background:#10B981; color:#fff; border:none; border-radius:6px; padding:6px 12px; font-size:11px; font-weight:600; cursor:pointer; transition:background .15s ease;}
        .interested-btn:hover{background:#059669;}
        .takeover-btn{background:var(--accent); color:#fff; border:none; border-radius:6px; padding:6px 12px; font-size:11px; font-weight:600; cursor:pointer; transition:background .15s ease;}
        .takeover-btn:hover{background:var(--accent-dark);}
        .takeover-modal{display:none; position:fixed; inset:0; background:rgba(15,18,25,0.55); align-items:center; justify-content:center; z-index:100; padding:20px;}
        .takeover-modal.show{display:flex;}
        .takeover-modal-content{background:var(--surface); border-radius:var(--radius-lg); max-width:500px; width:100%; padding:0; overflow:hidden;}
        .takeover-modal-header{background:linear-gradient(135deg,#7A1F1F,#5C1414); color:#fff; padding:18px 24px; display:flex; justify-content:space-between; align-items:center;}
        .takeover-modal-header h3{font-size:16px; font-weight:600; margin:0;}
        .takeover-modal-close{background:rgba(255,255,255,0.15); border:none; color:#fff; width:28px; height:28px; border-radius:50%; cursor:pointer; font-size:15px; line-height:1;}
        .takeover-modal-body{padding:20px 24px 24px;}
        .takeover-field{margin-bottom:16px;}
        .takeover-field label{display:block; font-size:13px; font-weight:600; color:var(--text-primary); margin-bottom:6px;}
        .takeover-field textarea{width:100%; min-height:80px; border:1px solid var(--border); border-radius:8px; padding:10px; font-size:14px; resize:vertical;}
        .takeover-field textarea:focus{outline:none; border-color:var(--accent); box-shadow:0 0 0 3px rgba(47,93,232,0.12);}
        .takeover-select{width:100%; border:1px solid var(--border); border-radius:8px; padding:10px; font-size:14px; background:var(--surface); color:var(--text-primary); cursor:pointer;}
        .takeover-select:focus{outline:none; border-color:var(--accent); box-shadow:0 0 0 3px rgba(47,93,232,0.12);}
        .takeover-actions{display:flex; justify-content:flex-end; gap:10px; margin-top:20px;}
        .takeover-btn-cancel{background:var(--surface-2); color:var(--text-primary); border:1px solid var(--border); border-radius:6px; padding:8px 16px; font-size:13px; font-weight:600; cursor:pointer; transition:background .15s ease;}
        .takeover-btn-cancel:hover{background:var(--border);}
        .takeover-btn-submit{background:var(--accent); color:#fff; border:none; border-radius:6px; padding:8px 16px; font-size:13px; font-weight:600; cursor:pointer; transition:background .15s ease;}
        .takeover-btn-submit:hover{background:var(--accent-dark);}
        .interested-modal{display:none; position:fixed; inset:0; background:rgba(15,18,25,0.55); align-items:center; justify-content:center; z-index:100; padding:20px;}
        .interested-modal.show{display:flex;}
        .interested-modal-content{background:var(--surface); border-radius:var(--radius-lg); max-width:500px; width:100%; padding:0; overflow:hidden;}
        .interested-modal-header{background:linear-gradient(135deg,#10B981,#059669); color:#fff; padding:18px 24px; display:flex; justify-content:space-between; align-items:center;}
        .interested-modal-header h3{font-size:16px; font-weight:600; margin:0;}
        .interested-modal-close{background:rgba(255,255,255,0.15); border:none; color:#fff; width:28px; height:28px; border-radius:50%; cursor:pointer; font-size:15px; line-height:1;}
        .interested-modal-body{padding:20px 24px 24px;}
        .interested-field{margin-bottom:16px;}
        .interested-field label{display:block; font-size:13px; font-weight:600; color:var(--text-primary); margin-bottom:6px;}
        .interested-field textarea{width:100%; min-height:80px; border:1px solid var(--border); border-radius:8px; padding:10px; font-size:14px; resize:vertical;}
        .interested-field textarea:focus{outline:none; border-color:#10B981; box-shadow:0 0 0 3px rgba(16,185,129,0.12);}
        .interested-actions{display:flex; justify-content:flex-end; gap:10px; margin-top:20px;}
        .interested-btn-cancel{background:var(--surface-2); color:var(--text-primary); border:1px solid var(--border); border-radius:6px; padding:8px 16px; font-size:13px; font-weight:600; cursor:pointer; transition:background .15s ease;}
        .interested-btn-cancel:hover{background:var(--border);}
        .interested-btn-submit{background:#10B981; color:#fff; border:none; border-radius:6px; padding:8px 16px; font-size:13px; font-weight:600; cursor:pointer; transition:background .15s ease;}
        .interested-btn-submit:hover{background:#059669;}
      </style>
      <div class="wrap" id="leadFormContainer">
        <div class="header">
          <div>
            <h1>Create New Lead</h1>
            <p>Vertical aur sub-product select karte hi uska specific form aayega.</p>
          </div>
          <div class="pill user-pill" id="dynamicLeadUser">👤 —</div>
        </div>
        <div id="leadPermissionBannerHolder" style="display:none; margin-bottom:16px;"></div>

        <!-- STEP 1: VERTICAL + SUB-PRODUCT -->
        <div class="card vertical-select-card">
          <div class="section-label">Step 1 — Vertical &amp; Sub-Product</div>
          <div class="form-grid">
            <div class="field">
              <label>Business Vertical <span class="req">*</span></label>
              <select id="verticalSelect" onchange="onVerticalChange()">
                <option value="">Select vertical</option>
                <option value="itf">A. International Trade Finance</option>
                <option value="scf">B. Supply Chain Finance</option>
                <option value="pc">C. Private Credit</option>
              </select>
            </div>
            <div class="field">
              <label>Sub-Product <span class="req">*</span></label>
              <select id="subProductSelect" onchange="renderForm()" disabled>
                <option value="">Select vertical first</option>
              </select>
            </div>
          </div>
        </div>

        <!-- STEP 2: COMMON LEAD INFO -->
        <div class="card">
          <div class="lookup-header-bar">
            <div class="section-label" style="margin:0; padding:0; border:none;">Step 2 — Lead Information (Common)</div>
            <span class="mode-badge active" id="dynamicActiveMode">Active Mode</span>
          </div>
          <div class="form-grid">
            <div class="field"><label>Sales Executive <span class="req">*</span></label><input type="text" id="ldExec" readonly style="background: var(--gray-100); cursor: not-allowed;"></div>
            <div class="field"><label>Date of Entry <span class="req">*</span></label><input type="date" id="ldDate"></div>
            <div class="field"><label>Lead Source</label><select id="ldSource"><option>Select</option><option>Website</option><option>Referral</option><option>Direct Call</option><option>WhatsApp</option><option>Professional</option><option>DSA WhatsApp Group</option><option>DSA cold calling</option><option>Customer cold calling</option><option>Customer referral</option><option>Lender referral</option><option>Social media</option><option>Walk in DSA</option><option>Cold Calling</option><option>Email Campaign</option><option>Walk-in</option></select></div>
            <div class="field"><label>Customer Company Name <span class="req">*</span> <span class="hint">(type to check Call Management)</span></label><input type="text" id="ldCompany" placeholder="e.g. Tata Steel Ltd" oninput="searchCompanyByName(this.value, 'ldCompanyResults')"></div>
            <div id="ldCompanyResults" class="company-results-container"></div>
            <div class="field"><label>Contact Person Name <span class="req">*</span></label><input type="text" id="ldContact" placeholder="e.g. Rajesh Kumar"></div>
            <div class="field"><label>Designation</label><input type="text" id="ldDesignation" placeholder="e.g. CFO, Treasury Head"></div>
            <div class="field"><label>Contact Number <span class="req">*</span></label><input type="tel" id="ldPhone" placeholder="e.g. 9876543210"></div>
            <div class="field"><label>Email ID</label><input type="email" id="ldEmail" placeholder="email@company.com"></div>
            <div class="field"><label>Location (City, State)</label><input type="text" id="ldLocation" placeholder="e.g. Mumbai, Maharashtra"></div>
            <div class="field"><label>Annual Turnover</label><input id="turnoverInput" placeholder="e.g. 50 (in ₹ Crore)"></div>
            <div class="field"><label>Business Vintage</label><input id="vintageInput" placeholder="e.g. 5 (in years)"></div>
            <div class="field"><label>Approx. Funding Amount Required <span class="req">*</span> <span class="hint">(₹ Crore)</span></label><input id="amountInput" type="number" step="0.01" placeholder="e.g. 2.5"></div>
            <div class="field"><label>Constitution</label><select id="ldEntityType"><option>Select</option><option>Proprietorship</option><option>Partnership</option><option>LLP</option><option>Private Limited</option><option>Public Limited</option></select></div>
          </div>
          <div id="lookupResultContainer"></div>
        </div>

        <!-- STEP 2B: INDUSTRY & CREDIT PROFILE -->
        <div class="card" style="border-color:#A9C0F5;">
          <div class="section-label">Step 2B — Industry &amp; Credit Profile <span style="color:var(--accent); text-transform:none; font-weight:500;">(added — needed to screen against lender preferred/negative industry &amp; risk lists)</span></div>
          <div class="form-grid">
            <div class="field">
              <label>Industry / Sector <span class="req">*</span></label>
              <select id="industryInput">
                <option value="">Select industry</option>
                <option>Manufacturing</option>
                <option>Trading</option>
                <option>Services</option>
                <option>Pharma & Chemicals</option>
                <option>Agri & Food Processing</option>
                <option>IT / ITES</option>
                <option>D2C / E-commerce</option>
                <option>Healthcare</option>
                <option>Logistics</option>
                <option>Retail</option>
                <option>Energy</option>
                <option>Real Estate / Infra / Construction</option>
                <option>Gems & Jewellery</option>
                <option>Capital Market</option>
                <option>Mining / Quarrying</option>
                <option>Other (specify in remarks)</option>
              </select>
            </div>
            <div class="field"><label>Company Credit Rating / CMR Score</label><input id="ldCreditRating" placeholder="e.g. BBB+ or CMR-3"></div>
            <div class="field"><label>Promoter's Individual CIBIL Score</label><input id="cibilInput" placeholder="e.g. 720 (separate from company score)"></div>
            <div class="field"><label>Any NPA / 30+ or 60+ DPD History?</label><select id="npaHistory"><option>Select</option><option>No — Clean track record</option><option>Yes — SMA1/SMA2</option><option>Yes — NPA / Written-off</option></select></div>
            <div class="field"><label>Existing Banking Relationships / Lenders</label><input id="ldLenderRelatedDetail" placeholder="e.g. HDFC CC limit ₹5Cr, ICICI TL ₹3Cr"></div>
            <div class="field"><label>Guarantee Available</label><select id="guaranteeType"><option>Select</option><option>Personal Guarantee (Promoter)</option><option>Corporate Guarantee</option><option>Both PG + CG</option><option>FLDG (Anchor-backed)</option><option>None available</option></select></div>
            <div class="field"><label>Current Ratio <span class="hint">(if available)</span></label><input id="currentRatio" placeholder="e.g. 1.3"></div>
            <div class="field"><label>Interest Coverage Ratio <span class="hint">(if available)</span></label><input id="interestCoverageRatio" placeholder="e.g. 1.8"></div>
            <div class="field"><label>DSCR <span class="hint">(if available)</span></label><input id="dscr" placeholder="e.g. 1.25"></div>
          </div>
        </div>

        <!-- STEP 3: DYNAMIC SUB-PRODUCT FORM -->
        <div id="dynamicFormContainer"></div>

        <!-- STEP 4: LEAD QUALIFICATION -->
        <div class="dynamic-card" id="leadQualificationSection" style="display:none;">
          <div class="dynamic-section-label">Step 4 — Lead Qualification</div>
          <div class="dynamic-form-grid">
            <div class="dynamic-field"><label>Expected Follow-up Date</label><input type="date" id="ldFirstCall"></div>
            <div class="dynamic-field"><label>Lead Stage</label><select id="ldPurpose" onchange="updateLeadStatusOptions()"><option>Select Stage</option><option>New Lead</option><option>Product Exploration</option><option>Commercial Fit</option><option>Basic Financial Document</option><option>Login with Lender</option><option>Login Docs Submitted</option><option>Approved Limit</option><option>Sanction Docs</option><option>Pre-Disbursement</option><option>Disbursement</option><option>Payout Received</option><option>Closed Won</option><option>Closed Lost</option></select></div>
            <div class="dynamic-field"><label>Current Lead Status</label><select id="ldStatus"><option value="">Select Status</option></select></div>
            <div class="dynamic-field"><label>Last Activity</label><input type="date" id="ldLastActivity"></div>
            <div class="dynamic-field full"><label>Remarks</label><textarea id="ldRemarks" placeholder="Enter lead remarks..."></textarea></div>
          </div>
        </div>

        <!-- STEP 5: FOLLOW-UP SCHEDULING -->
        <div class="dynamic-card" id="followupSchedulingSection" style="display:none;">
          <div class="dynamic-section-label">Step 5 — Schedule Next Follow-up</div>
          <div class="dynamic-form-grid">
            <div class="dynamic-field"><label>Follow-up Date *</label><input type="date" id="followupDate"></div>
            <div class="dynamic-field"><label>Follow-up Time *</label><input type="time" id="followupTime"></div>
            <div class="dynamic-field"><label>Follow-up Type</label><select id="followupType"><option value="">Select Type</option><option>Phone Call</option><option>Email</option><option>Meeting</option><option>Site Visit</option><option>WhatsApp</option><option>Other</option></select></div>
            <div class="dynamic-field full"><label>Follow-up Note</label><textarea id="followupNote" placeholder="Add notes about this follow-up..." style="min-height:80px;"></textarea></div>
          </div>
        </div>

        <!-- SUBMIT BUTTONS -->
        <div class="btn-row" id="dynamicSubmitButtons" style="display:none;">
          <button class="btn" style="border-color:var(--accent); color:var(--accent-dark);" onclick="suggestLenders()">🔍 Suggest Lenders</button>
          <button class="btn">Save as Draft</button>
          <button class="btn btn-primary" id="ldSubmitBtn" onclick="submitLead('lead')">Create Lead</button>
        </div>
      </div>

      <!-- SUGGEST LENDERS POPUP -->
      <div class="overlay" id="lenderOverlay">
        <div class="modal">
          <div class="modal-head">
            <div>
              <h3>Suggested Lenders</h3>
              <p id="modalSubtitle">Matched against turnover, vintage, industry &amp; credit profile</p>
            </div>
            <button class="modal-close" onclick="closeSuggestedLendersModal()">✕</button>
          </div>
          <div class="modal-body" id="lenderModalBody"></div>
        </div>
      </div>
    </section>

    <!-- ── LEADS JOURNEY ── -->
    <section class="section" id="sec-leads">
      <div class="card" style="margin-bottom:16px">
        <div class="card-hd">
          <div><div class="card-title" id="leadsTitle">My Leads</div><div class="card-sub" id="leadsSub">Your personal lead entries</div></div>
          <div class="toolbar">
            <div class="srch"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/></svg><input type="text" placeholder="Search company, contact…" id="leadSearch" oninput="renderLeads()" aria-label="Search leads by company or contact"></div>
            <select class="sel-f" id="leadExecF" onchange="renderLeads()" style="display:none" aria-label="Filter leads by executive"><option value="">All Executives</option><option>Vaibhav Borge</option><option>Saleem Khan</option><option>Roshan Chawan</option></select>
            <select class="sel-f" id="leadStatusF" onchange="renderLeads()" aria-label="Filter leads by status"><option value="">All Statuses</option><option>New Lead</option><option>Contacted</option><option>Proposal Shared</option><option>Term Sheet Issued</option><option>Documentation</option><option>Disbursement</option><option>Closed Won</option><option>Closed Lost</option></select>
            <input type="date" id="leadDate" class="sel-f" onchange="renderLeads()" title="Filter by date" aria-label="Filter leads by date">
            <span id="leadsCount" style="font-size:12px;color:var(--gray-400);" aria-live="polite"></span>
            <button class="btn btn-outline" type="button" onclick="openImportCSVModal()" aria-label="Import leads from CSV"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg> Import CSV</button>
            <button class="btn btn-outline" type="button" onclick="exportData('leads')" aria-label="Export leads to CSV"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg> Export</button>
          </div>
        </div>
        <div style="overflow-x:auto"><table><caption class="visually-hidden">Lead journey entries with contact and status details</caption><thead><tr><th scope="col">Date</th><th scope="col">Executive</th><th scope="col">Company</th><th scope="col">Contact</th><th scope="col">Designation</th><th scope="col">Email ID</th><th scope="col">Location</th><th scope="col">Product</th><th scope="col">Credit Rating</th><th scope="col">Rating Agency</th><th scope="col">Rating Date</th><th scope="col">Lender Detail</th><th scope="col">Source</th><th scope="col">Status</th><th scope="col">Lead Stage</th><th scope="col">Follow-up</th><th scope="col">Last Activity</th><th scope="col">Deal Value</th><th scope="col" style="text-align:right;">Ageing</th><th scope="col" style="text-align:center;">Action</th></tr></thead><tbody id="leadsBody"></tbody></table></div>
      </div>
    </section>

    <!-- ── MULTI-LENDER CASE MANAGEMENT ── -->
    <section class="section" id="sec-case-management">
      <div class="card" style="margin-bottom:16px;">
        <div class="card-hd">
          <div><div class="card-title">Multi-Lender Case Management</div><div class="card-sub">Track lender-specific applications, query logs, and payout status per lead.</div></div>
          <div class="toolbar">
            <div class="srch"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/></svg><input type="text" placeholder="Search lenders, status, product…" id="caseSearch" oninput="renderLoanApplicationsTable()"></div>
            <button class="btn btn-primary" onclick="openLenderRequirementsModal(currentCaseLeadId)">+ Suggest Lenders</button>
            <button class="btn btn-outline" onclick="openLenderRequirementsModal(currentCaseLeadId)">Suggest Lenders</button>
            <button class="btn btn-outline" onclick="triggerLenderImport()">Import</button>
            <button class="btn btn-outline" onclick="clearLenderApplications()">Clear Lenders</button>
            <button class="btn btn-outline" onclick="refreshCaseManagement()">Refresh</button>
          </div>
          <input id="caseLenderImportInput" type="file" accept=".json,.csv" style="display:none" onchange="handleLenderImport(event)" />
        </div>
        <div style="padding:20px 24px;">
          <div id="caseLeadSummary" style="margin-bottom:16px;font-size:14px;color:var(--gray-700);">Open a lead from Lead Journey to manage lender cases.</div>
          <div id="caseSummary" style="display:flex;gap:16px;flex-wrap:wrap;margin-bottom:16px;"></div>
          <div id="caseApplicationsTableContainer" style="overflow-x:auto;"></div>
        </div>
      </div>
      <div class="card" id="caseApplicationForm" style="display:none;max-width:960px;margin-top:16px;">
        <div class="card-hd"><div><div class="card-title">New Lender Application</div><div class="card-sub">Create a lender-specific application for the selected lead.</div></div></div>
        <div style="padding:20px 24px;">
          <div class="f-grid f3">
            <div class="field"><label>Application ID</label><input type="text" id="caseApplicationId" readonly placeholder="Auto-generated" /></div>
            <div class="field"><label>Parent Lead ID</label><input type="text" id="caseParentLeadId" readonly placeholder="Select a lead first" /></div>
            <div class="field"><label>Lender Name <span class="req">*</span></label><input type="text" id="caseLender" placeholder="e.g. SBI" /></div>
          </div>
          <div class="f-grid f3" style="margin-top:14px;">
            <div class="field"><label>Product Type</label><input type="text" id="caseProduct" placeholder="e.g. Working Capital" /></div>
            <div class="field"><label>Applied Loan Amount</label><input type="number" id="caseLoanAmount" placeholder="Amount" /></div>
            <div class="field"><label>Application Status</label><select id="caseStatus"><option value="Proposal Shared">Proposal Shared</option><option value="Documentation">Documentation</option><option value="Negotiation">Negotiation</option><option value="Processing">Processing</option><option value="Sanctioned">Sanctioned</option><option value="Disbursed">Disbursed</option><option value="Rejected">Rejected</option></select></div>
          </div>
          <div class="f-grid f3" style="margin-top:14px;">
            <div class="field"><label>Contacted Person Name</label><input type="text" id="caseContactPerson" placeholder="Contact name" /></div>
            <div class="field"><label>Mob No</label><input type="text" id="caseContactMobile" placeholder="Mobile number" /></div>
            <div class="field"><label>LinkedIn URL</label><input type="url" id="caseLinkedInUrl" placeholder="https://linkedin.com/..." /></div>
          </div>
          <div class="f-grid f3" style="margin-top:14px;">
            <div class="field"><label>Outcome of Call</label><input type="text" id="caseCallOutcome" placeholder="Call outcome" /></div>
            <div class="field"><label>Lender Onboarding Form</label><select id="caseOnboardingForm"><option value="No">No</option><option value="Yes">Yes</option></select></div>
            <div class="field"><label>Contact Status</label><input type="text" id="caseContactStatus" placeholder="Contact status" /></div>
          </div>
          <div class="f-grid f3" style="margin-top:14px;">
            <div class="field"><label>Bank Login Date</label><input type="date" id="caseBankLoginDate" /></div>
            <div class="field"><label>Bank Reference Number</label><input type="text" id="caseBankRef" placeholder="Bank reference" /></div>
            <div class="field"><label>Sanction Date</label><input type="date" id="caseSanctionDate" /></div>
          </div>
          <div class="f-grid f3" style="margin-top:14px;">
            <div class="field"><label>Interest Rate (%)</label><input type="number" id="caseInterestRate" step="0.01" placeholder="e.g. 13.5" /></div>
            <div class="field"><label>Tenure (months)</label><input type="number" id="caseTenor" placeholder="e.g. 24" /></div>
            <div class="field"><label>EMI Amount</label><input type="number" id="caseEMIAmount" placeholder="Auto or manual" /></div>
          </div>
          <div class="f-grid f3" style="margin-top:14px;">
            <div class="field"><label>Disbursal Amount</label><input type="number" id="caseDisbursalAmount" placeholder="Disbursed amount" /></div>
            <div class="field"><label>Disbursal Date</label><input type="date" id="caseDisbursalDate" /></div>
            <div class="field"><label>Expected Payout %</label><input type="number" id="caseExpectedPayoutPercent" step="0.01" placeholder="e.g. 1.5" /></div>
          </div>
          <div class="f-grid f3" style="margin-top:14px;">
            <div class="field"><label>Actual Payout Received</label><input type="number" id="caseActualPayoutReceived" placeholder="Received payout" /></div>
            <div class="field"><label>Payout Date</label><input type="date" id="casePayoutDate" /></div>
            <div class="field"><label>TAT Tracker</label><input type="text" id="caseTATTracker" placeholder="e.g. 7d SLA" /></div>
          </div>
          <div class="f-grid" style="margin-top:14px;">
            <div class="field" style="flex:1 1 100%;"><label>Rejection Reason</label><input type="text" id="caseRejectionReason" placeholder="If rejected" /></div>
          </div>
          <div class="field" style="margin-top:14px;"><label>Remarks</label><textarea id="caseRemarks" placeholder="Key notes or lender requirements"></textarea></div>
          <div class="form-footer" style="padding:0;margin-top:16px;display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap;">
            <button class="btn btn-primary" onclick="addLoanApplication()">Save Application</button>
            <button class="btn btn-outline" onclick="hideCaseApplicationForm()">Cancel</button>
          </div>
        </div>
      </div>
    </section>

    <!-- ── LENDER QUERY MODAL ── -->
    <div class="modal-ov" id="queryModal">
      <div class="modal" style="max-width:600px;">
        <div class="modal-hd">
          <div class="modal-hd-left">
            <div class="modal-icon" style="background: #8b2d3b; color: white; border-radius: 8px;">
              <svg width="18" height="18" fill="currentColor" stroke="none" viewBox="0 0 24 24"><path d="M3 3h18v18H3z"/><path d="M3 9h18"/><path d="M10 17h4"/></svg>
            </div>
            <div>
              <div class="modal-title">Add Lender Query</div>
              <div class="modal-sub">Log a new query or update for the selected lender case</div>
            </div>
          </div>
          <button class="modal-close" onclick="closeQueryModal()"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg></button>
        </div>
        <div class="modal-body" style="padding: 24px;">
          <!-- Query Description -->
          <div class="f-grid f1" style="margin-bottom: 20px;">
            <div class="field">
              <label style="font-weight: 600; color: #374151; margin-bottom: 8px; display: block;">Query / Update <span class="req" style="color: #ef4444;">*</span></label>
              <textarea id="queryDescription" placeholder="Describe the lender query or update" rows="4" style="width: 100%; padding: 12px; border: 1px solid #e5e7eb; border-radius: 6px; font-family: inherit; font-size: 13px; resize: vertical;"></textarea>
            </div>
          </div>

          <!-- Status and Priority Row -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
            <div class="field">
              <label style="font-weight: 600; color: #374151; margin-bottom: 8px; display: block;">Status</label>
              <select id="queryStatus" style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 13px; background: white; cursor: pointer;">
                <option>Open</option>
                <option>Resolved</option>
                <option>Closed</option>
                <option>In Progress</option>
              </select>
            </div>
            <div class="field">
              <label style="font-weight: 600; color: #374151; margin-bottom: 8px; display: block;">Priority</label>
              <select id="queryPriority" style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 13px; background: white; cursor: pointer;">
                <option>Normal</option>
                <option>High</option>
                <option>Urgent</option>
                <option>Low</option>
              </select>
            </div>
          </div>

          <!-- Assigned To -->
          <div class="field" style="margin-bottom: 20px;">
            <label style="font-weight: 600; color: #374151; margin-bottom: 8px; display: block;">Assigned To</label>
            <input type="text" id="queryAssignedHandler" placeholder="Search or select handler name" style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 13px;" />
          </div>

          <!-- Required Documents -->
          <div class="field" style="margin-bottom: 24px;">
            <label style="font-weight: 600; color: #374151; margin-bottom: 8px; display: block;">Required Documents</label>
            <input type="text" id="queryRequiredDocs" placeholder="Comma-separated docs (e.g., Balance Sheet, Bank Statements, PAN)" style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 13px;" />
            <div style="font-size: 11px; color: #6b7280; margin-top: 6px;">Enter document names separated by commas</div>
          </div>

          <input type="hidden" id="queryApplicationId" />

          <!-- Form Footer -->
          <div style="display: flex; gap: 12px; justify-content: flex-end; padding-top: 16px; border-top: 1px solid #e5e7eb;">
            <button class="btn btn-outline" onclick="closeQueryModal()" style="padding: 10px 20px; border-radius: 6px;">Cancel</button>
            <button class="btn btn-primary" onclick="submitLenderQueryForm()" style="padding: 10px 20px; border-radius: 6px; background: #8b2d3b; color: white; border: none; font-weight: 600; cursor: pointer;">Save Query</button>
          </div>
        </div>
      </div>
    </div>

    <!-- ── LENDERS ── -->
    <section class="section" id="sec-lender-products">
      <div style="margin-bottom:24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;">
        <div><div class="card-title" style="margin-bottom:4px;">Lenders</div><div class="card-sub">Manage all lending institutions and their details</div></div>
        <button type="button" class="btn btn-primary" onclick="console.log('Add button clicked'); openLenderModal()" style="white-space:nowrap;">+ Add New Lender</button>
      </div>

      <!-- Filters -->
      <div style="background:white;border:1px solid var(--gray-200);border-radius:12px;padding:16px;margin-bottom:20px;">
        <div style="display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;">
          <div class="srch">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/></svg>
            <input id="lenderSearch" type="text" placeholder="Search by lender name..." style="border:none;background:transparent;outline:none;flex:1;font-size:13px;" onkeyup="filterLenders()">
          </div>
          <button type="button" class="btn btn-outline" onclick="console.log('Refresh button clicked'); loadLenders()" style="white-space:nowrap;padding:8px 16px;">Refresh</button>
        </div>
      </div>

      <!-- Loading State -->
      <div id="lendersLoading" style="text-align:center;padding:40px;color:var(--gray-500);">
        <div style="margin-bottom:12px;">Loading lenders...</div>
      </div>

      <!-- Error State -->
      <div id="lendersError" style="display:none;background:#fee2e2;color:#991b1b;padding:15px;border-radius:8px;margin-bottom:20px;"></div>

      <!-- Lenders Grid -->
      <div id="lendersContainer" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(400px,1fr));gap:20px;"></div>
    </section>

    <!-- ── MEETINGS MANAGEMENT ── -->
    <section class="section" id="sec-meetings">
      <div style="margin-bottom:24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;">
        <div><div class="card-title" style="margin-bottom:4px;">Meetings Management</div><div class="card-sub">Manage client, lender, and internal meetings with full integration</div></div>
        <button class="btn btn-primary" onclick="openMeetingForm()" style="white-space:nowrap;">+ Add Event</button>
      </div>

      <!-- KPI Cards -->
      <div id="meetingKPICards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:24px;"></div>

      <!-- Toolbar -->
      <div style="background:white;border:1px solid var(--gray-200);border-radius:12px;padding:16px;margin-bottom:20px;">
        <div style="display:grid;grid-template-columns:1fr auto auto auto;gap:12px;align-items:center;">
          <div class="srch">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/></svg>
            <input id="meetingSearch" type="text" placeholder="Search meetings, clients, lenders, cases..." style="border:none;background:transparent;outline:none;flex:1;font-size:13px;" oninput="updateMeetingFilter('search', this.value)">
          </div>
          <select id="meetingStatusFilter" class="sel-f" onchange="updateMeetingFilter('status', this.value)">
            <option value="all">All Status</option>
            <option value="scheduled">Scheduled</option>
            <option value="confirmed">Confirmed</option>
            <option value="completed">Completed</option>
            <option value="cancelled">Cancelled</option>
          </select>
          <select id="meetingTypeFilter" class="sel-f" onchange="updateMeetingFilter('type', this.value)">
            <option value="all">All Types</option>
            <option value="Client Meeting">Client Meeting</option>
            <option value="Lender Meeting">Lender Meeting</option>
            <option value="Internal Meeting">Internal Meeting</option>
            <option value="Negotiation">Negotiation</option>
            <option value="Follow-up">Follow-up</option>
          </select>
          <button class="btn btn-outline" onclick="renderMeetingsDashboard()" style="white-space:nowrap;padding:8px 16px;">Refresh</button>
        </div>
      </div>

      <!-- Calendar View -->
      <div style="background:white;border:1px solid var(--gray-200);border-radius:12px;padding:16px;margin-bottom:20px;">
        <div id="meetingsCalendarContainer"></div>
      </div>

      <!-- Meetings Table -->
      <div style="background:white;border:1px solid var(--gray-200);border-radius:12px;overflow:hidden;">
        <div id="meetingsTableContainer"></div>
      </div>
    </section>

    <!-- ── EOD SUMMARY ── -->
    <section class="section" id="sec-eod">
      <div class="card"><div class="card-hd"><div class="card-title">EOD Summary</div><div class="card-sub" id="eodDateSub"></div></div><div style="padding:20px" id="eodBody"></div></div>
    </section>

    <!-- ── EMPLOYEES ── -->
    <section class="section" id="sec-employees">
      <div class="card">
        <div class="card-hd">
          <div><div class="card-title">Employee Performance Dashboard</div><div class="card-sub">Overview metrics, employee filters, and activity timelines.</div></div>
          <div class="toolbar" style="gap:10px;">
            <button class="btn btn-outline" onclick="loadEmployees()">Refresh</button>
          </div>
        </div>
        <div style="padding:16px;">
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:18px;">
            <div style="background:#fff;border:1px solid var(--gray-200);border-radius:12px;padding:16px;">
              <div style="font-size:12px;color:var(--gray-500);text-transform:uppercase;letter-spacing:.08em;">Total employees</div>
              <div id="employeeOverviewTotal" style="margin-top:10px;font-size:28px;font-weight:700;">0</div>
            </div>
            <div style="background:#fff;border:1px solid var(--gray-200);border-radius:12px;padding:16px;">
              <div style="font-size:12px;color:var(--gray-500);text-transform:uppercase;letter-spacing:.08em;">Online now</div>
              <div id="employeeOverviewOnline" style="margin-top:10px;font-size:28px;font-weight:700;">0</div>
            </div>
            <div style="background:#fff;border:1px solid var(--gray-200);border-radius:12px;padding:16px;">
              <div style="font-size:12px;color:var(--gray-500);text-transform:uppercase;letter-spacing:.08em;">Total calls made</div>
              <div id="employeeOverviewCalls" style="margin-top:10px;font-size:28px;font-weight:700;">0</div>
            </div>
            <div style="background:#fff;border:1px solid var(--gray-200);border-radius:12px;padding:16px;">
              <div style="font-size:12px;color:var(--gray-500);text-transform:uppercase;letter-spacing:.08em;">Total leads</div>
              <div id="employeeOverviewFetches" style="margin-top:10px;font-size:28px;font-weight:700;">0</div>
            </div>
            <div style="background:#fff;border:1px solid var(--gray-200);border-radius:12px;padding:16px;">
              <div style="font-size:12px;color:var(--gray-500);text-transform:uppercase;letter-spacing:.08em;">Tasks assigned</div>
              <div id="employeeOverviewTasks" style="margin-top:10px;font-size:28px;font-weight:700;">0</div>
            </div>
            <div style="background:#fff;border:1px solid var(--gray-200);border-radius:12px;padding:16px;">
              <div style="font-size:12px;color:var(--gray-500);text-transform:uppercase;letter-spacing:.08em;">Logged in</div>
              <div id="employeeOverviewLogins" style="margin-top:10px;font-size:28px;font-weight:700;">0</div>
            </div>
          </div>
          <div id="employeeNavTabs" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:18px;">
            <button class="btn btn-outline active" type="button" data-filter="all" onclick="setEmployeeActivityFilter('all')">All Employees</button>
            <button class="btn btn-outline" type="button" data-filter="calls" onclick="setEmployeeActivityFilter('calls')">Calls</button>
            <button class="btn btn-outline" type="button" data-filter="leads" onclick="setEmployeeActivityFilter('leads')">Leads</button>
            <button class="btn btn-outline" type="button" data-filter="tasks" onclick="setEmployeeActivityFilter('tasks')">Tasks</button>
            <button class="btn btn-outline" type="button" data-filter="login" onclick="setEmployeeActivityFilter('login')">Login</button>
          </div>
          <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:18px;">
            <div class="srch" style="min-width:280px;">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/></svg>
              <input type="text" placeholder="Search employees..." id="employeeSearch" oninput="filterEmployees()">
            </div>
            <select class="sel-f" id="employeeRoleF" onchange="filterEmployees()">
              <option value="">All Roles</option>
              <option value="sales">Sales</option>
              <option value="employee">Employee</option>
              <option value="admin">Admin</option>
            </select>
            <select class="sel-f" id="employeeStatusF" onchange="filterEmployees()">
              <option value="">All Statuses</option>
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
            </select>
            <select class="sel-f" id="employeeDeptF" onchange="filterEmployees()">
              <option value="">All Departments</option>
            </select>
            <input type="date" id="employeeDateF" onchange="filterEmployees()" style="padding:10px;border:1px solid var(--gray-200);border-radius:8px;">
          </div>
          <div style="overflow-x:auto;">
            <table>
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Phone</th>
                  <th>Role</th>
                  <th>Department</th>
                  <th>Tasks</th>
                  <th>Status</th>
                  <th>Last Login</th>
                  <th>Work</th>
                  <th>Calls</th>
                  <th>Break</th>
                  <th>Meetings</th>
                  <th>Joined</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="employeesBody"></tbody>
            </table>
          </div>
          <div id="employeeProfilePanel" class="card" style="display:none;margin-top:20px;border:1px solid var(--gray-200);border-radius:12px;overflow:hidden;">
            <div class="card-hd" style="display:flex;justify-content:space-between;align-items:center;gap:12px;padding:18px 20px;">
              <div>
                <div class="card-title" id="employeeProfileTitle">Employee Profile</div>
                <div class="card-sub">View employee details, metrics, tasks and recent activity.</div>
              </div>
              <button class="btn btn-outline" onclick="closeEmployeeProfilePanel()" style="white-space:nowrap;">Close</button>
            </div>
            <div id="employeeProfileContent" style="padding:20px;background:#fff;"></div>
          </div>
          <div style="margin-top:12px;font-size:12px;color:var(--gray-500);" id="employeeCount"></div>
        </div>
      </div>
      <div class="card">
        <div class="card-hd">
          <div><div class="card-title">Admin Call Approval Queue</div><div class="card-sub">Review pending call claim approvals and recordings</div></div>
          <div class="toolbar" style="gap:10px;">
            <button class="btn btn-outline" onclick="crmTimerRenderAdminApprovals()">Refresh</button>
          </div>
        </div>
        <div id="crmAdminApprovalsBody" style="padding:16px;min-height:120px;color:var(--gray-500);">Loading approvals...</div>
      </div>
    </section>

    <!-- ── TEAM ── -->
    <section class="section" id="sec-team">
      <div class="team-grid" id="teamGrid"></div>
      <div class="card">
        <div class="card-hd"><div class="card-title">All Team Activity</div></div>
        <div style="overflow-x:auto"><table><thead><tr><th>Date</th><th>Member</th><th>Territory</th><th>Target</th><th>Industry</th><th>Key Meetings</th><th>Support</th><th>Scores</th></tr></thead><tbody id="teamBody"></tbody></table></div>
      </div>
    </section>

    <!-- ── CALL TRACKER ── -->
    <section class="section" id="sec-call-tracker">
      <div class="card-hd call-journey" style="background:#fff;border:1px solid var(--gray-200);border-radius:var(--radius);padding:16px 20px;margin-bottom:16px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
        <div style="display:flex;align-items:center;gap:16px;">
          <div>
            <div class="card-title">Call Journey</div>
            <div class="card-sub">All recorded calls</div>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:12px;flex:1;">
          <div style="display:flex;gap:12px;align-items:center;margin-right:auto;">
            <div class="srch" style="min-width:260px;">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/></svg>
              <input type="text" placeholder="Search company, contact..." id="callSearch" oninput="renderCalls()">
            </div>
            <select class="sel-f" id="callStatusFHeader" onchange="renderCalls()">
              <option value="">All Statuses</option>
              <option value="Resolved">Resolved</option>
              <option value="Follow-up Required">Follow-up Required</option>
              <option value="Escalated">Escalated</option>
              <option value="No Answer">No Answer</option>
              <option value="Callback Scheduled">Callback Scheduled</option>
            </select>
            <button class="btn-icon" onclick="refreshCalls()" title="Refresh Data">🔄</button>
            <div class="date-wrap">
              <input type="date" id="callDateFilter" class="date-input" />
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="date-icon"><rect x="3" y="4" width="18" height="18" rx="3"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            </div>
          </div>
          <div style="display:flex;gap:12px;align-items:center;">
            <button class="btn btn-outline" id="callExportBtn">Export</button>
            <button class="btn btn-primary" onclick="openCallTypeModal()">+ Add Call</button>
          </div>
        </div>
      </div>
      <div class="card">
        
        <div style="overflow-x:auto"><table><thead><tr><th>timestamp</th><th>sale executive</th><th>Lead source</th><th>Customer Company Name</th><th>Contact Person Name</th><th>Designation</th><th>Contact Number</th><th>Email ID</th><th>Purpose of Call</th><th>Product/Service Discussed</th><th>Call Outcome</th><th>Follow-up</th><th>Recording</th><th>Action</th></tr></thead><tbody id="callBody"></tbody></table></div>
      </div>
    </section>

    <!-- ── ANALYTICS ── -->
    <section class="section" id="sec-analytics">
      <div class="stats-grid" id="analyticsStats"></div>
      <div class="dash-grid">
        <div class="card"><div class="card-hd"><div class="card-title">Submission Breakdown by Executive</div></div><div style="padding:20px" id="analyticsBody"></div></div>
        <div class="card"><div class="card-hd"><div class="card-title">Report Type Summary</div></div><div style="padding:20px" id="analyticsTypes"></div></div>
      </div>
    </section>

    <!-- ── LOGOUT APPROVALS ── -->
    <section class="section" id="sec-logout-approvals">
      <div class="card">
        <div class="card-hd" style="display:flex;justify-content:space-between;align-items:center;">
          <div>
            <div class="card-title">Pending Logout Requests</div>
            <div class="card-sub">Employees requesting to sign out</div>
          </div>
          <button class="btn btn-outline" onclick="renderLogoutApprovals()" style="padding:8px 16px;font-size:13px;">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:middle;margin-right:6px;display:inline-block;"><path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/></svg>Refresh
          </button>
        </div>
        <div id="logoutApprovalsBody" style="padding:16px;min-height:200px;color:var(--gray-500);">Loading logout requests...</div>
      </div>
    </section>

    <!-- ── WORKQUEUE ── -->
    <section class="section" id="sec-workqueue">
      <div class="workqueue-layout" style="grid-template-columns:1fr;">
        <!-- Content -->
        <div class="wq-content">
          <div class="wq-toolbar">
            <div class="wq-title">
              <span id="wqTitle">Calls</span>
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:var(--gray-400);cursor:pointer;"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
            </div>
            <div class="wq-filter">
              <button class="btn-outline" style="padding:6px 12px;font-size:13px;">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
                Filter
              </button>
            </div>
          </div>
          <div class="wq-table-container">
            <table class="wq-table" id="wqTable">
              <thead id="wqTableHead">
                <tr>
                  <th style="width:40px;"><input type="checkbox"></th>
                  <th>Subject <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:middle;"><path d="m6 9 6 6 6-6"/></svg></th>
                  <th>Date</th>
                  <th>Description <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:middle;"><path d="m8 9 4 4 4-4"/><path d="M8 15h8"/></svg></th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody id="wqTableBody">
                <tr>
                  <td><input type="checkbox"></td>
                  <td class="subject">Follow up with Lead</td>
                  <td class="date">Today</td>
                  <td class="description">Follow up about loan details</td>
                  <td class="status"><span class="badge">Medium</span></td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="table-footer">
            <span id="wqTotalRecords">Total Records 1</span>
            <div style="display:flex;align-items:center;gap:8px;">
              <button class="btn-icon" disabled>&lt;</button>
              <span>1 to 1</span>
              <button class="btn-icon" disabled>&gt;</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── CONTACTS ── -->
    <section class="section" id="sec-contacts">
      <div class="leads-layout">
        <!-- Filter Panel -->
        <div class="leads-filter-panel">
          <div class="filter-panel-header">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
            Filter Contacts by
          </div>
          <div class="filter-search">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" id="contactSearch" placeholder="Search contacts..." oninput="renderContacts()">
          </div>
          <div class="filter-section">
            <div class="filter-section-title">Contact Type</div>
            <label class="filter-checkbox"><input type="checkbox" id="filterAll" value="all" checked onchange="renderContacts()"> All</label>
            <label class="filter-checkbox"><input type="checkbox" id="filterCustomer" value="customer" onchange="renderContacts()"> Customer</label>
            <label class="filter-checkbox"><input type="checkbox" id="filterProspect" value="prospect" onchange="renderContacts()"> Prospect</label>
            <label class="filter-checkbox"><input type="checkbox" id="filterPartner" value="partner" onchange="renderContacts()"> Partner</label>
          </div>
        </div>

        <!-- Main Content -->
        <div>
          <div class="leads-toolbar">
            <div class="leads-toolbar-left">
              <div class="view-tabs">
                <button class="view-tab active">All Contacts</button>
                <button class="view-tab">Recently Added</button>
              </div>
            </div>
            <div class="leads-toolbar-right">
              <button class="btn-outline" style="padding:6px 12px;font-size:13px;">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
                Filter
              </button>
              <button class="btn-primary" style="padding:6px 16px;font-size:13px;" onclick="openContactModal()">Create Contact</button>
            </div>
          </div>

          <div class="leads-table-wrap">
            <table class="data-table" id="contactsTable">
              <thead>
                <tr>
                  <th style="width:40px;"><input type="checkbox"></th>
                  <th>Contact Name</th>
                  <th>Company</th>
                  <th>Email</th>
                  <th>Phone</th>
                  <th>Type</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="contactsTableBody">
                <!-- Filled by renderContacts() -->
              </tbody>
            </table>
            <div class="table-footer">
              <span id="contactsCount">Total Records 0</span>
              <div style="display:flex;align-items:center;gap:8px;">
                <button class="btn-icon" disabled>&lt;</button>
                <span>1 to <span id="contactsShowing">0</span></span>
                <button class="btn-icon" disabled>&gt;</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── DEALS ── -->
    <section class="section" id="sec-deals">
      <div class="deals-page">
        <div class="deals-page-header">
          <div>
            <div class="section-title">Deals</div>
            <div class="section-subtitle">Track and manage your deals across the pipeline</div>
          </div>
          <div class="deals-page-actions">
            <button class="btn-outline" type="button" onclick="importDeals()">Import</button>
            <button class="btn-primary" type="button" onclick="openDealModal()">+ Add Deal</button>
          </div>
        </div>

        <div class="deals-metrics-grid">
          <div class="deal-metric-card">
            <div class="deal-metric-top">
              <div class="deal-metric-icon" style="background:#fef3c7;color:#d97706;">📊</div>
              <div class="deal-metric-label">Total Deals</div>
            </div>
            <div class="deal-metric-value" id="dealTotalDeals">0</div>
            <div class="deal-metric-sub">Overall deals in the funnel</div>
          </div>
          <div class="deal-metric-card">
            <div class="deal-metric-top">
              <div class="deal-metric-icon" style="background:#dbeafe;color:#2563eb;">💰</div>
              <div class="deal-metric-label">Total Deal Value</div>
            </div>
            <div class="deal-metric-value" id="dealTotalValue">₹0</div>
            <div class="deal-metric-sub">Current pipeline value</div>
          </div>
          <div class="deal-metric-card">
            <div class="deal-metric-top">
              <div class="deal-metric-icon" style="background:#d1fae5;color:#059669;">🏆</div>
              <div class="deal-metric-label">Won Deals</div>
            </div>
            <div class="deal-metric-value" id="dealWonDeals">0</div>
            <div class="deal-metric-sub">Deals moved to won stage</div>
          </div>
          <div class="deal-metric-card">
            <div class="deal-metric-top">
              <div class="deal-metric-icon" style="background:#f3e8ff;color:#7c3aed;">📈</div>
              <div class="deal-metric-label">Open Deals</div>
            </div>
            <div class="deal-metric-value" id="dealOpenDeals">0</div>
            <div class="deal-metric-sub">Deals still in progress</div>
          </div>
        </div>

        <div class="deal-pipeline-grid">
          <div class="deal-stage-card">
            <div class="deal-stage-title">Login Docs Submitted</div>
            <div class="deal-stage-count" id="pipeline-login-docs-submitted-count">0</div>
            <div class="deal-stage-value" id="pipeline-login-docs-submitted-value">₹0</div>
            <div class="deal-stage-bar"><div class="deal-stage-fill" id="pipeline-login-docs-submitted-bar"></div></div>
          </div>
          <div class="deal-stage-card">
            <div class="deal-stage-title">Approved Limit</div>
            <div class="deal-stage-count" id="pipeline-approved-limit-count">0</div>
            <div class="deal-stage-value" id="pipeline-approved-limit-value">₹0</div>
            <div class="deal-stage-bar"><div class="deal-stage-fill" id="pipeline-approved-limit-bar"></div></div>
          </div>
          <div class="deal-stage-card">
            <div class="deal-stage-title">Sanction Docs</div>
            <div class="deal-stage-count" id="pipeline-sanction-docs-count">0</div>
            <div class="deal-stage-value" id="pipeline-sanction-docs-value">₹0</div>
            <div class="deal-stage-bar"><div class="deal-stage-fill" id="pipeline-sanction-docs-bar"></div></div>
          </div>
          <div class="deal-stage-card">
            <div class="deal-stage-title">Pre-Disbursement</div>
            <div class="deal-stage-count" id="pipeline-pre-disbursement-count">0</div>
            <div class="deal-stage-value" id="pipeline-pre-disbursement-value">₹0</div>
            <div class="deal-stage-bar"><div class="deal-stage-fill" id="pipeline-pre-disbursement-bar"></div></div>
          </div>
          <div class="deal-stage-card">
            <div class="deal-stage-title">Disbursement</div>
            <div class="deal-stage-count" id="pipeline-disbursement-count">0</div>
            <div class="deal-stage-value" id="pipeline-disbursement-value">₹0</div>
            <div class="deal-stage-bar"><div class="deal-stage-fill" id="pipeline-disbursement-bar"></div></div>
          </div>
          <div class="deal-stage-card">
            <div class="deal-stage-title">Payout Received</div>
            <div class="deal-stage-count" id="pipeline-payout-received-count">0</div>
            <div class="deal-stage-value" id="pipeline-payout-received-value">₹0</div>
            <div class="deal-stage-bar"><div class="deal-stage-fill" id="pipeline-payout-received-bar"></div></div>
          </div>
          <div class="deal-stage-card">
            <div class="deal-stage-title">Closed Won</div>
            <div class="deal-stage-count" id="pipeline-closed-won-count">0</div>
            <div class="deal-stage-value" id="pipeline-closed-won-value">₹0</div>
            <div class="deal-stage-bar"><div class="deal-stage-fill" id="pipeline-closed-won-bar"></div></div>
          </div>
          <div class="deal-stage-card">
            <div class="deal-stage-title">Closed Lost</div>
            <div class="deal-stage-count" id="pipeline-closed-lost-count">0</div>
            <div class="deal-stage-value" id="pipeline-closed-lost-value">₹0</div>
            <div class="deal-stage-bar"><div class="deal-stage-fill" id="pipeline-closed-lost-bar"></div></div>
          </div>
        </div>

        <div class="deals-toolbar">
          <div class="deals-toolbar-filters">
            <div class="filter-field">
              <label>Owner</label>
              <select id="dealOwnerFilter" onchange="renderDeals()">
                <option value="">All Owners</option>
                <option value="me">My Deals</option>
              </select>
            </div>
            <div class="filter-field">
              <label>Stage</label>
              <select id="dealStageFilter" onchange="renderDeals()">
                <option value="">All Stages</option>
                <option value="login-docs-submitted">Login Docs Submitted</option>
                <option value="approved-limit">Approved Limit</option>
                <option value="sanction-docs">Sanction Docs</option>
                <option value="pre-disbursement">Pre-Disbursement</option>
                <option value="disbursement">Disbursement</option>
                <option value="payout-received">Payout Received</option>
                <option value="closed-won">Closed Won</option>
                <option value="closed-lost">Closed Lost</option>
              </select>
            </div>
            <div class="filter-field">
              <label>Status</label>
              <select id="dealStatusFilter" onchange="renderDeals()">
                <option value="">All Status</option>
                <option value="open">Open</option>
                <option value="won">Won</option>
                <option value="lost">Lost</option>
              </select>
            </div>
            <div class="filter-field search-field">
              <label>Search</label>
              <input type="text" id="dealSearch" placeholder="Search deals..." oninput="renderDeals()">
            </div>
          </div>
          <div class="deals-toolbar-actions">
            <button class="btn-outline" type="button" onclick="renderDeals()">Apply</button>
          </div>
        </div>

        <div class="deals-table-card">
          <div class="deals-table-header">
            <div>
              <div class="section-title" style="font-size:16px;">Deal list</div>
              <div class="section-subtitle" style="font-size:13px;">Showing latest deals and pipeline progress.</div>
            </div>
          </div>
          <div class="table-scroll">
            <table class="data-table" id="dealsTable">
              <thead>
                <tr>
                  <th style="width:40px;"><input type="checkbox"></th>
                  <th>Deal Name</th>
                  <th>Account</th>
                  <th>Stage</th>
                  <th>Deal Value</th>
                  <th>Expected Revenue</th>
                  <th>Weighted Revenue</th>
                  <th>Probability</th>
                  <th>Expected Close Date</th>
                  <th>Owner</th>
                  <th>Status</th>
                  <th>Last Activity</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="dealsTableBody">
                <!-- Filled by renderDeals() -->
              </tbody>
            </table>
          </div>
          <div class="table-footer">
            <span id="dealsCount">Total Records 0</span>
            <div style="display:flex;align-items:center;gap:8px;">
              <button class="btn-icon" disabled>&lt;</button>
              <span>1 to <span id="dealsShowing">0</span></span>
              <button class="btn-icon" disabled>&gt;</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── ACTIVITIES ── -->
    <section class="section" id="sec-activities">
      <div class="section-placeholder">
        <h3>Activities</h3>
        <p>View and manage all your sales activities including calls, emails, meetings, and tasks in one place.</p>
      </div>
    </section>

    <!-- ── DOCUMENTS ── -->
    <section class="section" id="sec-documents">
      <div class="leads-layout">
        <!-- Filter Panel -->
        <div class="leads-filter-panel">
          <div class="filter-panel-header">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
            Filter Documents by
          </div>
          <div class="filter-search">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" id="documentSearch" placeholder="Search documents..." oninput="renderDocuments()">
          </div>
          <div class="filter-section">
            <div class="filter-section-title">Document Type</div>
            <label class="filter-checkbox"><input type="checkbox" name="documentTypeFilter" value="all" checked onchange="handleDocumentTypeFilterChange(this)"> All</label>
            <label class="filter-checkbox"><input type="checkbox" name="documentTypeFilter" value="contract" onchange="handleDocumentTypeFilterChange(this)"> Contract</label>
            <label class="filter-checkbox"><input type="checkbox" name="documentTypeFilter" value="proposal" onchange="handleDocumentTypeFilterChange(this)"> Proposal</label>
            <label class="filter-checkbox"><input type="checkbox" name="documentTypeFilter" value="quote" onchange="handleDocumentTypeFilterChange(this)"> Quote</label>
            <label class="filter-checkbox"><input type="checkbox" name="documentTypeFilter" value="invoice" onchange="handleDocumentTypeFilterChange(this)"> Invoice</label>
          </div>
        </div>

        <!-- Main Content -->
        <div>
          <div class="leads-toolbar">
            <div class="leads-toolbar-left">
              <div class="view-tabs">
                <button class="view-tab active">All Documents</button>
                <button class="view-tab">Recent</button>
              </div>
            </div>
            <div class="leads-toolbar-right">
              <button class="btn-outline" style="padding:6px 12px;font-size:13px;">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
                Filter
              </button>
              <button class="btn btn-outline" style="padding:6px 16px;font-size:13px;" onclick="renderDocumentsLoanApplications()">Manage Loan Cases</button>
              <button class="btn-primary" style="padding:6px 16px;font-size:13px;" onclick="openDocumentModal()">Upload Document</button>
            </div>
          </div>

          <div class="leads-table-wrap">
            <table class="data-table" id="documentsTable">
              <thead>
                <tr>
                  <th style="width:40px;"><input type="checkbox"></th>
                  <th>Document Name</th>
                  <th>Type</th>
                  <th>Description</th>
                  <th>Size</th>
                  <th>Uploaded</th>
                  <th style="width:80px;text-align:right;">Actions</th>
                </tr>
              </thead>
              <tbody id="documentsTableBody">
                <!-- Filled by renderDocuments() -->
              </tbody>
            </table>
            <div class="table-footer">
              <span id="documentsCount">Total Records 0</span>
              <div style="display:flex;align-items:center;gap:8px;">
                <button class="btn-icon" disabled>&lt;</button>
                <span>1 to <span id="documentsShowing">0</span></span>
                <button class="btn-icon" disabled>&gt;</button>
              </div>
            </div>
          </div>

          <div id="documentsCaseManager" style="margin-top:24px;border:1px solid var(--gray-200);border-radius:var(--radius);background:#fff;padding:20px;box-shadow:0 1px 3px rgba(0,0,0,.05);">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;margin-bottom:18px;">
              <div>
                <div style="font-weight:700;font-size:16px;color:var(--gray-900);">Loan Case Management</div>
                <div style="font-size:13px;color:var(--gray-600);margin-top:6px;">View and manage all lender applications from the document page.</div>
              </div>
              <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
                <input id="caseDocSearch" type="text" placeholder="Search company, lender or application" oninput="renderDocumentsLoanApplications()" style="min-width:220px;padding:10px 12px;border:1px solid var(--gray-200);border-radius:10px;outline:none;" />
                <button class="btn btn-outline" onclick="renderDocumentsLoanApplications()">Refresh</button>
              </div>
            </div>
            <div id="documentsCaseSummary" style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:18px;"> </div>
            <div id="documentsCaseTableContainer"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── PIPELINE ── -->
    <section class="section" id="sec-pipeline">
      <div id="pipelineApp"></div>
    </section>

    <!-- ── FORECASTING ── -->
    <section class="section" id="sec-forecasting">
      <div class="dash-grid" style="grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 20px;">
        <div class="card" style="grid-column: 1 / -1;">
          <div class="card-hd">
            <div>
              <div class="card-title">Advanced Sales Forecast Dashboard</div>
              <div class="card-subtitle">Live CRM-driven forecasting using current pipeline and sanctioning data</div>
            </div>
            <div class="toolbar">
              <select class="sel-f" id="forecastPeriod">
                <option value="month">This Month</option>
                <option value="quarter">This Quarter</option>
                <option value="year">This Year</option>
              </select>
            </div>
          </div>
          <div style="padding: 24px;">
            <div id="forecast-kpis" style="display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-bottom: 20px;"></div>
            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px; align-items: start;">
              <div class="card" style="padding: 0; box-shadow: none; border-color: var(--gray-200);">
                <div class="card-hd" style="padding: 16px 20px 0; border-bottom: 1px solid var(--gray-100);">
                  <div class="card-title" style="font-size: 16px;">Revenue Forecast Trend</div>
                </div>
                <div style="padding: 16px 20px 20px;">
                  <canvas id="forecast-chart" height="280"></canvas>
                </div>
              </div>
              <div class="card" style="padding: 0; box-shadow: none; border-color: var(--gray-200);">
                <div class="card-hd" style="padding: 16px 20px 0; border-bottom: 1px solid var(--gray-100);">
                  <div class="card-title" style="font-size: 16px;">Forecast by Pipeline Stage</div>
                </div>
                <div style="padding: 16px 20px 20px;" id="forecast-by-stage"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="card" style="grid-column: 1 / span 4;">
          <div class="card-hd">
            <div class="card-title">Quota Achievement</div>
          </div>
          <div id="forecast-quota" style="padding: 20px;"></div>
        </div>

        <div class="card" style="grid-column: 5 / span 4;">
          <div class="card-hd">
            <div class="card-title">Forecast Accuracy</div>
          </div>
          <div id="forecast-accuracy" style="padding: 20px;"></div>
        </div>

        <div class="card" style="grid-column: 9 / -1;">
          <div class="card-hd">
            <div class="card-title">Expected Closures</div>
          </div>
          <div id="forecast-closures" style="padding: 20px;"></div>
        </div>

        <div class="card" style="grid-column: 1 / span 6;">
          <div class="card-hd">
            <div class="card-title">Top 5 High Value Deals</div>
          </div>
          <div id="forecast-high-value" style="padding: 20px;"></div>
        </div>

        <div class="card" style="grid-column: 7 / -1;">
          <div class="card-hd">
            <div class="card-title">AI Revenue Prediction</div>
          </div>
          <div id="forecast-ai" style="padding: 20px;"></div>
        </div>

        <div class="card" style="grid-column: 1 / -1;">
          <div class="card-hd">
            <div class="card-title">Pipeline Health</div>
          </div>
          <div id="forecast-health" style="padding: 20px;"></div>
        </div>
      </div>
    </section>

    <!-- ── REPORTS & ANALYTICS ── -->
    <section class="section" id="sec-reports">
      <div class="dash-grid">
        <!-- Report Cards -->
        <div class="card" style="grid-column: 1 / -1;">
          <div class="card-hd">
            <div>
              <div class="card-title">📊 Analytics & Reporting</div>
              <div class="card-subtitle">Track performance and make data-driven decisions</div>
            </div>
            <div class="toolbar">
              <select class="sel-f">
                <option>This Month</option>
                <option>Last Month</option>
                <option>This Quarter</option>
                <option>This Year</option>
              </select>
              <button class="btn-primary" style="padding:6px 12px;font-size:13px;" onclick="showToast('Export Report - Coming Soon', 'info')">Export</button>
            </div>
          </div>
          <div style="padding: 24px;">
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px;">
              <div class="stat-card">
                <div class="stat-label">Total Leads</div>
                <div class="stat-val" id="report-total-leads">0</div>
                <div class="stat-trend">—</div>
              </div>
              <div class="stat-card">
                <div class="stat-label">Conversion Rate</div>
                <div class="stat-val" id="report-conversion">0%</div>
                <div class="stat-trend">—</div>
              </div>
              <div class="stat-card">
                <div class="stat-label">Avg Deal Size</div>
                <div class="stat-val" id="report-avg-deal">₹0L</div>
                <div class="stat-trend">—</div>
              </div>
              <div class="stat-card">
                <div class="stat-label">Sales Cycle</div>
                <div class="stat-val" id="report-cycle">0 days</div>
                <div class="stat-trend">—</div>
              </div>
            </div>
            
            <!-- Report Types -->
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
              <div style="background: var(--gray-50); border-radius: var(--radius); padding: 20px; border: 1px solid var(--gray-200);">
                <div style="font-size: 32px; margin-bottom: 12px;">📈</div>
                <div style="font-weight: 600; color: var(--gray-800); margin-bottom: 4px;">Lead Source Report</div>
                <div style="font-size: 13px; color: var(--gray-500); margin-bottom: 12px;">Analyze where your leads come from</div>
                <button type="button" class="btn-outline report-generate-btn" style="width: 100%; font-size: 12px;" data-report-type="source_performance">Generate</button>
              </div>
              <div style="background: var(--gray-50); border-radius: var(--radius); padding: 20px; border: 1px solid var(--gray-200);">
                <div style="font-size: 32px; margin-bottom: 12px;">💰</div>
                <div style="font-weight: 600; color: var(--gray-800); margin-bottom: 4px;">Revenue Report</div>
                <div style="font-size: 13px; color: var(--gray-500); margin-bottom: 12px;">Track revenue by month/quarter</div>
                <button type="button" class="btn-outline report-generate-btn" style="width: 100%; font-size: 12px;" data-report-type="monthly_sales">Generate</button>
              </div>
              <div style="background: var(--gray-50); border-radius: var(--radius); padding: 20px; border: 1px solid var(--gray-200);">
                <div style="font-size: 32px; margin-bottom: 12px;">👥</div>
                <div style="font-weight: 600; color: var(--gray-800); margin-bottom: 4px;">Team Performance</div>
                <div style="font-size: 13px; color: var(--gray-500); margin-bottom: 12px;">Compare sales rep performance</div>
                <button type="button" class="btn-outline report-generate-btn" style="width: 100%; font-size: 12px;" data-report-type="employee_performance">Generate</button>
              </div>
              <div style="background: var(--gray-50); border-radius: var(--radius); padding: 20px; border: 1px solid var(--gray-200);">
                <div style="font-size: 32px; margin-bottom: 12px;">🎯</div>
                <div style="font-weight: 600; color: var(--gray-800); margin-bottom: 4px;">Pipeline Analysis</div>
                <div style="font-size: 13px; color: var(--gray-500); margin-bottom: 12px;">Deal progression and bottlenecks</div>
                <button type="button" class="btn-outline report-generate-btn" style="width: 100%; font-size: 12px;" data-report-type="daily_leads">Generate</button>
              </div>
              <div style="background: var(--gray-50); border-radius: var(--radius); padding: 20px; border: 1px solid var(--gray-200);">
                <div style="font-size: 32px; margin-bottom: 12px;">📞</div>
                <div style="font-weight: 600; color: var(--gray-800); margin-bottom: 4px;">Activity Report</div>
                <div style="font-size: 13px; color: var(--gray-500); margin-bottom: 12px;">Calls, emails, meetings tracking</div>
                <button type="button" class="btn-outline report-generate-btn" style="width: 100%; font-size: 12px;" data-report-type="lender_approval">Generate</button>
              </div>
              <div style="background: var(--gray-50); border-radius: var(--radius); padding: 20px; border: 1px solid var(--gray-200);">
                <div style="font-size: 32px; margin-bottom: 12px;">📉</div>
                <div style="font-weight: 600; color: var(--gray-800); margin-bottom: 4px;">Lost Deals Analysis</div>
                <div style="font-size: 13px; color: var(--gray-500); margin-bottom: 12px;">Understand why deals are lost</div>
                <button type="button" class="btn-outline report-generate-btn" style="width: 100%; font-size: 12px;" data-report-type="disbursal">Generate</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── CAMPAIGNS ── -->
    <section class="section" id="sec-campaigns">
      <div class="leads-layout">
        <!-- Filter Panel -->
        <div class="leads-filter-panel">
          <div class="filter-panel-header">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
            Filter Campaigns by
          </div>
          <div class="filter-search">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" id="campaignSearch" placeholder="Search campaigns..." oninput="renderCampaigns()">
          </div>
          <div class="filter-section">
            <div class="filter-section-title">Campaign Type</div>
            <label class="filter-checkbox"><input type="checkbox" checked onchange="renderCampaigns()"> All</label>
            <label class="filter-checkbox"><input type="checkbox" onchange="renderCampaigns()"> Email</label>
            <label class="filter-checkbox"><input type="checkbox" onchange="renderCampaigns()"> Social</label>
            <label class="filter-checkbox"><input type="checkbox" onchange="renderCampaigns()"> Webinar</label>
          </div>
          <div class="filter-section">
            <div class="filter-section-title">Status</div>
            <label class="filter-checkbox"><input type="checkbox" checked onchange="renderCampaigns()"> Active</label>
            <label class="filter-checkbox"><input type="checkbox" onchange="renderCampaigns()"> Draft</label>
            <label class="filter-checkbox"><input type="checkbox" onchange="renderCampaigns()"> Completed</label>
          </div>
        </div>

        <!-- Main Content -->
        <div>
          <div class="leads-toolbar">
            <div class="leads-toolbar-left">
              <div class="view-tabs">
                <button class="view-tab active">All Campaigns</button>
                <button class="view-tab">Active</button>
                <button class="view-tab">Completed</button>
              </div>
            </div>
            <div class="leads-toolbar-right">
              <button class="btn-outline" style="padding:6px 12px;font-size:13px;">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
                Filter
              </button>
              <button class="btn-primary" style="padding:6px 16px;font-size:13px;" onclick="openCampaignModal()">Create Campaign</button>
            </div>
          </div>

          <div class="leads-table-wrap">
            <table class="data-table" id="campaignsTable">
