      {label:"LC / Import Limit Required", req:true, ph:"e.g. ₹5 Crore"},
      {label:"Usance Period", type:"select", options:["Select","Sight LC","30 Days","60 Days","90 Days","120 Days"]},
      {label:"Existing Import LC Limit (if any)", ph:"With which bank"},
      {label:"Currency", type:"select", options:["Select","USD","EUR","CNY","GBP","Other"]},
      {label:"Frequency of Import", type:"select", options:["Select","One-time","Monthly","Quarterly","Ad-hoc"]},
      {label:"Additional Notes", type:"textarea", full:true}
    ]
  },
  exp: {
    title:"Export Finance — Transaction Details",
    fields:[
      {label:"Buyer / Importer Country", req:true, ph:"e.g. USA, UAE"},
      {label:"Buyer Company Name", ph:"Overseas buyer"},
      {label:"Export Order Value", req:true, ph:"e.g. ₹10 Crore"},
      {label:"Finance Required", type:"select", options:["Select","Pre-Shipment","Post-Shipment","Both"]},
      {label:"ECGC Cover Available", type:"select", options:["Select","Yes","No","In Process"]},
      {label:"Underlying LC / Order Reference", ph:"LC number or PO number"},
      {label:"Currency", type:"select", options:["Select","USD","EUR","GBP","Other"]},
      {label:"Shipment Timeline", type:"date"},
      {label:"Additional Notes", type:"textarea", full:true}
    ]
  },
  buyer: {
    title:"Buyer Credit — Transaction Details",
    fields:[
      {label:"Overseas Bank (Arranging)", ph:"e.g. DBS Singapore"},
      {label:"Buyer Credit Amount", req:true, ph:"e.g. USD 2,000,000"},
      {label:"Currency", type:"select", options:["Select","USD","EUR","GBP","Other"]},
      {label:"Underlying LC Reference", req:true, ph:"Import LC number"},
      {label:"Usance / Tenure", type:"select", options:["Select","90 Days","180 Days","270 Days","1 Year"]},
      {label:"All-in Cost Expectation", ph:"e.g. LIBOR/SOFR + 150 bps"},
      {label:"Rollover Required", type:"select", options:["Select","Yes","No"]},
      {label:"Additional Notes", type:"textarea", full:true}
    ]
  },
  vendor: {
    title:"Vendor Finance — Program Details",
    fields:[
      {label:"Anchor Company Name", req:true, ph:"Large corporate buyer"},
      {label:"Anchor Credit Rating", ph:"e.g. BBB- and above"},
      {label:"Vendor Relationship Duration", ph:"e.g. 5+ years"},
      {label:"Program Size Required", req:true, ph:"e.g. ₹10 Crore"},
      {label:"Number of Vendors in Program", ph:"e.g. 15"},
      {label:"Invoice / Billing Cycle", type:"select", options:["Select","Weekly","Fortnightly","Monthly"]},
      {label:"Recourse Type", type:"select", options:["Select","With Recourse","Without Recourse"]},
      {label:"Additional Notes", type:"textarea", full:true}
    ]
  },
  dealer: {
    title:"Dealer Finance — Program Details",
    fields:[
      {label:"Principal / OEM Name", req:true, ph:"e.g. Mahindra, Tata Motors"},
      {label:"Principal Rating", ph:"e.g. AA and above"},
      {label:"Dealer Network Size", ph:"e.g. 40 dealers"},
      {label:"Credit Period Required", req:true, ph:"e.g. 45 days"},
      {label:"Program / Channel Limit", req:true, ph:"e.g. ₹15 Crore"},
      {label:"Security Offered", ph:"e.g. Stock hypothecation, PDCs"},
      {label:"Additional Notes", type:"textarea", full:true}
    ]
  },
  wcdl: {
    title:"Working Capital Demand Loan — Details",
    fields:[
      {label:"Working Capital Gap", req:true, ph:"e.g. ₹8 Crore"},
      {label:"Existing WC Limits (if any)", ph:"With bank name"},
      {label:"Stock Value", ph:"e.g. ₹5 Crore"},
      {label:"Debtors / Receivables Value", ph:"e.g. ₹6 Crore"},
      {label:"Security Offered", ph:"e.g. Hypothecation of stock & debtors"},
      {label:"Repayment Tenure Sought", type:"select", options:["Select","12 Months","24 Months","36 Months"]},
      {label:"Additional Notes", type:"textarea", full:true}
    ]
  },
  wctl: {
    title:"Working Capital Term Loan (WCTL) — Details",
    fields:[
      {label:"Loan Amount Required", req:true, ph:"e.g. ₹25 Lacs"},
      {label:"Purpose of WCTL", ph:"e.g. Short-term working capital gap"},
      {label:"Average Bank Balance (ABB)", ph:"e.g. ₹50,000/month"},
      {label:"Repayment Structure Preferred", type:"select", options:["Select","Monthly Principal + Interest","Quarterly Principal, Monthly Interest","Bullet Repayment"]},
      {label:"Invoice-Based Disbursement?", type:"select", options:["Select","Yes","No"]},
      {label:"Additional Notes", type:"textarea", full:true}
    ]
  },
  treds: {
    title:"TReDS (Trade Receivables Discounting) — Details",
    fields:[
