            <div class="kpi-trend up"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M7 17l5-5 5 5"/><path d="M12 12V3"/></svg>+8.7%</div>
          </div>
