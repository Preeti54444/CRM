        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>Employees
      </button>
      <button class="nav-btn admin-only" data-sec="team" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>Team Activity
      </button>
      <button class="nav-btn admin-only" data-sec="analytics" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg>Analytics
      </button>
      <button class="nav-btn admin-only" data-sec="logout-approvals" onclick="nav(this)">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>Logout Approvals
      </button>
    </div>
  </nav>
  <div class="sb-user">
    <div class="sb-user-card">
      <div class="sb-avatar" id="sbAvatar">RC</div>
      <div><div class="sb-uname" id="sbName">—</div><div class="sb-utitle" id="sbTitle">—</div></div>
    </div>
    <button class="sb-logout" onclick="logout()">
      <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>Sign Out
    </button>
  </div>
</aside>

<main class="main">
  <div class="topbar">
    <div class="topbar-left">
      <div class="topbar-title" id="topTitle">Dashboard</div>
    </div>
    <div class="topbar-search">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input type="text" placeholder="Search..." aria-label="Search application content" />
    </div>
    <div class="topbar-right" style="align-items:center;gap:10px;">
      <button class="btn btn-primary topbar-add" type="button" onclick="handleTopbarAdd()" aria-label="Add new item">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14"/><path d="M5 12h14"/></svg>Add</button>
      <button type="button" class="topbar-notifications" id="topNotificationsBtn" onclick="showNotifications()" title="Notifications" aria-label="Notifications">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 8-3 8h18s-3-1-3-8"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        <span class="notification-badge" id="notificationBadge" style="display:none;">0</span>
      </button>
      <!-- IST Clock Display -->
      <div id="istClockContainer">🕐 Loading time...</div>
      <span id="topName" style="font-size:13px;color:var(--gray-600);font-weight:500;"></span>
      <span class="role-pill admin" id="topRole">Admin</span>
    </div>
  </div>
  <div class="content">

    <!-- ── DASHBOARD ── -->
    <section class="section active" id="sec-dashboard">
      <!-- KPI Cards Row -->
      <div id="crmTimerDashboardCard" style="margin-bottom:18px;"></div>
      <!-- Today's Target Panel (Employee) -->
      <div id="crmTargetPanel" class="employee-only-section"></div>
      <!-- Admin Target KPIs & Grid -->
      <div class="dash-card admin-only-section" style="margin-bottom:18px;flex-direction:column;align-items:stretch;">
        <div class="card-header" style="width:100%;">
          <div>
            <div class="card-title">Employee Target Management</div>
            <div class="card-subtitle">Live performance grid — auto-refreshes every 20 seconds</div>
          </div>
        </div>
        <div id="crmAdminTargetKPIs" class="admin-target-kpis" style="width:100%;"></div>
        <div id="crmAdminTargetGrid" style="width:100%;margin-top:12px;"></div>
      </div>
      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="kpi-header">
            <div class="kpi-icon" style="background:#fef3c7;color:#d97706;"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div>
            <div class="kpi-trend up"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M7 17l5-5 5 5"/><path d="M12 12V3"/></svg>+18.5%</div>
          </div>
          <div class="kpi-value" id="kpi-leads">0</div>
          <div class="kpi-label">Total Leads</div>
          <svg class="kpi-sparkline" viewBox="0 0 100 30"><polyline points="0,25 10,22 20,24 30,18 40,20 50,15 60,17 70,12 80,14 90,8 100,10" fill="none" stroke="#d97706" stroke-width="2"/></svg>
        </div>
        <div class="kpi-card">
          <div class="kpi-header">
            <div class="kpi-icon" style="background:#dbeafe;color:#2563eb;font-size:18px;font-weight:700;">👥</div>
            <div class="kpi-trend up"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M7 17l5-5 5 5"/><path d="M12 12V3"/></svg>+12.4%</div>
          </div>
          <div class="kpi-value" id="kpi-clients">0</div>
          <div class="kpi-label">Total Clients</div>
          <svg class="kpi-sparkline" viewBox="0 0 100 30"><polyline points="0,20 10,18 20,22 30,16 40,19 50,14 60,17 70,12 80,15 90,10 100,8" fill="none" stroke="#2563eb" stroke-width="2"/></svg>
        </div>
