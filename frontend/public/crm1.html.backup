<!-- Change Stage Modal -->
<div id="changeStageModal" class="modal" style="display:none;">
  <div class="modal-content" style="max-width:520px;">
    <div class="modal-header">
      <h3>Change Deal Stage</h3>
      <button class="modal-close" onclick="closeChangeStageModal()">&times;</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label>Select Stage</label>
        <select id="changeStageSelect">
          <option value="login-docs-submitted">Login Docs Submitted</option>
          <option value="approved-limit">Approved Limit</option>
          <option value="sanction-docs">Sanction Docs</option>
          <option value="pre-disbursement">Pre-Disbursement</option>
          <option value="disbursement">Disbursement</option>
          <option value="payout-received">Payout Received</option>
          <option value="closed-won">Closed Won</option>
          <option value="closed-lost">Closed Lost</option>
        </select>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-outline" onclick="closeChangeStageModal()">Cancel</button>
      <button class="btn-primary" onclick="submitChangeStageModal()">Save</button>
    </div>
  </div>
</div>

<!-- Add Note Modal -->
<div id="addNoteModal" class="modal" style="display:none;">
  <div class="modal-content" style="max-width:640px;">
    <div class="modal-header">
      <h3>Add Note to Deal</h3>
      <button class="modal-close" onclick="closeAddNoteModal()">&times;</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label>Note</label>
        <textarea id="addNoteTextarea" rows="6" placeholder="Enter note..."></textarea>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-outline" onclick="closeAddNoteModal()">Cancel</button>
      <button class="btn-primary" onclick="submitAddNoteModal()">Add Note</button>
    </div>
  </div>
</div>

<!-- Assign Owner Modal -->
<div id="assignOwnerModal" class="modal" style="display:none;">
  <div class="modal-content" style="max-width:520px;">
    <div class="modal-header">
      <h3>Assign Deal Owner</h3>
      <button class="modal-close" onclick="closeAssignOwnerModal()">&times;</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label>Search Owner</label>
        <input id="assignOwnerInput" list="assignOwnerList" placeholder="Type to search owners..." style="width:100%;padding:10px;border:1px solid var(--gray-200);border-radius:8px;" />
        <datalist id="assignOwnerList"></datalist>
        <div style="display:flex;gap:8px;margin-top:8px;">
          <button class="btn-outline" type="button" onclick="openOwnerPicker()">Open Directory</button>
          <button class="btn" type="button" onclick="selectAssignOwner(assignOwnerInput.value)">Use Typed Value</button>
        </div>
        <div id="assignOwnerResults" style="margin-top:8px;max-height:220px;overflow:auto;border:1px solid var(--gray-100);border-radius:8px;display:none;background:white;
          box-shadow:0 6px 20px rgba(12,18,31,0.04);">
        </div>
      </div>

        <!-- Owner Picker Modal -->
        <div id="ownerPickerModal" class="modal" style="display:none;">
          <div class="modal-content" style="max-width:640px;">
            <div class="modal-header">
              <h3>Employee Directory</h3>
              <button class="modal-close" onclick="closeOwnerPicker()">&times;</button>
            </div>
            <div class="modal-body">
              <div style="display:flex;gap:8px;margin-bottom:10px;">
                <input id="ownerPickerSearch" placeholder="Search employees..." style="flex:1;padding:10px;border:1px solid var(--gray-200);border-radius:8px;" />
                <button class="btn-outline" onclick="renderOwnerPicker()">Refresh</button>
              </div>
              <div id="ownerPickerList" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;max-height:420px;overflow:auto;padding:4px;">
                <!-- items injected here -->
              </div>
            </div>
            <div class="modal-footer">
              <button class="btn-outline" onclick="closeOwnerPicker()">Close</button>
            </div>
          </div>
        </div>
    </div>
    <div class="modal-footer">
      <button class="btn-outline" onclick="closeAssignOwnerModal()">Cancel</button>
      <button class="btn-primary" onclick="submitAssignOwnerModal()">Assign</button>
    </div>
  </div>
</div>

<div id="taskDetailModal" class="modal" style="display:none;justify-content:center;align-items:center;padding:24px;">
  <div class="modal-content" style="width:90%;max-width:540px;max-height:85vh;overflow-y:auto;border-radius:18px;box-shadow:0 18px 48px rgba(0,0,0,0.16);background:#fff;animation:modalSlideIn 0.25s ease;">
    <div style="padding:20px 24px;border-bottom:1px solid rgba(15,23,42,0.08);display:flex;justify-content:space-between;align-items:center;">
      <div style="font-size:18px;font-weight:700;color:var(--gray-900);" class="modal-title">Task Details</div>
      <button class="btn-secondary" style="font-size:14px;padding:8px 12px;" onclick="closeTaskDetailModal()">Close</button>
    </div>
    <div class="modal-body" style="padding:20px;line-height:1.6;color:var(--gray-800);"></div>
  </div>
</div>

<!-- Notification Panel -->
<div id="notificationPanel" class="notification-panel" style="display:none;">
  <div class="notification-panel-header">
    <h3>Notifications</h3>
    <button type="button" class="notification-panel-close" onclick="closeNotificationPanel()" title="Close">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="notification-panel-list" id="notificationList">
    <div style="padding:20px;text-align:center;color:var(--gray-500);">No notifications</div>
  </div>
  <div class="notification-panel-footer">
    <button type="button" onclick="clearAllNotifications()" class="btn-secondary" style="width:100%;">Clear All</button>
  </div>
</div>

<!-- Modal Backdrop -->
<div id="modalBackdrop" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);backdrop-filter:blur(4px);z-index:1000;" onclick="closeAllModals()"></div>

<div id="toast" class="toast"></div>

