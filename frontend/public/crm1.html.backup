// ---------- FUNCTIONS ----------
function onVerticalChange(){
  const vertical = document.getElementById('verticalSelect').value;
  const subSelect = document.getElementById('subProductSelect');
  subSelect.innerHTML = '';
  document.getElementById('dynamicFormContainer').innerHTML = '';
  document.getElementById('leadQualificationSection').style.display = 'none';
  document.getElementById('followupSchedulingSection').style.display = 'none';
  document.getElementById('dynamicSubmitButtons').style.display = 'none';

  if(!vertical){
    subSelect.disabled = true;
    subSelect.innerHTML = '<option value="">Select vertical first</option>';
    return;
  }
  subSelect.disabled = false;
  subSelect.innerHTML = '<option value="">Select sub-product</option>' +
    subProducts[vertical].map(p => `<option value="${p.id}">${p.added ? '🆕 ' : ''}${p.name}</option>`).join('');
  renderEmptyState();
}

function renderEmptyState(){
  document.getElementById('dynamicFormContainer').innerHTML = `
    <div class="dynamic-card">
      <div class="empty-state">
        <p>Sub-product select karo — uska specific form yahan aayega.</p>
      </div>
    </div>`;
}

function renderForm(){
  const subId = document.getElementById('subProductSelect').value;
  const container = document.getElementById('dynamicFormContainer');
  if(!subId){ renderEmptyState(); return; }

  const set = fieldSets[subId];
  let fieldsHtml = set.fields.map(f=>{
    const fullClass = f.full ? 'full' : '';
    const reqStar = f.req ? '<span class="req">*</span>' : '';
    if(f.type === 'select'){
      return `<div class="dynamic-field ${fullClass}"><label>${f.label} ${reqStar}</label>
        <select>${f.options.map(o=>`<option>${o}</option>`).join('')}</select></div>`;
    } else if(f.type === 'textarea'){
      return `<div class="dynamic-field ${fullClass}"><label>${f.label} ${reqStar}</label>
        <textarea placeholder="${f.ph||''}"></textarea></div>`;
    } else if(f.type === 'date'){
      return `<div class="dynamic-field ${fullClass}"><label>${f.label} ${reqStar}</label>
        <input type="date"></div>`;
    } else {
      return `<div class="dynamic-field ${fullClass}"><label>${f.label} ${reqStar}</label>
        <input placeholder="${f.ph||''}"></div>`;
    }
  }).join('');

  container.innerHTML = `
    <div class="dyn-banner">✓ Form updated for: <b>&nbsp;${set.title}</b></div>
    <div class="dynamic-card">
      <div class="dynamic-section-label">Step 3 — ${set.title}</div>
      <div class="dynamic-form-grid">${fieldsHtml}</div>
    </div>`;

  // Show qualification and follow-up sections
  document.getElementById('leadQualificationSection').style.display = 'block';
  document.getElementById('followupSchedulingSection').style.display = 'block';
  document.getElementById('dynamicSubmitButtons').style.display = 'flex';
}

function closeSuggestedLendersModal(){ 
  document.getElementById('lenderOverlay').classList.remove('show'); 
}

function parseNum(str){
  if(!str) return null;
  const m = String(str).match(/[\d.]+/);
  return m ? parseFloat(m[0]) : null;
}

function suggestLenders(){
  const subId = document.getElementById('subProductSelect')?.value;
  if(!subId){ alert("Pehle Vertical aur Sub-Product select karo."); return; }

  const turnover = parseNum(document.getElementById('turnoverInput')?.value);
  const vintage = parseNum(document.getElementById('vintageInput')?.value);
  const amount = parseNum(document.getElementById('amountInput')?.value);
  const cibil = parseNum(document.getElementById('cibilInput')?.value);
  const industry = document.getElementById('industryInput')?.value;

  const candidates = lenderDB.filter(l => l.subId === subId);
  const subName = fieldSets[subId] ? fieldSets[subId].title : subId;
  document.getElementById('modalSubtitle').textContent = `For: ${subName.replace(' — Details','').replace(' — Program Details','').replace(' — Case Details','').replace(' — Deal Details','').replace(' — Transaction Details','')}`;

  let html = '';
  let eligibleCount=0, reviewCount=0, rejectCount=0;

  if(candidates.length === 0){
    html = `<div class="no-match-note">Iss sub-product ke liye database mein koi direct lender match nahi mila.<br>Manual sourcing ya naye lender data add karne ki zaroorat hai.</div>`;
  } else {
    candidates.forEach(l=>{
      let reasons = [];
      let status = 'eligible';

      if(l.minTurnoverCr != null){
        if(turnover == null){ reasons.push({t:`Turnover data missing — lender needs ₹${l.minTurnoverCr}+ Cr`, cls:''}); status='review'; }
        else if(turnover < l.minTurnoverCr){ reasons.push({t:`Turnover ₹${turnover}Cr is below required ₹${l.minTurnoverCr}+ Cr`, cls:'bad'}); status='reject'; }
        else reasons.push({t:`Turnover ₹${turnover}Cr meets ₹${l.minTurnoverCr}+ Cr requirement`, cls:'good'});
      }

      if(l.minVintageYrs != null && status !== 'reject'){
        if(vintage == null){ reasons.push({t:`Vintage data missing — lender needs ${l.minVintageYrs}+ yrs`, cls:''}); if(status==='eligible') status='review'; }
        else if(vintage < l.minVintageYrs){ reasons.push({t:`Vintage ${vintage}yrs below required ${l.minVintageYrs}+ yrs`, cls:'bad'}); status='reject'; }
        else reasons.push({t:`Vintage ${vintage}yrs meets ${l.minVintageYrs}+ yrs requirement`, cls:'good'});
      }

      if(status !== 'reject'){
        if(amount == null){ reasons.push({t:`Funding amount not entered — cannot verify against lender's range`, cls:''}); if(status==='eligible') status='review'; }
        else if(l.maxAmtCr != null && amount > l.maxAmtCr){ reasons.push({t:`Amount ₹${amount}Cr exceeds lender's max ₹${l.maxAmtCr}Cr`, cls:'bad'}); status='reject'; }
        else if(l.minAmtCr != null && amount < l.minAmtCr){ reasons.push({t:`Amount ₹${amount}Cr is below lender's min ₹${l.minAmtCr}Cr`, cls:'bad'}); status='reject'; }
        else reasons.push({t:`Amount ₹${amount}Cr fits lender's range`, cls:'good'});
      }

      if(status !== 'reject' && industry){
        if(l.negativeIndustries && l.negativeIndustries.includes(industry)){ reasons.push({t:`"${industry}" is in lender's negative/excluded industry list`, cls:'bad'}); status='reject'; }
        else if(l.preferredIndustries && l.preferredIndustries.includes(industry)){ reasons.push({t:`"${industry}" matches lender's preferred industry list`, cls:'good'}); }
        else if(l.preferredIndustries){ reasons.push({t:`"${industry}" not explicitly listed as preferred — may need manual check`, cls:''}); if(status==='eligible') status='review'; }
      }

      if(status !== 'reject' && l.minCIBIL){
        if(cibil == null){ reasons.push({t:`Promoter CIBIL not entered — lender needs ${l.minCIBIL}+`, cls:''}); if(status==='eligible') status='review'; }
        else if(cibil < l.minCIBIL){ reasons.push({t:`Promoter CIBIL ${cibil} below required ${l.minCIBIL}+`, cls:'bad'}); status='reject'; }
        else reasons.push({t:`Promoter CIBIL ${cibil} meets ${l.minCIBIL}+ requirement`, cls:'good'});
      }

      if(status==='eligible') eligibleCount++;
      else if(status==='review') reviewCount++;
      else rejectCount++;

      const badgeMap = {eligible:'<span style="color:var(--success); font-size:12px; font-weight:600">✓ Likely Eligible</span>', review:'<span style="color:var(--warning); font-size:12px; font-weight:600">⚠ Needs Review</span>', reject:'<span style="color:var(--danger); font-size:12px; font-weight:600">✗ Not Eligible</span>'};

      html += `<div class="lender-result ${status}">
        <div class="lender-result-head">
          <div><div class="lender-name">${l.lender}</div><div class="lender-product">${l.product} · Collateral: ${l.collateral||'—'}</div></div>
          ${badgeMap[status]}
        </div>
        <ul class="reason-list">${reasons.map(r=>`<li class="${r.cls}">${r.t}</li>`).join('')}</ul>
      </div>`;
    });
  }

  const summary = candidates.length ? `
    <div class="match-summary">
      <div class="match-chip" style="background:var(--success-bg); color:var(--success);">${eligibleCount} Eligible</div>
      <div class="match-chip" style="background:var(--warning-bg); color:var(--warning);">${reviewCount} Needs Review</div>
      <div class="match-chip" style="background:var(--danger-bg); color:var(--danger);">${rejectCount} Not Eligible</div>
    </div>` : '';

  document.getElementById('lenderModalBody').innerHTML = summary + html;
  document.getElementById('lenderOverlay').classList.add('show');
}

// Initialize dynamic lead user display
document.addEventListener('DOMContentLoaded', function() {
  const session = JSON.parse(localStorage.getItem('crm_session') || '{}');
  const userName = session.name || session.email || '—';
  const userPill = document.getElementById('dynamicLeadUser');
  if (userPill) {
    userPill.textContent = '👤 ' + userName;
  }

  const activeModeBadge = document.getElementById('dynamicActiveMode');
  if (activeModeBadge) {
    activeModeBadge.textContent = '⚡ Active Mode';
    activeModeBadge.style.display = 'inline-flex';
  }
  
  // Set sales executive field
  const execField = document.getElementById('ldExec');
  if (execField && userName !== '—') {
    execField.value = userName;
  }
  
  // Set today's date
  const dateField = document.getElementById('ldDate');
  if (dateField) {
    const today = new Date().toISOString().split('T')[0];
    dateField.value = today;
  }
  
  // Initialize empty state
  renderEmptyState();

  // Initialize lead permissions banner when editing or viewing an existing lead
  const urlParams = new URLSearchParams(window.location.search);
  const queryLeadId = urlParams.get('leadId') || urlParams.get('lead_id');
  const existingLeadId = document.getElementById('currentLeadId')?.value || window.currentLeadId || window.currentCaseLeadId || queryLeadId;
  if (existingLeadId && typeof permissionManager !== 'undefined') {
    permissionManager.checkAndApplyPermissions(existingLeadId, '#leadFormContainer').catch(err => {
      console.warn('Lead permission check failed:', err);
    });
  }
});

// Company name search function
let searchTimeout;
async function searchCompanyByName(companyName, resultsContainerId) {
  const container = document.getElementById(resultsContainerId);
  if (!container) return;
  
  // Clear previous timeout
  if (searchTimeout) {
    clearTimeout(searchTimeout);
  }
  
  // Hide results if input is empty
  if (!companyName || companyName.trim().length < 2) {
    container.innerHTML = '';
    container.classList.remove('show');
    return;
  }
  
  // Debounce search
  searchTimeout = setTimeout(async () => {
    try {
      const apiBase = typeof window.getCRMApiBase === 'function' ? window.getCRMApiBase() : window.location.origin;
      const session = JSON.parse(localStorage.getItem('crm_session') || '{}');
      const token = session.access_token || session.token;
      
      const response = await fetch(`${apiBase}/leads?search=${encodeURIComponent(companyName.trim())}&limit=10`, {
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        }
      });
      
      if (response.ok) {
        const data = await response.json();
        displayCompanyResults(data.items || [], container);
      } else {
        console.error('Search failed:', response.status);
        container.classList.remove('show');
      }
    } catch (error) {
      console.error('Search error:', error);
      container.classList.remove('show');
    }
  }, 300);
}

function displayCompanyResults(leads, container) {
  if (!leads || leads.length === 0) {
    container.innerHTML = '<div style="padding:12px 14px; color:var(--text-muted); font-size:12px;">No matching companies found</div>';
    container.classList.add('show');
    return;
  }
  
  const html = leads.map(lead => {
    // Calculate lead age in days
    let leadAgeDays = 0;
    let actionButton = '';
    
    if (lead.created_at) {
      const createdDate = new Date(lead.created_at);
      const today = new Date();
      const diffTime = today - createdDate;
      leadAgeDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
    }
    
    // Show "Interested" if lead is less than 30 days old, otherwise show "Takeover Lead"
    if (leadAgeDays < 30) {
      actionButton = `<button class="interested-btn" onclick="showInterestedModal('${lead.id}', event)">Interested</button>`;
    } else {
      actionButton = `<button class="takeover-btn" onclick="takeoverLead('${lead.id}', event)">Takeover Lead</button>`;
    }
    
    return `
    <div class="company-result-item">
      <div class="company-result-header" onclick="selectCompany('${lead.company_name}', '${lead.contact_person_name || ''}', '${lead.mobile || ''}', '${lead.email || ''}', '${lead.city || ''}', '${lead.state || ''}', '${lead.designation || ''}', '${container.id}')">
        <div class="company-result-name">${lead.company_name || 'Unknown Company'}</div>
        <div class="company-result-details">
          <span class="company-result-detail-item">👤 ${lead.contact_person_name || 'N/A'}</span>
          <span class="company-result-detail-item">📞 ${lead.mobile || 'N/A'}</span>
          <span class="company-result-detail-item">📧 ${lead.email || 'N/A'}</span>
          <span class="company-result-detail-item">📍 ${lead.city || ''} ${lead.state || ''}</span>
        </div>
      </div>
      <div class="company-result-actions">
        ${actionButton}
      </div>
    </div>
  `;
  }).join('');
  
  container.innerHTML = html;
  container.classList.add('show');
}

function takeoverLead(leadId, event) {
  // Stop event propagation to prevent triggering selectCompany
  if (event) {
    event.stopPropagation();
  }
  
  // Hide results container
  document.querySelectorAll('.company-results-container').forEach(container => {
    container.classList.remove('show');
  });
  
  // Navigate to the lead view/edit page
  // Assuming the lead management section has a way to view/edit leads
  // We'll navigate to the lead management section with the lead ID
  const leadManagementSection = document.querySelector('[data-sec="lead-management"]');
  if (leadManagementSection) {
    // Store the lead ID to be used when the section loads
    window.selectedLeadId = leadId;
    nav(leadManagementSection);
    
    // After navigation, trigger the lead selection
    setTimeout(() => {
      if (typeof selectLeadById === 'function') {
        selectLeadById(leadId);
      } else {
        // Fallback: set URL parameter and reload or trigger lead load
        const url = new URL(window.location);
        url.searchParams.set('leadId', leadId);
        window.history.pushState({}, '', url);
        window.location.reload();
      }
    }, 100);
  } else {
    // If lead management section not found, try to navigate via URL
    const url = new URL(window.location);
    url.searchParams.set('leadId', leadId);
    url.searchParams.set('section', 'lead-management');
    window.location.href = url.toString();
  }
}

function selectCompany(companyName, contactPerson, mobile, email, city, state, designation, containerId) {
  // Populate form fields based on which container triggered the selection
  if (containerId === 'ldCompanyResults') {
    document.getElementById('ldCompany').value = companyName;
    if (contactPerson) document.getElementById('ldContact').value = contactPerson;
    if (mobile) document.getElementById('ldPhone').value = mobile;
    if (email) document.getElementById('ldEmail').value = email;
    if (city || state) document.getElementById('ldLocation').value = `${city || ''}${city && state ? ', ' : ''}${state || ''}`;
    if (designation) document.getElementById('ldDesignation').value = designation;
  } else if (containerId === 'incCompanyResults') {
    document.getElementById('incCompany').value = companyName;
    if (contactPerson) document.getElementById('incContact').value = contactPerson;
    if (mobile) document.getElementById('incPhone').value = mobile;
    if (email) document.getElementById('incEmail').value = email;
    if (designation) document.getElementById('incDesignation').value = designation;
    if (city || state) document.getElementById('incLocation').value = `${city || ''}${city && state ? ', ' : ''}${state || ''}`;
  } else if (containerId === 'outCompanyResults') {
    document.getElementById('outCompany').value = companyName;
    if (contactPerson) document.getElementById('outContact').value = contactPerson;
    if (mobile) document.getElementById('outPhone').value = mobile;
    if (email) document.getElementById('outEmail').value = email;
    if (designation) document.getElementById('outDesignation').value = designation;
    if (city || state) document.getElementById('outLocation').value = `${city || ''}${city && state ? ', ' : ''}${state || ''}`;
  }
  
  // Hide results container
  const container = document.getElementById(containerId);
  if (container) {
    container.classList.remove('show');
  }
}

// Close results when clicking outside
document.addEventListener('click', function(e) {
  if (!e.target.closest('.company-results-container') && !e.target.closest('input[oninput*="searchCompanyByName"]')) {
    document.querySelectorAll('.company-results-container').forEach(container => {
      container.classList.remove('show');
    });
  }
});

// Takeover request modal
let currentTakeoverLeadId = null;

function takeoverLead(leadId, event) {
  // Stop event propagation to prevent triggering selectCompany
  if (event) {
    event.stopPropagation();
  }
  
  // Hide results container
  document.querySelectorAll('.company-results-container').forEach(container => {
    container.classList.remove('show');
  });
  
  // Store lead ID and show modal
  currentTakeoverLeadId = leadId;
  const modal = document.getElementById('takeoverModal');
  if (modal) {
    modal.classList.add('show');
    // Clear previous reason
    const reasonSelect = document.getElementById('takeoverReason');
    if (reasonSelect) {
      reasonSelect.value = '';
      // Since this is an existing lead (from search results), show the "Lead already exists" option
      // The option is already in the dropdown, so no additional action needed
    }
  }
}

function closeTakeoverModal() {
  const modal = document.getElementById('takeoverModal');
  if (modal) {
    modal.classList.remove('show');
  }
  currentTakeoverLeadId = null;
}

async function submitTakeoverRequest() {
  if (!currentTakeoverLeadId) {
    alert('Lead ID not found. Please try again.');
    return;
  }
  
  const reasonSelect = document.getElementById('takeoverReason');
  const reason = reasonSelect ? reasonSelect.value.trim() : '';
  
  if (!reason) {
    alert('Please provide a reason for the takeover request.');
    return;
  }
  
  const submitBtn = document.getElementById('takeoverSubmitBtn');
  if (submitBtn) {
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';
  }
  
  try {
    const apiBase = typeof window.getCRMApiBase === 'function' ? window.getCRMApiBase() : window.location.origin;
    const session = JSON.parse(localStorage.getItem('crm_session') || '{}');
    const token = session.access_token || session.token;
    
    const response = await fetch(`${apiBase}/leads/${currentTakeoverLeadId}/takeover-request`, {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        reason: reason
      })
    });
    
    if (response.ok) {
      alert('Takeover request submitted successfully. Admin will review your request.');
      closeTakeoverModal();
    } else {
      const errorData = await response.json().catch(() => ({}));
      alert(errorData.detail || 'Failed to submit takeover request. Please try again.');
    }
  } catch (error) {
    console.error('Takeover request error:', error);
    alert('An error occurred while submitting the request. Please try again.');
  } finally {
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit Request';
    }
  }
}

// Interested request modal
let currentInterestedLeadId = null;

function showInterestedModal(leadId, event) {
  // Stop event propagation to prevent triggering selectCompany
  if (event) {
    event.stopPropagation();
  }
  
  // Hide results container
  document.querySelectorAll('.company-results-container').forEach(container => {
    container.classList.remove('show');
  });
  
  // Store lead ID and show modal
  currentInterestedLeadId = leadId;
  const modal = document.getElementById('interestedModal');
  if (modal) {
    modal.classList.add('show');
    // Clear previous reason
    const reasonTextarea = document.getElementById('interestedReason');
    if (reasonTextarea) {
      reasonTextarea.value = '';
    }
  }
}

function closeInterestedModal() {
  const modal = document.getElementById('interestedModal');
  if (modal) {
    modal.classList.remove('show');
  }
  currentInterestedLeadId = null;
}

async function submitInterestedRequest() {
  if (!currentInterestedLeadId) {
    alert('Lead ID not found. Please try again.');
    return;
  }
  
  const reasonTextarea = document.getElementById('interestedReason');
  const reason = reasonTextarea ? reasonTextarea.value.trim() : '';
  
  if (!reason) {
    alert('Please provide a reason for your interest.');
    return;
  }
  
  const submitBtn = document.getElementById('interestedSubmitBtn');
  if (submitBtn) {
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';
  }
  
  try {
    const apiBase = typeof window.getCRMApiBase === 'function' ? window.getCRMApiBase() : window.location.origin;
    const session = JSON.parse(localStorage.getItem('crm_session') || '{}');
    const token = session.access_token || session.token;
    
    const response = await fetch(`${apiBase}/leads/${currentInterestedLeadId}/interested-request`, {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        reason: reason
      })
    });
    
    if (response.ok) {
      alert('Interest request submitted successfully. Sir will review your request.');
      closeInterestedModal();
    } else {
      const errorData = await response.json().catch(() => ({}));
      alert(errorData.detail || 'Failed to submit interest request. Please try again.');
    }
  } catch (error) {
    console.error('Interested request error:', error);
    alert('An error occurred while submitting the request. Please try again.');
  } finally {
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit Request';
    }
  }
}
</script>

<!-- Takeover Request Modal -->
<div id="takeoverModal" class="takeover-modal">
  <div class="takeover-modal-content">
    <div class="takeover-modal-header">
      <h3>Request Lead Takeover</h3>
      <button class="takeover-modal-close" onclick="closeTakeoverModal()">×</button>
    </div>
    <div class="takeover-modal-body">
      <div class="takeover-field">
        <label>Select professional reason <span class="req">*</span></label>
        <select id="takeoverReason" class="takeover-select">
          <option value="">Select a reason</option>
          <option value="lead_already_exists">Lead already exists</option>
          <option value="better_relationship">Better relationship with customer</option>
          <option value="geographic_proximity">Geographic proximity to customer</option>
          <option value="industry_expertise">Industry expertise match</option>
          <option value="previous_experience">Previous experience with customer</option>
          <option value="referral">Customer referral</option>
          <option value="language_match">Language/cultural match</option>
          <option value="product_expertise">Product/service expertise</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div class="takeover-actions">
        <button class="takeover-btn-cancel" onclick="closeTakeoverModal()">Cancel</button>
        <button class="takeover-btn-submit" id="takeoverSubmitBtn" onclick="submitTakeoverRequest()">Submit Request</button>
      </div>
    </div>
  </div>
</div>

<!-- Interested Request Modal -->
<div id="interestedModal" class="interested-modal">
  <div class="interested-modal-content">
    <div class="interested-modal-header">
      <h3>Express Interest in Lead</h3>
      <button class="interested-modal-close" onclick="closeInterestedModal()">×</button>
    </div>
    <div class="interested-modal-body">
      <div class="interested-field">
        <label>Reason for Interest <span class="req">*</span></label>
        <textarea id="interestedReason" placeholder="Please explain why you are interested in this lead..."></textarea>
      </div>
      <div class="interested-actions">
        <button class="interested-btn-cancel" onclick="closeInterestedModal()">Cancel</button>
        <button class="interested-btn-submit" id="interestedSubmitBtn" onclick="submitInterestedRequest()">Submit Request</button>
      </div>
    </div>
  </div>
</div>

</body>
</html>